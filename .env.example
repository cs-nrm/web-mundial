# Copia este archivo a .env y rellena los valores reales.
# NUNCA commitear .env con valores.

# WordPress / sitio
PUBLIC_API_URL=https://fiestafutbol.com.mx/wp-json/wp/v2
PUBLIC_SITE_URL=http://localhost:4321

# Supabase (públicas — seguras para el cliente)
PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role — SECRETO, solo servidor. Ignora RLS por completo.
SUPABASE_SERVICE_ROLE_KEY=

# YouTube Data API — SECRETO
YOUTUBE_API_KEY=

# Acceso de emergencia de admin (mín. 32 caracteres) — SECRETO
EMERGENCY_ADMIN_SECRET=
