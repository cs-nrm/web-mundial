---
const res = await fetch("https://sabrositadigital.com.mx/wp-json/wp/v2/posts?_embed&per_page=10&categories=292&order=asc&_fields=id,title,acf,content,slug,categories,_links,_embedded");
let posts = await res.json();

// Asegura arreglo
posts = Array.isArray(posts) ? posts : [];

// Ordenar manualmente por acf.posicion (por si la API no lo hace)
posts = posts.sort((a, b) => (a?.acf?.posicion ?? 0) - (b?.acf?.posicion ?? 0));

// Placeholders y shortcuts seguros
const PLACEHOLDER_IMG = 'https://storage.googleapis.com/nrm-web/nrm/images/footer/sabrosita.png';
const hero = posts[0] ?? null;
const heroTitle  = hero?.title?.rendered ?? 'Título pendiente';
const heroArtist = hero?.acf?.artista ?? 'Artista pendiente';
const heroSlug   = hero?.slug ?? '';
const heroCover  = hero?._embedded?.['wp:featuredmedia']?.[0]?.media_details?.sizes?.full?.source_url ?? PLACEHOLDER_IMG;
const heroAlt    = hero?._embedded?.['wp:featuredmedia']?.[0]?.alt_text ?? 'Imagen Hot Parade';
---
{ posts.length === 0 && (<div class="text-white p-4 rounded bg-black/30">Pronto publicaremos el Hot Parade de esta semana.</div>) }
    <div class="flex flex-col md:flex-row gap-8 md:gap-16 items-center rounded-xl">
		<div class="news-content w-[100%] md:w-[50%]">
			<img loading="lazy" src="https://storage.googleapis.com/nrm-web/sabrosita/resources/img/HOTPARADE-min.jpg" alt="Imagen Hot Parade" class="rounded-xl object-cover" />
        </div>
        <div class="w-[100%] md:w-[50%] relative">
			<img loading="lazy" class="rounded-xl object-cover aspect-video" src={heroCover} alt={heroAlt} />
						
			<a class="absolute text-center text-white bottom-0 w-full" href={heroSlug ? `/hot-parade/${heroSlug}/` : '#'}>
				<div class="rojo cursor-pointer text-white" data-podcast-status="ready"> 
					<svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler bg-[#e2241a] hover:bg-black rounded-[50%] p-[15px] m-auto icon-tabler-player-play" width="100" height="100" viewBox="0 0 24 24" stroke-width="2" stroke="#fff" fill="#fff" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M7 4v16l13 -8z" /></svg>
					<span class="text-lg text-base lg:text-lg text-white roboto">Ver el Video</span>
				</div> 
				<div class="flex items-center justify-between px-8 spartan">
					<span class="text-7xl sm:text-9xl md:text-6xl lg:text-8xl xl:text-9xl font-bold rojo ">1</span>
					<div class="">
						<p class="text-3xl text-xl lg:text-3xl font-bold text-right m-0 uppercase" set:html={heroTitle}></p>
						<p class="text-lg text-right m-0" set:html={heroArtist}></p>
						<div class="flex justify-center mt-2">
							<div class="like-hotparade" title="Votar" data-song={heroTitle} data-artist={heroArtist} >
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" width="28" height="28" stroke-width="1">
									<path d="M19.5 12.572l-7.5 7.428l-7.5 -7.428a5 5 0 1 1 7.5 -6.566a5 5 0 1 1 7.5 6.572"></path>
								</svg>
							</div>
						</div>
					</div>
				</div>
			</a>
		</div>
    </div>

<!--div class="main-topten" data-flickity='{ "lazyLoad": 1, "wrapAround": true, "cellAlign": "center", "pageDots": false, "autoPlay": true}'-->
<div class="topten main-topten mt-8">
	{
  posts.map((post:any, index)=> (
    <div
      class="carousel-cell flex flex-col items-center text-white w-1/2 sm:w-1/3 lg:w-1/5 px-6 m-2"
      data-pos={index+1}
      data-artista={post.acf?.artista || ''}
      data-cancion={post.title?.rendered || ''}
    >
      <a class="w-full text-center" href={`/hot-parade/${post.slug}/`}>
        <img
          loading="lazy"
          class="block aspect-square h-auto w-full shadow-[0_2px_12px_7px_rgba(0,0,0,0.4)] rounded-xl object-cover"
          src={post?._embedded?.['wp:featuredmedia']?.[0]?.media_details?.sizes?.['thumbnail']?.source_url || PLACEHOLDER_IMG}
          width="300" height="150"
          alt={(post?._embedded?.['wp:featuredmedia']?.[0]?.alt_text) || 'Imagen Hot Parade'}
        />
      </a>

      <div class="w-full grid grid-cols-12 items-center gap-2 mt-2">
        <div class="col-span-2">
          <a href={`/hot-parade/${post.slug}/`}>
            <span class="text-4xl rojo font-bold spartan whitespace-nowrap">{index+1}</span>
          </a>
        </div>
        <div class="col-span-9 flex flex-col">
          <a href={`/hot-parade/${post.slug}/`}>
            <p class="leading-none m-0 text-s text-zinc-400 font-normal" set:html={post.title.rendered}></p>
			<p class="font-bold leading-none m-0 text-xs" set:html={post.acf.artista}></p>            
          </a>
        </div>
        <div class="col-span-1 flex justify-end">
          <div class="like-hotparade" title="Votar" data-song={post?.title?.rendered || ''} data-artist={post?.acf?.artista || ''}>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" width="28" height="28" stroke-width="1">
              <path d="M19.5 12.572l-7.5 7.428l-7.5 -7.428a5 5 0 1 1 7.5 -6.566a5 5 0 1 1 7.5 6.572"></path>
            </svg>
          </div>
        </div>
      </div>
    </div>
  ))
}
</div>




<style>
.carousel-cell {
  margin-right: 10px; /* Menos espacio entre tarjetas */
  border-radius: 20px;
}

.carousel-cell img{
  border-radius: 12px; /* cuadrado con esquinas redondeadas */
  box-shadow: 0 2px 12px 7px rgba(0,0,0,0.4);
  margin-top: 0;
}

.carousel-cell.is-selected {
  /*background: #ED2;*/
}

.news-content{
	position: relative ;
}
/*.news-content::after{
	content: '';
	width: calc(100% - 40px);
	height: 100%;
	background: #ededed;
	background: linear-gradient(0deg,rgba(237, 237, 237, 1) 0%, rgba(237, 237, 237, 0) 100%);
	display: inline-block;
	position: absolute;
	top: 0;
	border-radius: 0.75rem;
}*/
.getcancion, .letra-de-cancion {
  line-height: 1.6;
 	display: -webkit-box;
  -webkit-line-clamp: 9;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

@media (max-width: 1280px){
	.getcancion, .letra-de-cancion {
		-webkit-line-clamp: 7;
	}
}
@media (max-width: 450px){
	svg{
		width:75px !important;
		height:75px !important;
	}
}

@media (max-width: 1024px){
	/*svg{
		width:80px;
		height:80px;
	}*/
	.news-content .letra p{
		font-size: 12px;
		line-height: 1;
	}
	.getcancion, .letra-de-cancion {
		-webkit-line-clamp: 6;
	}
}


</style>