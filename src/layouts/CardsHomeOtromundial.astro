---
import { getArticles } from "../lib/api.js";
import { wpSiteOyeNoticias } from "../config/sites.js";

const posts = await getArticles(undefined, { sites: [wpSiteOyeNoticias] });

if (!posts || posts.length < 4) {
    console.warn(`CardsHomeOtromundial: se esperaban 4 posts, hay ${posts?.length || 0}`);
}

const PLACEHOLDER_IMG = 'https://storage.googleapis.com/nrm-web/mundial/balon1.jpg';

const featuredImages = posts.map(p =>
    p._embedded?.['wp:featuredmedia']?.[0]?.media_details?.sizes?.medium_large?.source_url ||
    p._embedded?.['wp:featuredmedia']?.[0]?.source_url ||
    PLACEHOLDER_IMG
);
---

<div class="container m-auto">
  <h1 class="titulos rojo uppercase goodtime text-center p-4 my-4 text-2xl lg:text-3xl font-bold">El Otro Mundial</h1>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    {posts.slice(0, 4).map((post, i) => (
      <div class="relative">
        <a href={`/otro-mundial/${post.slug}/`}>
          <img loading="lazy" class="rounded-xl aspect-3/2 w-full h-full object-cover" src={featuredImages[i]} alt={post._embedded?.['wp:featuredmedia']?.[0]?.alt_text || 'Imagen'} />
          <div class="absolute bottom-0 left-0 bg-black bg-opacity-60 text-white p-3 w-full rounded-b-xl">
            <h2 class="text-lg lg:text-xl !leading-6 pb-1" set:html={post.title.rendered} />
            {post._logo && (
              <div class="flex items-center gap-1 p-1 w-fit creado-por">
                <span class="text-[10px]">Creado por:</span>
                <img class={`logo-${post._estacion}`} src={post._logo} alt={post._estacion} />
              </div>
            )}
          </div>
        </a>
      </div>
    ))}
  </div>
</div>

<div class="m-auto text-center">
  <a href="/otro-mundial" class="text-white hover:text-black">
    <button class="ver-mas group relative h-8 m-2 overflow-hidden bg-[#e2241a] uppercase text-xs font-bold tracking-[1px] rounded-xl">
      <span class="p-4">MÁS NOTICIAS AQUÍ</span>
    </button>
  </a>
</div>

<style>
@media (min-width: 769px) and (max-width: 1024px) {
  .cards-filtro-3 { display: block; }
}

</style>
