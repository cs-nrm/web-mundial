---
import { categoryMapping, wpSites } from "../config/sites.js";
import { getArticles } from "../lib/api.js";

console.log('CardsHomeOtromundial: Starting, sites:', wpSites);

const posts = await getArticles(undefined, { sites: wpSites });
console.log('CardsHomeOtromundial: posts fetched:', posts.length);
console.log('All posts data:', posts);
const { imageBase = 'https://storage.googleapis.com/nrm-web/mundial/balon', listIndex } = Astro.props;

let url_seccion = "fiesta-futbolera"; // Default fallback

// Verify we have posts before trying to access them
if (!posts || posts.length < 4) {
    console.warn(`CardsHomeNews: Esperaba 4 posts, pero solo hay ${posts?.length || 0}`);
}

// Try to find the category slug from embedded terms to determine the section color/link
if (
    posts[0] &&
    posts[0]._embedded &&
    posts[0]._embedded["wp:term"] &&
    posts[0]._embedded["wp:term"][0]
) {
    const categories = posts[0]._embedded["wp:term"][0];
    for (const cat of categories) {
        if (categoryMapping[cat.slug]) {
            url_seccion = categoryMapping[cat.slug];
            break;
        }
    }
}

const PLACEHOLDER_IMG =
    "https://storage.googleapis.com/nrm-web/sabrosita/resources/img/img_sabrosita.jpg";

// Create an array of featured images for each post
const featuredImages = posts.map(p => 
    p._embedded?.["wp:featuredmedia"]?.[0]?.media_details?.sizes
        ?.medium_large?.source_url ||
    p._embedded?.["wp:featuredmedia"]?.[0]?.source_url ||
    PLACEHOLDER_IMG
);

// Función para obtener la imagen del autor
function getAuthorImage(author) {
    switch (author) {
        case "Redacción":
            return "https://storage.googleapis.com/nrm-web/mundial/logo-enfoque.png";
        case "4":
            return "https://storage.googleapis.com/nrm-web/mundial/logo-stereo.png";
        case "17":
            return "https://storage.googleapis.com/nrm-web/mundial/logo-beat.png";
        case "92":
            return "https://storage.googleapis.com/nrm-web/mundial/logo-oye.png";
        case "9":
            return "https://storage.googleapis.com/nrm-web/mundial/logo-sabrosita.png";
        // Agrega más casos según los autores que tengas
        default:
            return "https://storage.googleapis.com/nrm-web/mundial/logo-enfoque.png";
    }
}

// Create an array of author images for each post
const authorImages = posts.map(p => getAuthorImage(
    p.author ||
    p._embedded?.author?.[0]?.name ||
    p.yoast_head_json?.author ||
    "Redacción"
));

// Debug: Log author data for each post
console.log('Author data in CardsHomeOtromundial:', posts.map(p => ({
    author: p.author,
    embeddedAuthor: p._embedded?.author?.[0]?.name,
    yoastAuthor: p.yoast_head_json?.author,
    finalAuthor: p.author || p._embedded?.author?.[0]?.name || p.yoast_head_json?.author || "Redacción"
})));

// Debug: Log author data for each post
console.log('Author data in CardsHomeOtromundial:', posts.map(p => ({
    author: p.author,
    embeddedAuthor: p._embedded?.author?.[0]?.name,
    yoastAuthor: p.yoast_head_json?.author,
    finalAuthor: p.author || p._embedded?.author?.[0]?.name || p.yoast_head_json?.author || "Redacción"
})));

    // Compute a sequential image index from 1..10 for the `.image` element.
// If `post.id` exists we map it deterministically: post.id=1 -> 1.jpg, id=11 -> 1.jpg, etc.
// Fallback to 1.jpg when no post.id is available.
    // Selección de imagen en orden 1..10 según el índice de la lista (listIndex)
    const SEQ_COUNT = 10;
    let seqIndex = 1;

var sequentialImage = ``;
    if (typeof listIndex === 'number' && listIndex >= 0) {
        seqIndex = (listIndex % SEQ_COUNT) + 1;
        sequentialImage = `${imageBase}${seqIndex}.jpg`;
    }
sequentialImage = `${imageBase}${seqIndex}.jpg`;

console.log(posts);
