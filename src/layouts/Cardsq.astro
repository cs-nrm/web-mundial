---
export interface Props {
    post: {
        imagePath: string;
        title: {
            rendered: string;
        };
        content: string;
        excerpt: {
            rendered: string;
        };
        slug: string;
        categories: {};
        yoast_head_json: {
            og_image: [
                {
                    url: string;
                },
            ];
            article_published_time: string;
            author: string;
        };
        _embedded: {
            "wp:featuredmedia": [
                {
                    alt_text: string;
                    media_details: {
                        sizes: {
                            medium_large: {
                                source_url: string;
                            };
                        };
                    };
                },
            ];
        };
    };
}

import { categoryMapping } from "../config/sites.js";

const { post } = Astro.props;

var url_seccion = "fiesta-futbolera"; // Default

// Try to find the category slug from embedded terms
if (
    post._embedded &&
    post._embedded["wp:term"] &&
    post._embedded["wp:term"][0]
) {
    const categories = post._embedded["wp:term"][0];
    // Find the first category that has a mapping or use the first one available
    for (const cat of categories) {
        if (categoryMapping[cat.slug]) {
            url_seccion = categoryMapping[cat.slug];
            break;
        }
    }
}
const PLACEHOLDER_IMG =
    "https://storage.googleapis.com/nrm-web/sabrosita/resources/img/img_sabrosita.jpg";

/*const section = post.yoast_head_json.schema['@graph'][0].articleSection; 
console.log(section);*/
---

<article class="news-card transition duration-[0.2s] hover:translate-y-[-4px]">
    <a href={`/${url_seccion}/${post.slug}/`}>
        <div>
            <img
                loading="lazy"
                class="rounded-xl"
                src={post?._embedded?.["wp:featuredmedia"]?.[0]?.media_details
                    ?.sizes?.["medium_large"]?.source_url || PLACEHOLDER_IMG}
                alt={post._embedded["wp:featuredmedia"][0].alt_text ||
                    "Imagen Noticias"}
            />
        </div>
        <div class="news-content p-6">
            <h5 set:html={post.title.rendered} />
            <div class="text-sm resumen" set:html={post.excerpt.rendered} />
            <span class="roboto font-bold text-xs mt-4"
                >por {post.yoast_head_json.author}</span
            >
        </div>
    </a>
</article>

<style>
    .carduno img {
        box-shadow: none;
        width: 100%;
        height: 100%;
        mask-image: linear-gradient(
            225deg,
            hsla(var(--color-black), 1) 0,
            hsla(var(--color-black), 0.9) 40%,
            hsla(var(--color-black), 0) 80%
        );
    }

    .carduno h2,
    .carddos h2 {
        display: -webkit-box;
        -webkit-margin-before: 0;
        margin-block-start: 0;
        -webkit-margin-after: 12px;
        margin-block-end: 12px;
        line-height: 1.2;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
