---
import { getArticles } from "../lib/api.js";
import { wpSites } from "../config/sites.js";

const posts = await getArticles(undefined, { sites: wpSites });

if (!posts || posts.length < 4) {
    console.warn(`CardsHomeOtromundial: se esperaban 4 posts, hay ${posts?.length || 0}`);
}

const PLACEHOLDER_IMG = 'https://storage.googleapis.com/nrm-web/mundial/balon1.jpg';

const featuredImages = posts.map(p =>
    p._embedded?.['wp:featuredmedia']?.[0]?.media_details?.sizes?.medium_large?.source_url ||
    p._embedded?.['wp:featuredmedia']?.[0]?.source_url ||
    PLACEHOLDER_IMG
);

const getCategoria = (p: any) => p._embedded?.['wp:term']?.[1]?.[0]?.name ?? p._embedded?.['wp:term']?.[0]?.[0]?.name ?? ''
---

    <div class="container m-auto">
      <h1 class="titulos rojo uppercase goodtime text-center p-4 my-4 text-2xl lg:text-3xl font-bold ">Un Mundial más Fácil</h1>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="relative">
            <a href={`/acerca-de/${posts[0].slug}/`}>
              <img loading="lazy" class="aspect-video rounded-xl w-full h-full object-cover" src={featuredImages[0]} alt={posts[0]?._embedded?.['wp:featuredmedia']?.[0]?.alt_text || "Imagen Noticias"}/>
              <div class="absolute top-1 right-1 bg-black bg-opacity-60 text-white p-1 w-fit text-[10px] rounded-[4px]">
