                  <div class="absolute bottom-0 left-0 bg-black bg-opacity-60 text-white p-3 w-full rounded-b-xl">
                    <h2 class="text-base font-medium" set:html={filteredPosts[1]?.title?.rendered}></h2>
                    {filteredPosts[1]?._logo && (
                      <div class="flex items-center gap-1 creado-por p-1 w-fit">
                        <span class="text-[10px]">Creado por:</span>
                        <img class="w-[45px] h-auto" src={filteredPosts[1]._logo} alt={filteredPosts[1]._estacion} />
                      </div>
                    )}
                  </div>
                </a>
                )}
              </div>
              <!-- Secundaria 2 -->
              <div class="relative" data-anim="fade-up">
                {filteredPosts?.[2] && (
                <a href={`/noticias/${filteredPosts[2]?.slug}/`}>
                  <img loading="lazy" class="aspect-video rounded-xl w-full h-full object-cover" src={featuredImages[2]} alt={filteredPosts[2]?._embedded?.['wp:featuredmedia']?.[0]?.alt_text || "Imagen Noticias"}/>
                  <div class="absolute bottom-0 left-0 bg-black bg-opacity-60 text-white p-3 w-full rounded-b-xl">
                    <h2 class="text-base font-medium" set:html={filteredPosts[2]?.title?.rendered}></h2>
                    {filteredPosts[2]?._logo && (
                      <div class="flex items-center gap-1 creado-por p-1 w-fit">
                        <span class="text-[10px]">Creado por:</span>
                        <img class="w-[45px] h-auto" src={filteredPosts[2]._logo} alt={filteredPosts[2]._estacion} />
                      </div>
                    )}
                  </div>
                </a>
                )}
              </div>
            </div>
            <div class="lg:col-span-2 h-1/2" data-anim="fade-up">
              {filteredPosts?.[3] && (
              <a href={`/noticias/${filteredPosts[3]?.slug}/`}>
              <div class="relative h-full">
                <img loading="lazy" class="aspect-video rounded-xl w-full h-full object-cover" src={featuredImages[3]} alt={filteredPosts[3]?._embedded?.['wp:featuredmedia']?.[0]?.alt_text || "Imagen Noticias"}/>
                <div class="absolute bottom-0 left-0 bg-black bg-opacity-60 text-white p-4 w-full rounded-b-xl">
                  <h2 class="text-base font-medium" set:html={filteredPosts[3]?.title?.rendered}></h2>
                  {filteredPosts[3]?._logo && (
                    <div class="flex items-center gap-1 creado-por p-1 w-fit">
                      <span class="text-[10px]">Creado por:</span>
                      <img class="w-[45px] h-auto" src={filteredPosts[3]._logo} alt={filteredPosts[3]._estacion} />
                    </div>
                  )}
                </div>
              </div>
              </a>
              )}
            </div>
          </div>
        </div>
    </div>

<div class="m-auto text-center">
    <a href="/acerca-de" class="text-[var(--verde)] hover:text-[var(--text-hover)]">
        <button class="ver-mas group relative rounded-sm h-8 m-2 overflow-hidden bg-black uppercase text-xs font-bold tracking-[1px] rounded-xl">
            <span class="p-4">MÁS NOTICIAS AQUÍ</span>
        </button>
    </a>
</div>

