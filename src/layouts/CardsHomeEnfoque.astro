---
import { getArticles } from "../lib/api.js";
import { wpSiteAcercaNoticias } from "../config/sites.js";

const posts = await getArticles(undefined, { sites: [wpSiteAcercaNoticias] });

// Filtrar solo posts con el tag 29666
const filteredPosts = (posts || []).filter((post) =>
  Array.isArray(post?.tags)
    ? post.tags.includes(29666)
    : post?.tags == 29666
);

if (!filteredPosts || filteredPosts.length === 0) {
    console.warn(`CardsHomeEnfoque: no hay posts con el tag 29666`);
}

const PLACEHOLDER_IMG = 'https://storage.googleapis.com/nrm-web/mundial/balon1.jpg';

const featuredImages = (filteredPosts || []).map(p =>
    p._embedded?.['wp:featuredmedia']?.[0]?.media_details?.sizes?.medium_large?.source_url ||
    p._embedded?.['wp:featuredmedia']?.[0]?.source_url ||
    PLACEHOLDER_IMG
);
---

    <div class="container m-auto">
      <h1 class="titulos rojo uppercase goodtime text-center p-4 my-4 text-2xl lg:text-3xl font-bold" data-anim="hero-title">Acerca de</h1>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="lg:col-span-2" data-anim="fade-up">
            {filteredPosts?.[0] && (
            <a href={`/acerca-de/${filteredPosts[0]?.slug}/`}>
            <div class="relative h-full">
              <img loading="lazy" class="aspect-video rounded-xl w-full h-full object-cover" src={featuredImages[0]} alt={filteredPosts[0]?._embedded?.['wp:featuredmedia']?.[0]?.alt_text || "Imagen Noticias"}/>
              <div class="absolute bottom-0 left-0 bg-black bg-opacity-60 text-white p-4 w-full rounded-b-xl">
                <h2 class="text-base font-medium" set:html={filteredPosts[0]?.title?.rendered}></h2>
                {filteredPosts[0]?._logo && (
                  <div class="flex items-center gap-1 creado-por p-1 w-fit">
                    <span class="text-[10px]">Creado por:</span>
                    <img class="w-[45px] h-auto" src={filteredPosts[0]._logo} alt={filteredPosts[0]._estacion} />
                  </div>
                )}
              </div>
            </div>
            </a>
            )}
          </div>
          <div class="flex flex-col gap-4 lg:col-span-2" data-anim="fade-up">
            <div class="flex flex-col lg:flex-row gap-4 lg:h-1/2">
              <div class="relative" data-anim="fade-up">
                {filteredPosts?.[1] && (
                <a href={`/acerca-de/${filteredPosts[1]?.slug}/`}>
