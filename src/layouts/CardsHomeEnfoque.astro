---
import { getArticles } from "../lib/api.js";
import { wpSiteEnfoqueNoticias } from "../config/sites.js";

const posts = await getArticles(undefined, { sites: wpSiteEnfoqueNoticias });

if (!posts || posts.length < 4) {
    console.warn(`CardsHomeOtromundial: se esperaban 4 posts, hay ${posts?.length || 0}`);
}

const PLACEHOLDER_IMG = 'https://storage.googleapis.com/nrm-web/mundial/balon1.jpg';

const featuredImages = posts.map(p =>
    p._embedded?.['wp:featuredmedia']?.[0]?.media_details?.sizes?.medium_large?.source_url ||
    p._embedded?.['wp:featuredmedia']?.[0]?.source_url ||
    PLACEHOLDER_IMG
);
---

    <div class="container m-auto">
      <h1 class="titulos rojo uppercase goodtime text-center p-4 my-4 text-2xl lg:text-3xl font-bold ">Acerca de</h1>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="lg:col-span-2">
            <a href={`/acerca-de/${posts[0].slug}/`}>
            <div class="relative h-full">
              <img loading="lazy" class="rounded-xl w-full h-full object-cover" src={featuredImages[0]} alt={posts[0]?._embedded?.['wp:featuredmedia']?.[0]?.alt_text || "Imagen Noticias"}/>
              <div class="absolute bottom-0 left-0 bg-black bg-opacity-60 text-white p-4 w-full rounded-b-xl">
                <h2 class="text-base font-medium" set:html={posts[0].title.rendered}></h2>
                {posts[0]._logo && (
                  <div class="flex items-center gap-1 creado-por p-1 w-fit">
                    <span class="text-[10px]">Creado por:</span>
                    <img class="w-[45px] h-auto" src={posts[0]._logo} alt={posts[0]._estacion} />
                  </div>
                )}
              </div>
            </div>
            </a>
          </div>
          <div class="flex flex-col gap-4 lg:col-span-2">
            <div class="flex flex-col lg:flex-row gap-4 lg:h-1/2">
              <div class="relative">
                <a href={`/acerca-de/${posts[1].slug}/`}>
                  <img loading="lazy" class="rounded-xl w-full h-full object-cover" src={featuredImages[1]} alt={posts[1]?._embedded?.['wp:featuredmedia']?.[0]?.alt_text || "Imagen Noticias"}/>
                  <div class="absolute bottom-0 left-0 bg-black bg-opacity-60 text-white p-3 w-full rounded-b-xl">
                    <h2 class="text-base font-medium" set:html={posts[1].title.rendered}></h2>
                    {posts[1]._logo && (
                      <div class="flex items-center gap-1 creado-por p-1 w-fit">
                        <span class="text-[10px]">Creado por:</span>
                        <img class="w-[45px] h-auto" src={posts[1]._logo} alt={posts[1]._estacion} />
                      </div>
                    )}
                  </div>
                </a>
              </div>
              <!-- Secundaria 2 -->
              <div class="relative">
                <a href={`/acerca-de/${posts[2].slug}/`}>
                  <img loading="lazy" class="rounded-xl w-full h-full object-cover" src={featuredImages[2]} alt={posts[2]?._embedded?.['wp:featuredmedia']?.[0]?.alt_text || "Imagen Noticias"}/>
                  <div class="absolute bottom-0 left-0 bg-black bg-opacity-60 text-white p-3 w-full rounded-b-xl">
                    <h2 class="text-base font-medium" set:html={posts[2].title.rendered}></h2>
                    {posts[2]._logo && (
                      <div class="flex items-center gap-1 creado-por p-1 w-fit">
                        <span class="text-[10px]">Creado por:</span>
                        <img class="w-[45px] h-auto" src={posts[2]._logo} alt={posts[2]._estacion} />
                      </div>
                    )}
                  </div>
                </a>
              </div>
            </div>
            <div class="lg:col-span-2 h-1/2">
              <a href={`/acerca-de/${posts[3].slug}/`}>
              <div class="relative h-full">
                <img loading="lazy" class="rounded-xl w-full h-full object-cover" src={featuredImages[3]} alt={posts[3]?._embedded?.['wp:featuredmedia']?.[0]?.alt_text || "Imagen Noticias"}/>
                <div class="absolute bottom-0 left-0 bg-black bg-opacity-60 text-white p-4 w-full rounded-b-xl">
                  <h2 class="text-base font-medium" set:html={posts[3].title.rendered}></h2>
                  {posts[3]._logo && (
                    <div class="flex items-center gap-1 creado-por p-1 w-fit">
                      <span class="text-[10px]">Creado por:</span>
                      <img class="w-[45px] h-auto" src={posts[3]._logo} alt={posts[3]._estacion} />
                    </div>
                  )}
                </div>
              </div>
              </a>
            </div>
          </div>
        </div>
    </div>

<div class="m-auto text-center">
    <a href="/acerca-de" class="text-[var(--verde)] hover:text-[var(--text-hover)]">
        <button class="ver-mas group relative rounded-sm h-8 m-2 overflow-hidden bg-black uppercase text-xs font-bold tracking-[1px] rounded-xl">
            <span class="p-4">MÁS NOTICIAS AQUÍ</span>
        </button>
    </a>
</div>

<style>
.cards-filtro-3{display: none;}

@media (min-width: 769px) and (max-width: 1024px){
  .cards-filtro-3{display: block;}
}

.news-content p{
  font-size: 1rem;
  padding: 15px 0;
  line-height: 1;
  font-weight: bold;
}
