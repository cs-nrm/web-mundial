---
const PLACEHOLDER_IMG = 'https://storage.googleapis.com/nrm-web/sabrosita/resources/img/img_sabrosita.jpg';
const res = await fetch("https://sabrositadigital.com.mx/wp-json/wp/v2/posts?_fields=date,title,slug,sticky,yoast_head_json,content,excerpt,_links,_embedded&_embed&per_page=6&categories=791&order_by=date&order=desc");
const posts = await res.json();

// Filtrar los posts donde acf.fijo es false
const filteredPosts = posts.filter((post:any) => !post.acf?.fijo);
---

      <div class="container cards">
        <div class="news-grid grid gap-4 grid-cols-1 md:grid-cols-2 md:gap-16 xl:gap-16">
        {
          filteredPosts.slice(0, 2).map((post:any, idx:number) => (
              <div class={`cards-filtro-${idx}`}>
              <article class="news-card transition duration-[0.2s] hover:translate-y-[-4px]">
                <a href={`/entrevistas/${post.slug}/`}>
                  <div><img loading="lazy" class="rounded-xl aspect-not object-cover" src={post?._embedded?.['wp:featuredmedia']?.[0]?.media_details?.sizes?.['medium_large']?.source_url|| PLACEHOLDER_IMG} alt={post._embedded['wp:featuredmedia'][0].alt_text||"Imagen Entrevistas"} /></div>
                  <div class="news-content p-2">
                    <h6 set:html={post.title.rendered}></h6>
                  </div>
                </a>  
              </article>
              </div>
          ))
        }
        </div>
        <div class="m-auto text-center">
          <a href="/entrevistas">
            <button class="ver-mas group relative h-8 m-4 text-xl px-4 rounded-full spartan bold overflow-hidden bg-[#EA262A] border-4 border-[#EA262A] hover:border-[#FDCF27] font-bold">
              <span>Más entrevistas aquí</span>
            </button>
          </a>
        </div>   
      </div>


<style>
