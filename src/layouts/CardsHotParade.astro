---
export interface Props {
    post: {
      id: number;
      imagePath: string;
      title: {
         rendered: string;
      }
      acf:{
        artista: string;
        posicion: string;
      }
      content: {
        rendered: string;
      }
      slug: string;
      categories : {};
      yoast_head_json: {
         og_image: [
            {
               url: string;
            }
         ]
         article_published_time: string;
         author:string;         
      }
    };
    
}

const { post } = Astro.props;

var url_seccion;

---

<div class="card w-full px-2 md:px-4 pb-4 poptrend-video">
    <div class="overflow-hidden bg-white rounded-lg shadow-[0_2px_12px_6px_rgba(0,0,0,0.25)] hover:shadow-[0_2px_12px_6px_rgba(234,38,42,0.5)]">
        <div set:html={post.content.rendered} class="top-video block h-auto w-full aspect-video"></div>        
        <div class="flex items-center justify-between leading-tight p-2 md:p-4 min-h-40">
            <span class="text-4xl rojo font-bold spartan" set:html={post.acf.posicion}></span>
            <a href={`/hot-parade/${post.slug}/`} class="text-black hover:text-gray-500">
              <h2 class="text-base font-bold " set:html={post.title.rendered}></h2>
              <p set:html={post.acf.artista}></p>
            </a>
            <div class="voto-pop" data-voto-id={post.id}>
                <!--button class="relative inline-flex items-center justify-center p-0.5 mb-2 me-2 overflow-hidden text-sm font-medium text-white rounded-full group bg-[#EA262A] hover:text-white focus:ring-4 focus:outline-none focus:ring-black"-->
                    <!--span class="relative px-5 py-2.5 transition-all ease-in duration-75 bg-[#EA262A] rounded-full group-hover:bg-opacity-0">
                    ¡Vota! 
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-thumb-up" width="44" height="44" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                            <path d="M7 11v8a1 1 0 0 1 -1 1h-2a1 1 0 0 1 -1 -1v-7a1 1 0 0 1 1 -1h3a4 4 0 0 0 4 -4v-1a2 2 0 0 1 4 0v5h3a2 2 0 0 1 2 2l-1 5a2 3 0 0 1 -2 2h-7a3 3 0 0 1 -3 -3" />
                        </svg>
                    </span-->
                    <div class="like-hotparade cursor-pointer" title="Votar" data-song={post.title.rendered} data-artist={post.acf.artista} >
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="black" stroke-linecap="round" stroke-linejoin="round" width="40" height="40" stroke-width="1">
                        <path d="M19.5 12.572l-7.5 7.428l-7.5 -7.428a5 5 0 1 1 7.5 -6.566a5 5 0 1 1 7.5 6.572"></path>
                      </svg>
                    </div>
                <!--/button-->
            </div>
        </div>
    </div>
</div>

