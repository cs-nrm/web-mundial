---
const PLACEHOLDER_IMG = 'https://storage.googleapis.com/nrm-web/sabrosita/resources/img/img_sabrosita.jpg';
const res = await fetch("https://sabrositadigital.com.mx/wp-json/wp/v2/posts?_fields=date,title,slug,sticky,acf,yoast_head_json,content,excerpt,_links,_embedded&_embed&per_page=5&categories=1639");
const posts = await res.json();
const filteredPosts = posts.filter((post:any) => !post.acf?.fijo);

---
<div class="max-w-[700px] m-auto text-center">
  <img loading="lazy" class="max-w-[350px] m-auto text-center" src="https://storage.googleapis.com/nrm-web/sabrosita/titulo-tito.png" alt="Título Tito"/>
  <div class="primera-tito flex items-center">
    <article class="news-card">
      <a href={`/tito-nieves/${posts[0].slug}/`}>
        <div class="relative h-full">
          <img loading="lazy" class="rounded-xl aspect-not" src={posts[0]._embedded['wp:featuredmedia'][0].media_details.sizes['full'].source_url || PLACEHOLDER_IMG} alt={posts[0]._embedded['wp:featuredmedia'][0].alt_text || "Imagen Tito Nieves"} />
          <div class="news-content absolute bottom-0 left-0 bg-black bg-opacity-60 text-white p-2 w-full rounded-b-xl ">
            <h6 class="leading-none m-0" set:html={posts[0].title.rendered}></h6>
          </div>
        </div>
      </a>  
    </article>
    <img loading="lazy" class="max-w-[170px]" src="https://storage.googleapis.com/nrm-web/sabrosita/logo-tito.png" alt="Logo Tito"/>
  </div>
  <div class="container cards mt-8">
    <div class="film">
      <div class="news-grid py-4 grid grid-cols-3 md:grid-cols-4">
        {
          filteredPosts.slice(1, 5).map((post:any, idx:number) => (
            <div class={`cards-filtro-${idx}`}>
              <article class="news-card">
                <a href={`/tito-nieves/${post.slug}/`}>
                  <div class="relative h-full">
                    <img loading="lazy" class="aspect-not" src={post?._embedded?.['wp:featuredmedia']?.[0]?.media_details?.sizes?.['small-feature']?.source_url || PLACEHOLDER_IMG} alt={post._embedded['wp:featuredmedia'][0].alt_text || "Imagen Tito Nieves"} />
                    <div class="news-content absolute bottom-0 left-0 bg-black bg-opacity-60 p-[5px] text-white w-full">
                      <p class="leading-none text-xs mb-0" set:html={post.title.rendered}></p>
                      <!--div class="text-sm resumen" set:html={post.excerpt.rendered}></div>
                      <span class="roboto font-bold text-xs mt-4">por {post.yoast_head_json.author}</span-->
                    </div>
                  </div>
                </a>  
              </article>
            </div>
          ))
        }
        </div>

      </div>


      </div>
</div>

<div class="m-auto text-center">
    <a href="/tito-nieves">
        <button class="ver-mas group relative h-8 m-4 text-xl px-4 rounded-full spartan bold overflow-hidden bg-[#EA262A] border-4 border-[#EA262A] hover:border-[#FDCF27] font-bold">
            <span>Más noticias aquí</span>
        </button>
    </a>
</div>

<style>
  
