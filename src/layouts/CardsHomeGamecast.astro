---
import { createSupabaseAdminClient } from '../lib/supabase'
import { getFlagUrl } from '../lib/flags.js'

const supabase = createSupabaseAdminClient()

const now = new Date()
const cdmxNow = new Date(now.getTime() - 6 * 60 * 60_000)
const todayCdmx = cdmxNow.toISOString().slice(0, 10)
const manana = new Date(cdmxNow.getTime() + 24 * 60 * 60_000).toISOString().slice(0, 10)

const [{ data: matches = [] }, { data: previasRaw = [] }] = await Promise.all([
  supabase.from('df_partidos').select('*')
    .gte('fecha_utc', `${todayCdmx}T06:00:00Z`)
    .lt('fecha_utc',  `${manana}T06:00:00Z`)
    .order('fecha_utc', { ascending: true }),
  supabase.from('analisis').select('slug, partido_slug').not('partido_slug', 'is', null),
])

const previaMap = new Map((previasRaw ?? []).map(a => [a.partido_slug, a.slug]))
const n = (matches ?? []).length || 1
const cardPct = `${(100 / n).toFixed(4)}%`

function formatHora(fechaUtc: string) {
  return new Date(fechaUtc).toLocaleTimeString('es-MX', {
    timeZone: 'UTC',
    hour: '2-digit',
    minute: '2-digit',
    hour12: true,
  })
}
---

<div class="container m-auto px-4">
  <h1 class="titulos rojo uppercase goodtime text-center p-4 my-4 text-2xl lg:text-3xl font-bold" data-anim="hero-title">
    Partidos del día
  </h1>

  {(matches ?? []).length === 0 ? (
    <p class="text-center text-gray-400 py-8">No hay partidos programados para hoy.</p>
  ) : (
    <div id="home-partidos" style="display:flex;">
      {(matches ?? []).map(m => {
        const flag1 = getFlagUrl(m.equipo_local, 80)
        const flag2 = getFlagUrl(m.equipo_visitante, 80)
        const previaSlug = previaMap.get(m.slug)
        return (
          <a
            href={`/partidos-del-dia/${m.slug}/`}
            class="card-link"
            data-match-id={m.match_id}
            data-anim="fade-up"
            style={`width:${cardPct};padding:0 6px;flex-shrink:0;`}
          >
            <div class={`gamecast-card rounded-xl bg-black text-white p-4 h-full flex flex-col gap-3 justify-between hover:bg-neutral-900 transition-colors border ${m.status === 'en_vivo' ? 'border-red-900' : 'border-transparent'}`}>
              <div class="flex items-center justify-between gap-1">
                <p class="card-hora">{formatHora(m.fecha_utc)}</p>
                {m.status === 'en_vivo' && <span class="home-live-badge">EN VIVO</span>}
                {m.status === 'finalizado' && <span class="home-final-badge">Final</span>}
              </div>

              <div class="flex items-center justify-between gap-1">
                <div class="flex flex-col items-center gap-1 text-center" style="flex:1;min-width:0;">
                  {flag1
                    ? <img src={flag1} alt={m.equipo_local} class="w-12 h-auto rounded-sm shadow" />
                    : <span class="text-2xl">🏳️</span>
                  }
                  <span class="card-team">{m.equipo_local}</span>
                </div>

                <div style="flex-shrink:0;padding:0 4px;">
                  {m.status !== 'programado'
                    ? <span class="card-score" data-score>{m.score_local}-{m.score_visitante}</span>
                    : <span class="card-vs">VS</span>
                  }
                </div>

                <div class="flex flex-col items-center gap-1 text-center" style="flex:1;min-width:0;">
                  {flag2
                    ? <img src={flag2} alt={m.equipo_visitante} class="w-12 h-auto rounded-sm shadow" />
                    : <span class="text-2xl">🏳️</span>
                  }
                  <span class="card-team">{m.equipo_visitante}</span>
                </div>
              </div>

              {m.sede && (
                <p class="text-xs text-neutral-400 uppercase tracking-widest truncate">{m.sede}</p>
              )}

              <div style="display:flex;flex-direction:column;gap:0.3rem;">
                <span class="card-minuto">Minuto a Minuto →</span>
                {previaSlug && (
                  <a
                    href={`/resumen-de-analisis/${previaSlug}/`}
                    class="card-previa"
                    onclick="event.stopPropagation()"
                  >Previa →</a>
                )}
              </div>
            </div>
          </a>
        )
      })}
    </div>
  )}

  <div class="text-right mt-2">
    <a href="/partidos-del-dia/" class="text-xs text-gray-400 hover:text-red-500 transition-colors">
      Ver todos los partidos →
    </a>
  </div>
</div>

<script>
async function pollHomeScores() {
  try {
    const res = await fetch('/api/partidos')
    if (!res.ok) return
    const data: any[] = await res.json()
    const map = new Map(data.map((m: any) => [m.match_id, m]))
    document.querySelectorAll<HTMLElement>('[data-match-id]').forEach(card => {
      const m = map.get(card.dataset.matchId!)
      if (!m || m.status === 'programado') return
      const scoreEl = card.querySelector<HTMLElement>('[data-score]')
      if (scoreEl) scoreEl.textContent = `${m.score_local}-${m.score_visitante}`
    })
  } catch { /* silent */ }
}
if (document.getElementById('home-partidos')) setInterval(pollHomeScores, 30_000)
</script>

<style is:global>
@import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600&display=swap');

#home-partidos { scrollbar-width: none; }
#home-partidos::-webkit-scrollbar { display: none; }

@media (max-width: 700px) {
  #home-partidos { overflow-x: auto; }
  #home-partidos > .card-link { width: 200px !important; }
}

.card-hora {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 0.8rem;
  font-weight: 400;
  color: rgba(255,255,255,0.5);
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
.card-team {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 0.85rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.02em;
  color: white;
  line-height: 1.2;
  overflow-wrap: break-word;
  word-break: break-word;
}
.card-score {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 1.6rem;
  font-weight: 400;
  color: white;
  white-space: nowrap;
  line-height: 1;
}
.card-vs {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 1.2rem;
  font-weight: 400;
  color: rgba(255,255,255,0.3);
  white-space: nowrap;
}
.card-minuto {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 0.75rem;
  font-weight: 400;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: white;
}
.card-previa {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 0.75rem;
  font-weight: 400;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: #4ade80;
  text-decoration: none;
}
.card-previa:hover { text-decoration: underline; }

.home-live-badge {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 0.65rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  color: #ea262a;
  text-transform: uppercase;
  display: flex;
  align-items: center;
  gap: 0.25rem;
  animation: pulse-home 2s infinite;
}
.home-live-badge::before {
  content: '';
  display: inline-block;
  width: 4px; height: 4px;
  border-radius: 50%;
  background: #ea262a;
}
@keyframes pulse-home {
  0%, 100% { opacity: 1; }
  50%       { opacity: 0.45; }
}
.home-final-badge {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 0.65rem;
  font-weight: 400;
  color: rgba(255,255,255,0.35);
  text-transform: uppercase;
}
</style>
