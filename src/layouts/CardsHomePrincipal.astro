.hero {
  position: relative;
  /*height: 600px;*/
  color: white;
}

.hero img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.gradient-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.7), transparent);
}

.hero-content {
  position: absolute;
  bottom: 5%;
  left: 0;
  right: 0;
  /*transform: translateY(-50%);*/
  padding: 3rem;
  max-width: 65%;
  text-align: center;
}
.hero-content .author {color: white;}

.hero .category {
  font-size: 1rem;
  font-weight: 500;
  margin-bottom: 1rem;
  font-family: 'Lovelo'
}

.hero h1 {
  font-size: 2.8rem;
  font-weight: bold;
  margin-bottom: 1rem;
  line-height: 1.2;
 	display: -webkit-box;
  -webkit-line-clamp: 5;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.principal .text {
  margin-bottom: 1rem;
  line-height: 1.3;
	display: -webkit-box;
	-webkit-margin-before: 0;
  margin-block-start: 0;
  -webkit-margin-after: 12px;
  margin-block-end: 12px;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}



@media (max-width: 1023px) {
  .hero-content{max-width: 100%;}
  .hero h1 {font-size: 1.2rem;}
  .hero-content .text{display: none;}
  .hero .author {display: none;}
}

@media (max-width: 640px) {
  .hero img {height: 500px;}
}
</style>

