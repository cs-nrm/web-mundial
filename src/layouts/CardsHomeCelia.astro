---
const PLACEHOLDER_IMG = 'https://storage.googleapis.com/nrm-web/sabrosita/resources/img/img_sabrosita.jpg';
const res = await fetch("https://sabrositadigital.com.mx/wp-json/wp/v2/posts?_fields=date,title,slug,sticky,acf,yoast_head_json,content,excerpt,_links,_embedded&_embed&per_page=5&categories=1648");
const posts = await res.json();
const filteredPosts = posts.filter((post:any) => !post.acf?.fijo);

---
<video id="background-video" autoplay loop muted poster="https://assets.codepen.io/6093409/river.jpg">
  <source src="https://storage.googleapis.com/nrm-web/sabrosita/videos/confetti2-min.mp4" type="video/mp4">
</video>
<div class="back-patrio">
  <div class="container-home p-4 mx-auto">
    <div class="text-center relative z-10"> <img class="max-w-[200px] m-auto" src="https://storage.googleapis.com/nrm-web/sabrosita/titulos/celia-cruz.png" alt="Título Celia Cruz"/></div>   
    <div class="container cards mt-8 ">
      <div class="news-grid grid gap-4 grid-cols-1 md:grid-cols-2 lg:grid-cols-3 md:gap-16 xl:gap-16">
        {
          filteredPosts.slice(0, 4).map((post:any, idx:number) => (
            <div class={`cards-filtro-${idx}`}>
              <article class="news-card transition duration-[0.2s] hover:translate-y-[-4px]">
                <a href={`/celia-cruz/${post.slug}/`}>
                  <div><img loading="lazy" class="aspect-not rounded-xl" src={post?._embedded?.['wp:featuredmedia']?.[0]?.media_details?.sizes?.['small-feature']?.source_url || PLACEHOLDER_IMG} alt={post._embedded['wp:featuredmedia'][0].alt_text || "Imagen Mes Patrio"}/></div>
                  <div class="news-content p-6">
                    <h5 set:html={post.title.rendered}></h5>
                    <!--div class="text-sm resumen" set:html={post.excerpt.rendered}></div-->
                    <span class="roboto font-bold text-xs mt-4">por {post.yoast_head_json.author}</span>
                  </div>
                </a>  
              </article>
            </div>
          ))
        }
      </div>
    </div>
  </div>
  <div class="m-auto text-center mb-8">
      <a href="/celia-cruz/">
          <button class="ver-mas group relative h-8 m-4 text-xl px-4 rounded-full spartan bold overflow-hidden bg-[#EA262A] border-4 border-[#EA262A] hover:border-[#FDCF27] font-bold">
              <span>Más noticias aquí</span>
          </button>
      </a>
  </div>
</div>

<style>
#background-video {
   width: 100%;
   height: auto;
   object-fit: cover;
   position: absolute;
   left: 50%;
   right: 0;
   top: 0;
   bottom: 0;
   transform: translateX(-50%);
   /*z-index: -1;*/
}
.cards-filtro-3{display: none;}
@media (max-width: 1024px){
   #background-video {display: none;} 
   .back-patrio {
      background: url("https://storage.googleapis.com/nrm-web/sabrosita/resources/img/fondo-movil-celia.jpg") no-repeat;
      background-size: cover;
      background-position: top center;
   }
  .cards-filtro-3{display: block;}
  .news-content p{ font-size: 0.6rem;}
  h6{font-size: 0.9rem;}
}
@media (max-width: 768px){
  .cards-filtro-3{display: none;}
}


</style>

