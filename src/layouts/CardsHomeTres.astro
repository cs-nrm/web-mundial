---
import { getArticles } from "../lib/api.js";
import { wpSiteEnfoqueNoticias } from "../config/sites.js";

const posts = await getArticles(undefined, { sites: [wpSiteEnfoqueNoticias] });

if (!posts || posts.length < 4) {
    console.warn(`CardsHomeEnfoque: se esperaban 4 posts, hay ${posts?.length || 0}`);
}

const PLACEHOLDER_IMG = 'https://storage.googleapis.com/nrm-web/mundial/balon1.jpg';

const getFeaturedImage = (post: any) =>
    post._embedded?.['wp:featuredmedia']?.[0]?.media_details?.sizes?.medium_large?.source_url ||
    post._embedded?.['wp:featuredmedia']?.[0]?.source_url ||
    PLACEHOLDER_IMG;

const tagCards = [
  { tag: 29243, title: 'Historia de los Mundiales', slug: 'historia-de-los-mundiales' },
  { tag: 29468, title: 'Jóvenes Promesa', slug: 'jovenes-promesa' },
  { tag: 29667, title: 'Jugadores a Seguir', slug: 'jugadores-a-seguir' },
];

const getPostsByTag = (tag: number, limit: number = 3) => {
  const filteredPosts = posts.filter((post: any) =>
    Array.isArray(post?.tags)
      ? post.tags.includes(tag)
      : post?.tags == tag
  );
  return filteredPosts.slice(0, limit);
};
