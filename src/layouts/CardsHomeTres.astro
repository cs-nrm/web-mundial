<script is:inline>
(function() {
  const slide = document.getElementById('slide');

  function getItems() {
    return slide.querySelectorAll('.item');
  }

  var timer = setInterval(next, 5000);

  function resetTimer() {
    clearInterval(timer);
    timer = setInterval(next, 5000);
  }

  function next() {
    slide.appendChild(getItems()[0]);
  }

  function prev() {
    const items = getItems();
    slide.prepend(items[items.length - 1]);
  }

  document.getElementById('next').onclick = function() {
    next();
    resetTimer();
  };

  document.getElementById('prev').onclick = function() {
    prev();
    resetTimer();
  };

  // Clic en card: la trae al primer plano (posición activa)
  slide.addEventListener('click', function(e) {
    const item = e.target.closest('.item');
    if (!item) return;
    // Si el clic fue en el botón "Leer más", dejar navegar normalmente
    if (e.target.closest('a.button')) return;
    const items = getItems();
    // Ya es la card activa (posición 2), no hacer nada
    if (item === items[1]) return;
    items[0].after(item);
    resetTimer();
  });
})();
</script>

