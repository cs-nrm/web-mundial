.slider-tres{
   /* position: absolute;
    left:50%;
    top:50%;
    transform: translate(-50%,-50%);*/
    width:100%;
    height:auto;
    padding:50px;
    background-color: #141414;
    box-shadow: 0 30px 50px #dbdbdb;
    overflow: hidden;
}
.slider-tres #slide{
    width:max-content;
    /*margin-top:50px;*/
}
.slider-tres .item{
    width:200px;
    height:300px;
    background-position: 50% 50%;
    display: inline-block;
    transition: 0.5s;
    background-size: cover;
    background-position: top center;
    position: absolute;
    z-index: 1;
    top:25%;
    transform: translate(0,0%);
    border-radius: 20px;
    box-shadow:  0 30px 50px #505050;
}
.slider-tres .item:nth-child(1),
.slider-tres .item:nth-child(2){
    left:0;
    top:0;
    transform: translate(0,0);
    border-radius: 0;
    width:100%;
    height:100%;
    box-shadow: none;
}
.slider-tres .item:nth-child(3){
    left:50%;
}
.slider-tres .item:nth-child(4){
    left:calc(50% + 220px);
}
.slider-tres .item:nth-child(5){
    left:calc(50% + 440px);
}
.slider-tres .item:nth-child(n+6){
    left:calc(50% + 660px);
    opacity: 0;
}
.slider-tres .item .content{
    position: absolute;
    top:50%;
    left:50px;
    width:40%;
    text-align: left;
    padding:0;
    color:#eee;
    transform: translate(0,-50%);
    display: none;
    font-family: system-ui;
}
.slider-tres .item:nth-child(2) .content{
    display: block;
    z-index: 11111;
}
.slider-tres .item .name{
    font-size: 40px;
    font-weight: bold;
    opacity: 0;
    line-height: 1.2;
    animation:showcontent 1s ease-in-out 1 forwards
}
.slider-tres .item .des{
    margin:20px 0;
    opacity: 0;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    animation:showcontent 1s ease-in-out 0.3s 1 forwards
}
.slider-tres .item button{
    padding:10px 20px;
    border:none;
    opacity: 0;
    animation:showcontent 1s ease-in-out 0.6s 1 forwards
}

@keyframes showcontent{
    from{
        opacity: 0;
        transform: translate(0,100px);
        filter:blur(33px);
    }to{
        opacity: 1;
        transform: translate(0,0);
        filter:blur(0);
    }
}
.slider-tres .buttons{
    position: absolute;
    bottom:50px;
    z-index: 999;
    text-align: center;
    width:80%;
    left: 50%;
    transform: translate(-50%, -50%);
}
.slider-tres .buttons button{
    width:50px;
    height:50px;
    border-radius: 50%;
    border:1px solid #555;
    transition: 0.5s;
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(0,0,0,0.4);
}.slider-tres .buttons button:hover{
    background-color: #bac383;
    color: #000;
}

