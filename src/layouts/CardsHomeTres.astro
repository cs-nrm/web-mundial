.slider-tres div#slide {
    position: relative;
    height: 700px;
    width: 100%;
    display: inline-block;
}
.slider-tres .item:nth-child(5) {
    left: calc(80% + 40px);
}
.slider-tres .item:nth-child(4) {
    left: calc(65% + 20px);
}
.item:nth-child(3) {
    left: 50%;
}
.slider-tres .item {
    width: 15%;
}
.slider-tres .item button {
    color: #000;
}
.item:nth-child(2):before {
    content: "";
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(0 0 0 / 24%);
    top: 0;
    left: 0;
}
.slider-tres .item:nth-child(1) {
    z-index: 0;
}
.slider-tres .item:nth-child(2) {
    z-index: 1;
}
.slider-tres .item:nth-child(n+6) {
    z-index: -1;
}
.slider-tres .button{
    background-color: #fff;
    color: #000;
    padding: 5px 15px;
}


@media(max-width: 992px){
    .slider-tres{
      padding:10px;
    }
    .slider-tres div#slide {
        height: 575px;
    }

    .slider-tres .item .content {
        top: 25%;
    }

    .slider-tres .item {
        height: 178px;
    }

    .slider-tres .item {top: 52%;}
}
@media(max-width: 768px){
    .slider-tres .item:nth-child(3) {
        left: calc(50px);
    }

    .slider-tres .item:nth-child(4) {
        left: calc(25% + 40px);
    }

    .slider-tres .item {
        width: 20%;
    }

    .slider-tres .item:nth-child(5) {
        left: calc(50% + 30px);
    }
    .slider-tres .item .content{
      width: 100%;
    }
    .slider-tres .item .name{
      font-size: 20px;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .slider-tres .button{
      padding: 5px 5px;
      font-size: 12px;
    }
}
@media(max-width: 550px){
    .slider-tres .item:nth-child(n+6) {}

    .slider-tres .item:nth-child(5) {
        opacity: 0;
    }

    .slider-tres .item .content {
        left: 0;
        padding-left: 15px;
        padding-right: 15px;
        width: 100%;
        max-width: 300px;
    }

    .slider-tres .item:nth-child(3) {
        left: 15px;
    }

    .slider-tres .item {
        width: 31%;
    }

    .slider-tres .item:nth-child(4) {
        left: calc(31% + 40px);
    }
    .slider-tres .buttons {
        padding-left: 15px;
        text-align: left;
        padding-right: 15px;
    }
   /* div#slide {
