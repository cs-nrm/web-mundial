---
const mainUrl = 'https://enfoquenoticias.com.mx/feeds/main.json';

// 1. Leer main.json
let mainData = await fetch(mainUrl).then(res => res.json());

// 2. Filtrar solo los canales .preview de Liga MX
let previewFeeds = mainData.canales
  .filter(canal => canal.canal.startsWith('deportes.futbol.mexico.ficha.') && canal.canal.endsWith('.preview'))
  .map(canal => canal.json);

// 3. Cargar todos los previews (paralelo)
let partidos = await Promise.all(
  previewFeeds.map(async url => {
    try {
      let data = await fetch(url).then(res => res.json());
      // Estructura: { Match: {...} }
      return data.Match;
    } catch (e) {
      return null;
    }
  })
);
// Filtrar nulos (por si alguno falla)
partidos = partidos.filter(Boolean);

// Ordenar por fecha
partidos.sort((a, b) => a['@date'].localeCompare(b['@date']));

// Utilidad para formatear fecha y hora de Argentina a hora México
function fechaHoraMexico(fechaStr, horaStr) {
  // fechaStr: "20250809", horaStr: "00:15:00"
  if (!fechaStr || !horaStr) return {fecha: '', hora: ''};

  const yyyy = parseInt(fechaStr.slice(0,4));
  const mm = parseInt(fechaStr.slice(4,6)) - 1; // JS: 0=enero
  const dd = parseInt(fechaStr.slice(6,8));
  const [hh, min, ss] = horaStr.split(':').map(Number);

  // La hora que llega es local Argentina, así que la tratamos como UTC-3.
  // Creamos un objeto Date en UTC y restamos 3 horas
  let dt = new Date(Date.UTC(yyyy, mm, dd, hh, min, ss));
  dt.setUTCHours(dt.getUTCHours() - 3);

  // Formato dd/mm/yyyy y hh:mm
  const fecha = `${dt.getUTCDate().toString().padStart(2,'0')}/${(dt.getUTCMonth()+1).toString().padStart(2,'0')}/${dt.getUTCFullYear()}`;
  const hora = `${dt.getUTCHours().toString().padStart(2,'0')}:${dt.getUTCMinutes().toString().padStart(2,'0')}`;

  return {fecha, hora};
}

// URL de escudo
const getEscudoUrl = id =>
  `https://storage.googleapis.com/nrm-web/nrm/images/datafactory/escudos/mx/escudos/${id}.gif`;
---


    <div class="flex flex-col items-center justify-center ">
      
      <div class="df" style="width: 100%; max-width: 100%;">
        {partidos.length === 0 ? (
          <div class="bg-white text-center text-lg text-[#41154d] p-10 rounded-lg">
            No hay partidos programados para la próxima jornada.
          </div>
        ) : (
          partidos.map(partido => {
            const fechaHora = fechaHoraMexico(partido['@date'], partido['@scheduledStart']);
            return (
              <div class="bg-[#fcd586] rounded-2xl shadow-lg px-0 py-0 m-3 w-[300px] flex flex-col items-center" style="min-width: 270px; max-width: 300px;">
                <div class="w-full mb-2">
                  <div class="bg-[#ffb534] px-2 py-2 rounded-t-2xl text-xs font-bold text-[#41154d] text-center">
                    {partido['@competition']}<br />
                    {fechaHora.fecha} {fechaHora.hora} hrs.
                  </div>
                </div>
                <div class="flex items-center justify-center gap-4 mt-2">
                  <img src={getEscudoUrl(partido['@homeTeamId'])} alt={partido['@homeTeamName']} class="h-12" />
                  <span class="text-base font-bold text-[#41154d]">VS</span>
                  <img src={getEscudoUrl(partido['@awayTeamId'])} alt={partido['@awayTeamName']} class="h-12" />
                </div>
                <div class="flex items-center justify-around gap-4 mt-2 w-full px-4">
                  <span class="font-bold text-xs text-[#41154d]">{partido['@homeTeamName'].toUpperCase()}</span>
                  <span class="font-bold text-xs text-[#41154d]">{partido['@awayTeamName'].toUpperCase()}</span>
                </div>
              </div>
            )
          })
        )}
      </div>
    </div>

