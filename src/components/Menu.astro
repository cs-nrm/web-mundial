<!--div class="opacity-back"></div-->
<style>

@media (max-width: 990px) {
  .main-logo{
    width: 70%;
    transition: all 0.5s;
  }
  .main-logo.compress-logo{
    width: 50%;
    transition: all 0.5s;
  }
.menu-mobile{
  display: flex !important;
  margin-right: 15px;
}
.menu-mobile:after { content:  'ᐅ'; font-size: 18px; position: absolute; top: 10%; right: -2px;}
.links-menu{
  display: none !important;
}
.menutres {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  gap: 15px;
}
.menutres >{
  flex: 1 0 50%;
}
.menutres:first-child{
  flex: 0 1 50%;
}
  .logo{
    justify-content: left;
    padding-left: 0 !important;
  }
  button{
    justify-content: right;
  }
}

.menu-mobile{
  white-space: nowrap;
  overflow-x: scroll;
  -ms-overflow-style: none;  /* Internet Explorer 10+ */
  scrollbar-width: none;  /* Firefox */
}
.menu-mobile::-webkit-scrollbar { 
    display: none;  /* Safari and Chrome */
}



/*nav::before {content:''; width: 100%; height: 100%; position: absolute; background:black; top:0; z-index: -1;}*/
/*.link-menu{height: 39px;}*/
.menu-mobile a {color:white;  font-size: 14px;}
/*.main-logo {  width: 100px; height: 100%;}
.main-logo img{ width: 100%; height: auto;}*/
button.radio-button {    display: flex;    align-items: center;    gap: 7px;      font-size: 15px;  color: #ffaa1f;}
.opacity-back {
    position: absolute;
    top: 0;
    left: 0;
    -webkit-backdrop-filter: brightness(60%) blur(16px);
    backdrop-filter: brightness(60%) blur(16px);
    width: 100%;
    height: 100%;
    z-index: -1;
}

nav ul {
	padding: 0;
  margin: 0;
	list-style: none;
	position: relative;
  overflow: visible;
}
	
nav ul li {
	display:inline-block;
}

nav a, .dd-menu, .dd-menu2 {
	display:block;
	padding:0 7px;	
	color:#FFF;
	font-size:14px;
	text-decoration:none;
  position: relative;
  line-height: 1.2;
  overflow: visible;
  margin-bottom: 12px;
}
.dd-menu2{
  display: flex !important;
  align-items: center;
}

nav a:hover, dd-menu:hover { 
	background-color: #000; 
  color:white;
}
nav a:checked, dd-menu:checked { 
	color: var(--amarillo-beat); 
}

/* Hide Dropdowns by Default */
nav ul ul {
	display: none;
	position: absolute; 
  backdrop-filter: brightness(60%) blur(16px);
  top: 16px;
  padding-top: 5px;
  left: 0;
  overflow: visible;
  z-index: 2;
}
nav ul .dd-menu2 ul {
  top: 0;
  right: auto;
  left: 135px;
  justify-content: space-around;
  justify-items: center;
  flex-direction: column;
  background-color: var(--morado);
}
nav ul .dd-menu2 ul li a{
  font-size: 12px;
}
	
/* Display Dropdowns on Hover */
nav ul li:hover > ul {
  display: inherit;
}
nav ul li.dd-menu2:hover > ul {
	display:flex;
  justify-content: space-around;
  justify-items: center;
}
	
/* Fisrt Tier Dropdown */
nav ul ul li {
	width:150px;
	float:none;
	display:list-item;
	position: relative;
}
nav ul .dd-menu2 ul li {
  text-align: center;
}

/* Second, Third and more Tiers	*/
/*nav ul ul ul li {
	position: relative;
	top:-20px; 
	left:140px;
}*/
nav ul ul ul{
  background-color: #000;
}

	
/* Change this in order to change the Dropdown symbol */
li > a:after, .dd-menu:after { content:  ' ▾'; font-size: 10px;}
.dd-menu2:after { content:  ' ▸'; font-size: 10px;}
li > a:only-child:after, li > .dd-menu:only-child:after { content: ''; }

.live-icon {
    display: inline-block;
    position: relative;
    top: calc(50% - 5px);
    background-color: var(--amarillo-beat);
    width: 10px;
    height: 10px;
    margin-right: 10px;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 50%;
    z-index: 1;
}
.live-icon:before {
    content: "";
    display: block;
    position: absolute;
    background-color: rgba(255, 170, 31, 0.6);
    width: 100%;
    height: 100%;
    border-radius: 50%;
    -webkit-animation: live 2s ease-in-out infinite;
    animation: live 2s ease-in-out infinite;
    z-index: -1;
}
@keyframes live {
  0% {
    transform: scale(1, 1);
  }
  100% {
    transform: scale(3.5, 3.5);
    background-color: rgba(255, 170, 31, 0);
  }
}

.active > a,
li.active > div,
li.active > span {
  background: var(--rojo);
    color: black;
    transition: all 0.5s;
}
.active {
  font-weight: bold;
  transition: all 0.5s;
}

</style>