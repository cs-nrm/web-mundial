---
import { createSupabaseAdminClient } from '../lib/supabase'
import { getFlagUrl } from '../lib/flags.js'

const supabase = createSupabaseAdminClient()

const now = new Date()
const cdmxNow = new Date(now.getTime() - 6 * 60 * 60_000)
const ayer   = new Date(cdmxNow.getTime() - 24 * 60 * 60_000).toISOString().slice(0, 10)
const manana = new Date(cdmxNow.getTime() + 24 * 60 * 60_000).toISOString().slice(0, 10)

const { data: matches = [] } = await supabase
  .from('df_partidos')
  .select('*')
  .gte('fecha_utc', `${ayer}T06:00:00Z`)
  .lte('fecha_utc', `${manana}T06:00:00Z`)
  .order('fecha_utc', { ascending: true })

function formatHora(fechaUtc: string) {
  return new Date(fechaUtc).toLocaleTimeString('es-MX', {
    timeZone: 'America/Mexico_City',
    hour: '2-digit',
    minute: '2-digit',
    hour12: true,
  })
}

function formatFechaDia(fechaUtc: string) {
  const d = new Date(fechaUtc)
  const cdmx = new Date(d.getTime() - 6 * 60 * 60_000)
  const hoyStr = cdmxNow.toISOString().slice(0, 10)
  const diaStr = cdmx.toISOString().slice(0, 10)
  if (diaStr === hoyStr) return 'Hoy'
  const ayerStr = new Date(cdmxNow.getTime() - 24 * 60 * 60_000).toISOString().slice(0, 10)
  if (diaStr === ayerStr) return 'Ayer'
  return d.toLocaleDateString('es-MX', { weekday: 'long', day: 'numeric', month: 'short', timeZone: 'America/Mexico_City' })
}

// Agrupar por día CDMX
const days: Record<string, typeof matches> = {}
for (const m of (matches ?? [])) {
  const d = new Date(m.fecha_utc)
  const cdmx = new Date(d.getTime() - 6 * 60 * 60_000)
  const key = cdmx.toISOString().slice(0, 10)
  if (!days[key]) days[key] = []
  days[key].push(m)
}
---

{Object.keys(days).length === 0 ? (
  <p class="text-center text-gray-400 py-6 text-sm">Sin partidos próximos.</p>
) : (
  <div class="partidos-widget" id="partidos-widget">
    {Object.entries(days).map(([dayKey, dayMatches]) => (
      <div class="pw-day-group">
        <p class="pw-day-label">{formatFechaDia(dayMatches[0].fecha_utc)}</p>
        <div class="pw-scroll">
          {dayMatches.map(m => (
            <a
              href={`/partidos-del-dia/${m.slug}/`}
              class={`pw-card ${m.status}`}
              data-match-id={m.match_id}
            >
              {m.status === 'en_vivo' && (
                <span class="pw-live-badge">EN VIVO</span>
              )}
              {m.status === 'finalizado' && (
                <span class="pw-final-badge">Final</span>
              )}
              {m.status === 'programado' && (
                <span class="pw-hora">{formatHora(m.fecha_utc)}</span>
              )}

              <div class="pw-equipos">
                <div class="pw-equipo">
                  {getFlagUrl(m.equipo_local, 80)
                    ? <img src={getFlagUrl(m.equipo_local, 80) ?? ''} alt={m.equipo_local} class="pw-flag" />
                    : <span class="pw-no-flag">🏳️</span>
                  }
                  <span class="pw-nombre">{m.equipo_local}</span>
                </div>

                <div class="pw-marcador" data-score>
                  {m.status !== 'programado'
                    ? <><span class="pw-score">{m.score_local}</span><span class="pw-dash">-</span><span class="pw-score">{m.score_visitante}</span></>
                    : <span class="pw-vs goodtime">VS</span>
                  }
                </div>

                <div class="pw-equipo">
                  {getFlagUrl(m.equipo_visitante, 80)
                    ? <img src={getFlagUrl(m.equipo_visitante, 80) ?? ''} alt={m.equipo_visitante} class="pw-flag" />
                    : <span class="pw-no-flag">🏳️</span>
                  }
                  <span class="pw-nombre">{m.equipo_visitante}</span>
                </div>
              </div>

              {m.grupo && <p class="pw-grupo">{m.grupo}</p>}
            </a>
          ))}
        </div>
      </div>
    ))}
    <div class="pw-ver-todos">
      <a href="/partidos-del-dia/">Ver todos los partidos →</a>
    </div>
  </div>
)}

<script>
// Polling en vivo cada 30s
let pollTimer: ReturnType<typeof setInterval> | null = null

function updateWidget(matches: any[]) {
  const map = new Map(matches.map((m: any) => [m.match_id, m]))

  document.querySelectorAll<HTMLElement>('[data-match-id]').forEach(card => {
    const id = card.dataset.matchId!
    const m = map.get(id)
    if (!m) return

    // Actualizar badge de status
    card.querySelector('.pw-live-badge')?.remove()
    card.querySelector('.pw-final-badge')?.remove()
    card.querySelector('.pw-hora')?.remove()

    const scoreEl = card.querySelector('[data-score]')
    if (!scoreEl) return

    if (m.status === 'en_vivo') {
      const badge = document.createElement('span')
      badge.className = 'pw-live-badge'
      badge.textContent = 'EN VIVO'
      card.insertBefore(badge, card.querySelector('.pw-equipos'))
      scoreEl.innerHTML = `<span class="pw-score">${m.score_local}</span><span class="pw-dash">-</span><span class="pw-score">${m.score_visitante}</span>`
    } else if (m.status === 'finalizado') {
      const badge = document.createElement('span')
      badge.className = 'pw-final-badge'
      badge.textContent = 'Final'
      card.insertBefore(badge, card.querySelector('.pw-equipos'))
      scoreEl.innerHTML = `<span class="pw-score">${m.score_local}</span><span class="pw-dash">-</span><span class="pw-score">${m.score_visitante}</span>`
    }

    card.className = `pw-card ${m.status}`
  })
}

async function poll() {
  try {
    const res = await fetch('/api/partidos')
    if (!res.ok) return
    const data = await res.json()
    updateWidget(data)
  } catch { /* silent */ }
}

if (document.getElementById('partidos-widget')) {
  pollTimer = setInterval(poll, 30_000)
}
</script>

<style>
.partidos-widget {
  margin: 1rem 0;
}

.pw-day-group {
  margin-bottom: 1.5rem;
}

.pw-day-label {
  font-size: 0.7rem;
