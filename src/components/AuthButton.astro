---
const { user } = Astro.locals
const nombre = user?.user_metadata?.full_name?.split(' ')[0] ?? ''
const avatar = user?.user_metadata?.avatar_url ?? ''
---

{user ? (
  <div class="auth-user">
    <button class="auth-trigger" id="auth-trigger" aria-expanded="false">
      {avatar
        ? <img src={avatar} alt={nombre} class="auth-avatar" referrerpolicy="no-referrer" />
        : <span class="auth-avatar auth-initials">{nombre[0]?.toUpperCase()}</span>
      }
      <span class="auth-name hidden lg:block">{nombre}</span>
      <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
        <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    <div class="auth-dropdown" id="auth-dropdown">
      <a href="/auth/logout" class="auth-dropdown-item">Cerrar sesión</a>
    </div>
  </div>
) : (
  <a href="/auth/login" class="btn-login">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
      <circle cx="12" cy="7" r="4"/>
    </svg>
    <span class="hidden lg:block">Iniciar sesión</span>
  </a>
)}

<script>
  const trigger = document.getElementById('auth-trigger')
  const dropdown = document.getElementById('auth-dropdown')

  if (trigger && dropdown) {
    trigger.addEventListener('click', () => {
      const open = trigger.getAttribute('aria-expanded') === 'true'
      trigger.setAttribute('aria-expanded', String(!open))
      dropdown.classList.toggle('open', !open)
    })

    document.addEventListener('click', (e) => {
      if (!trigger.contains(e.target as Node) && !dropdown.contains(e.target as Node)) {
        trigger.setAttribute('aria-expanded', 'false')
        dropdown.classList.remove('open')
      }
    })
  }
</script>

<style>
  .btn-login {
    display: flex;
    align-items: center;
    gap: 6px;
    color: white;
    font-size: 13px;
    font-family: 'Roboto', sans-serif;
    text-decoration: none;
    padding: 5px 10px;
    border: 1px solid rgba(255,255,255,0.4);
    border-radius: 20px;
    transition: background 0.2s;
    white-space: nowrap;
  }
  .btn-login:hover {
    background: rgba(255,255,255,0.15);
  }

  .auth-user {
    position: relative;
  }
  .auth-trigger {
    display: flex;
    align-items: center;
    gap: 6px;
    background: none;
    border: none;
    cursor: pointer;
    color: white;
    font-size: 13px;
    font-family: 'Roboto', sans-serif;
    padding: 4px 8px;
    border-radius: 20px;
    transition: background 0.2s;
  }
  .auth-trigger:hover {
    background: rgba(255,255,255,0.15);
  }
  .auth-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
  }
  .auth-initials {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--rojo, #EA262A);
    color: white;
    font-size: 12px;
    font-weight: bold;
  }
  .auth-name {
    max-width: 80px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .auth-dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    background: #1a1a2e;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 8px;
    min-width: 140px;
    z-index: 100;
    overflow: hidden;
  }
  .auth-dropdown.open {
    display: block;
  }
  .auth-dropdown-item {
    display: block;
    padding: 10px 16px;
    color: white;
    font-size: 13px;
    text-decoration: none;
    transition: background 0.2s;
  }
  .auth-dropdown-item:hover {
    background: rgba(255,255,255,0.1);
  }
</style>
