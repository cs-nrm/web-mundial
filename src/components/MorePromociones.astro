---
import Card from '../layouts/CardMoreNews.astro';


const res = await fetch("https://sabrositadigital.com.mx/wp-json/wp/v2/posts?_embed&per_page=4&_fields=title,slug,yoast_head_json,categories,_links,_embedded&categories=505");
const posts = await res.json();

---
<div class="my-12 mx-auto">
	<h5 class="font-bold">Te podría interesar...</h4>
        <section class="flex flex-wrap -mx-1 lg:-mx-4">
                    {
                        posts.map((post:any) => ( 
                        <>
                        <Card {post} />
                        </>
                        ))
                    }
        </section>
<div class="m-auto text-center">
    <a href="/promociones" class="text-black hover:text-white">
        <button class="ver-mas group relative h-8 m-4 text-xl px-4 rounded-full spartan bold overflow-hidden bg-[#EA262A] border-4 border-[#EA262A] hover:border-[#FDCF27] font-bold">
            <span>Más</span>
        </button>
    </a>
</div>
</div>
