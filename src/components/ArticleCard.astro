  <div class="card">
        <div class="image">
            <img class="rounded-sm" src={sequentialImage} loading="lazy" alt={post.title?.rendered || ''} />
        </div>
    <div class="details rounded-l-md">
      <div class="center">
        <a href={`/${url_seccion}/${post.slug}/`}><img loading="lazy" class="w-full h-full object-cover aspect-video" src={featuredImage} alt={post.title.rendered}/>
        <p class="poppins" set:html={post.title.rendered}></p></a>
        <div class="flex items-center">
            <span>Creado por:</span>
            <img class="mx-2 w-[45px] h-auto" src={authorImage} alt={author} />
        <div>
      </div>
    </div>
  </div> 


<style>
.card {
    background: #000;
}
.card .image {
    width: 100%;
    height: 100%;
    overflow: hidden;
}
.card .image img {
    width: 100%;
    transition: .5s;
}
.card:hover .image img {
    opacity: .5;
    transform: translateX(30%);/*100%*/
}
.card .details {
    position: absolute;
    top: 0;
    left: 0;
    width: 80%;/*100%*/
    height: 100%;
    background: #ffc107;
    transition: .5s;
    transform-origin: left;
    transform: perspective(2000px) rotateY(-90deg);
}
.card:hover .details {
    transform: perspective(2000px) rotateY(0deg);
}
.card .details .center {
    padding: 8px;
    background: #fff;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
}
/*.card .details .center h1 {
    margin: 0;
    padding: 0;
    color: #ff3636;
    line-height: 20px;
    font-size: 20px;
    text-transform: uppercase;
}*/
.card .details .center span {
    text-transform: uppercase;
    font-size: 10px;
    color: #262626;
}
.card .details .center p {
    font-size: 14px;
    margin: 10px 0;
    padding: 0;
    color: #262626;
    display: -webkit-box;
    margin-block-start: 0;
    margin-block-end: 12px;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.3;
    padding-top: 10px;
}
.card .details .center a {
    text-decoration: none;
}
.card .details .center ul {
    margin: 10px auto 0;
    padding: 0;
    display: table;
}
.card .details .center ul li {
    list-style: none;
    margin: 0 5px;
    float: left;
}
.card .details .center ul li a {
    display: block;
    background: #262626;
    color: #fff;
    width: 30px;
    height: 30px;
    line-height: 30px;
    text-align: center;
    transform: .5s;
}
.card .details .center ul li a:hover {
    background: #ff3636;
}

@media (max-width: 768px) {
    .card .details {
        transform: perspective(2000px) rotateY(0deg);
    }
}
</style>