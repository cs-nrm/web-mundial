---
import { ViewTransitions } from 'astro:transitions';

---

<header class="header is-pinned">
  <ViewTransitions />
  <div class="header-inner">

  </div>
</header>

<style>
  .header-inner {
    display: flex;
    align-items: center;
    width: 100%;
  }
  .header-auth {
    margin-left: auto;
    padding-right: 12px;
    flex-shrink: 0;
  }
  .logo-beat-mobile img {
    filter: drop-shadow(1px 0px 0 white) drop-shadow(0px 1px 1px white);
  }
  @media screen and (min-width: 1199px) {
    .logo-beat-mobile {
      display: none;
    }
  }
</style>

