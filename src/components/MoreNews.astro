---
import Card from "../layouts/CardMoreNews.astro";
import { getArticles } from "../lib/api.js";

// Fetch latest 4 articles from all sites
const allPosts = await getArticles();
const posts = allPosts.slice(0, 4);
---

<div class="my-12 mx-auto">
    <h5 class="font-bold">Te podría interesar...</h5> 
    <section class="flex flex-wrap -mx-1 lg:-mx-4">
        {
            posts.map((post: any) => (
                <>
                    <Card {post} />
                </>
            ))
        }
    </section>
    <div class="m-auto text-center">
        <a href="/nota-sabrosa">
            <button
                class="ver-mas group relative h-8 m-4 text-xl px-4 rounded-full spartan bold overflow-hidden bg-[#EA262A] border-4 border-[#EA262A] hover:border-[#FDCF27] font-bold"
            >
                <span>Más</span>
            </button>
        </a>
    </div>
</div>