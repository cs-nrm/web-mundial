---
import AdminLayout from '../../../layouts/AdminLayout.astro'
import { canAccess, EDITOR_ROLES } from '../../../lib/admin'
import { createSupabaseAdminClient } from '../../../lib/supabase'
import type { UserRole } from '../../../lib/perfil'

const { role } = Astro.locals
if (!canAccess(role as UserRole, EDITOR_ROLES)) {
  return Astro.redirect('/admin/analisis')
}

const supabase = createSupabaseAdminClient()
const { data: partidos = [] } = await supabase
  .from('df_partidos')
  .select('slug, equipo_local, equipo_visitante, fecha_utc')
  .gte('fecha_utc', new Date(Date.now() - 3 * 24 * 60 * 60_000).toISOString())
  .order('fecha_utc', { ascending: true })
---

<AdminLayout title="Nueva entrada — Resumen de Análisis">
  <div class="form-page">
    <form id="analisis-form" class="form-card">

      <div class="form-group">
        <label for="titulo">Título *</label>
        <input id="titulo" name="titulo" type="text" required placeholder="ej. Análisis jornada 3" />
      </div>

      <div class="form-group">
        <label for="slug">Slug (URL) *</label>
        <input id="slug" name="slug" type="text" required placeholder="ej. analisis-jornada-3"
          pattern="[a-z0-9\-]+" title="Solo letras minúsculas, números y guiones" />
        <span class="hint">Se genera automático del título. URL: <code>/resumen-de-analisis/<span id="slug-preview">...</span></code></span>
      </div>

      <div class="form-group">
        <label for="partido_slug">Partido (opcional)</label>
        <select id="partido_slug" name="partido_slug">
          <option value="">— Sin partido asignado —</option>
          {(partidos ?? []).map(p => {
            const fecha = new Date(p.fecha_utc).toLocaleDateString('es-MX', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'UTC' })
            return (
              <option value={p.slug}>{fecha} · {p.equipo_local} vs {p.equipo_visitante}</option>
            )
          })}
        </select>
        <span class="hint">Vincula esta previa con la tarjeta del partido.</span>
      </div>

      <div class="form-group">
        <label for="publicado_en">Fecha de publicación</label>
        <input id="publicado_en" name="publicado_en" type="datetime-local" />
      </div>

      <div class="form-group editor-group">
        <label>Contenido *</label>
        <div class="editor-toolbar" id="toolbar">
          <button type="button" data-cmd="bold" title="Negrita"><b>B</b></button>
          <button type="button" data-cmd="italic" title="Cursiva"><i>I</i></button>
          <button type="button" data-cmd="h2" title="Encabezado 2">H2</button>
          <button type="button" data-cmd="h3" title="Encabezado 3">H3</button>
          <div class="sep"></div>
          <button type="button" data-cmd="bullet" title="Lista">&#8226; Lista</button>
          <button type="button" data-cmd="ordered" title="Numerada">1. Numerada</button>
          <div class="sep"></div>
          <button type="button" data-cmd="hr" title="Separador">— Separador</button>
          <button type="button" data-cmd="clear" title="Limpiar formato" class="clear-btn">✕ Limpiar</button>
        </div>
        <div id="editor" class="editor-content" contenteditable="false"></div>
        <input type="hidden" id="cuerpo" name="cuerpo" />
      </div>

      <div id="form-error" class="form-error" hidden></div>

      <div class="form-actions">
        <a href="/admin/analisis" class="btn-ghost">Cancelar</a>
        <button type="submit" class="btn-primary">Publicar</button>
      </div>
    </form>
  </div>
</AdminLayout>

<script>
  import { Editor } from '@tiptap/core'
  import StarterKit from '@tiptap/starter-kit'

  const tituloInput = document.getElementById('titulo') as HTMLInputElement
  const slugInput   = document.getElementById('slug') as HTMLInputElement
  const slugPreview = document.getElementById('slug-preview') as HTMLSpanElement
  const fechaInput  = document.getElementById('publicado_en') as HTMLInputElement
  const cuerpoInput = document.getElementById('cuerpo') as HTMLInputElement
  const form        = document.getElementById('analisis-form') as HTMLFormElement
  const errorBox    = document.getElementById('form-error') as HTMLDivElement

  // Fecha por defecto = ahora
  const now = new Date()
  now.setMinutes(now.getMinutes() - now.getTimezoneOffset())
  fechaInput.value = now.toISOString().slice(0, 16)

  // Auto-slug desde título
  function toSlug(val: string) {
    return val.toLowerCase()
      .normalize('NFD').replace(/[̀-ͯ]/g, '')
      .replace(/[^a-z0-9\s-]/g, '')
      .trim()
      .replace(/\s+/g, '-')
  }

  tituloInput.addEventListener('input', () => {
    if (!slugInput.dataset.manual) {
      const s = toSlug(tituloInput.value)
      slugInput.value = s
      slugPreview.textContent = s || '...'
    }
  })

  slugInput.addEventListener('input', () => {
    slugInput.dataset.manual = 'true'
    slugPreview.textContent = slugInput.value || '...'
  })

  // TipTap editor
  const editor = new Editor({
    element: document.getElementById('editor')!,
    extensions: [StarterKit],
    content: '<p></p>',
    editorProps: {
      attributes: { class: 'tiptap-inner' },
    },
  })

  // Toolbar
  document.getElementById('toolbar')!.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('[data-cmd]') as HTMLElement | null
    if (!btn) return
    const cmd = btn.dataset.cmd
    const chain = editor.chain().focus()
    if (cmd === 'bold')    chain.toggleBold().run()
    if (cmd === 'italic')  chain.toggleItalic().run()
    if (cmd === 'h2')      chain.toggleHeading({ level: 2 }).run()
    if (cmd === 'h3')      chain.toggleHeading({ level: 3 }).run()
    if (cmd === 'bullet')  chain.toggleBulletList().run()
    if (cmd === 'ordered') chain.toggleOrderedList().run()
    if (cmd === 'hr')      chain.setHorizontalRule().run()
    if (cmd === 'clear')   chain.clearNodes().unsetAllMarks().run()
  })

  form.addEventListener('submit', async (e) => {
    e.preventDefault()
    const btn = form.querySelector('button[type=submit]') as HTMLButtonElement
    btn.disabled = true
    btn.textContent = 'Publicando...'
    errorBox.hidden = true

    const html = editor.getHTML()
    if (!html || html === '<p></p>') {
      errorBox.textContent = 'El contenido no puede estar vacío'
      errorBox.hidden = false
      btn.disabled = false
      btn.textContent = 'Publicar'
      return
    }

    cuerpoInput.value = html

    const body = {
      titulo: tituloInput.value.trim(),
      slug: slugInput.value.trim(),
      cuerpo: html,
      publicado_en: new Date(fechaInput.value).toISOString(),
      partido_slug: (document.getElementById('partido_slug') as HTMLInputElement).value.trim() || null,
    }

    try {
      const res = await fetch('/api/admin/analisis', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      })
      const data = await res.json()
      if (!res.ok) {
        errorBox.textContent = data.error ?? 'Error al publicar'
        errorBox.hidden = false
        btn.disabled = false
        btn.textContent = 'Publicar'
        return
      }
      window.location.href = `/admin/analisis/${data.id}`
    } catch {
      errorBox.textContent = 'Error de conexión'
      errorBox.hidden = false
      btn.disabled = false
      btn.textContent = 'Publicar'
    }
  })
</script>

<style>
  .form-page { max-width: 780px; }

  .form-card {
    background: white;
    border-radius: 0.75rem;
    padding: 2rem;
    box-shadow: 0 1px 4px rgba(0,0,0,0.06);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  label {
    font-size: 0.875rem;
    font-weight: 600;
    color: #444;
  }

  select {
    border: 1.5px solid #ddd;
    border-radius: 0.5rem;
    padding: 0.6rem 0.85rem;
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.2s;
    font-family: inherit;
    background: white;
  }
  select:focus { border-color: var(--rojo); }

  input[type=text], input[type=datetime-local] {
    border: 1.5px solid #ddd;
    border-radius: 0.5rem;
    padding: 0.6rem 0.85rem;
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.2s;
    font-family: inherit;
  }

  input:focus { border-color: var(--rojo); }

  .hint { font-size: 0.75rem; color: #999; }
  .hint code { background: #f0f0f0; padding: 0.1rem 0.3rem; border-radius: 3px; font-size: 0.8rem; }

  /* Editor */
  .editor-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    padding: 0.5rem;
    background: #f8f8f8;
    border: 1.5px solid #ddd;
    border-bottom: none;
    border-radius: 0.5rem 0.5rem 0 0;
  }

  .editor-toolbar button {
    padding: 0.3rem 0.6rem;
    border: 1px solid #e0e0e0;
    border-radius: 0.3rem;
    background: white;
    cursor: pointer;
    font-size: 0.8rem;
    color: #444;
    transition: background 0.15s, color 0.15s;
    font-family: inherit;
  }

  .editor-toolbar button:hover { background: var(--morado); color: white; border-color: var(--morado); }
  .editor-toolbar .clear-btn:hover { background: #dc2626; border-color: #dc2626; }
  .editor-toolbar .sep { width: 1px; background: #ddd; margin: 0.1rem 0.15rem; }

  .editor-content {
    min-height: 320px;
    border: 1.5px solid #ddd;
    border-radius: 0 0 0.5rem 0.5rem;
    padding: 1rem;
    font-size: 0.95rem;
    line-height: 1.7;
    outline: none;
    cursor: text;
  }

  :global(.tiptap-inner) { outline: none; min-height: 280px; }
  :global(.tiptap-inner h2) { font-size: 1.3rem; font-weight: 700; margin: 1rem 0 0.5rem; color: var(--morado); }
  :global(.tiptap-inner h3) { font-size: 1.1rem; font-weight: 700; margin: 0.75rem 0 0.4rem; }
  :global(.tiptap-inner p) { margin: 0 0 0.75rem; }
  :global(.tiptap-inner ul) { list-style: disc; padding-left: 1.5rem; margin: 0.5rem 0; }
  :global(.tiptap-inner ol) { list-style: decimal; padding-left: 1.5rem; margin: 0.5rem 0; }
  :global(.tiptap-inner hr) { border: none; border-top: 2px solid #eee; margin: 1rem 0; }
  :global(.tiptap-inner p.is-editor-empty:first-child::before) {
    content: 'Pega aquí el contenido del Word…';
    color: #bbb;
    pointer-events: none;
    float: left;
    height: 0;
  }

  .form-error {
    background: #fee2e2;
    color: #991b1b;
    padding: 0.6rem 0.85rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
  }

  .form-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: flex-end;
    padding-top: 0.5rem;
  }

  .btn-primary {
    background: var(--rojo);
    color: white;
    padding: 0.6rem 1.4rem;
    border-radius: 0.5rem;
    font-weight: 700;
    border: none;
    cursor: pointer;
    font-size: 0.95rem;
    transition: opacity 0.2s;
  }

  .btn-primary:hover { opacity: 0.85; }
  .btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }

  .btn-ghost {
    background: transparent;
    color: #666;
    padding: 0.6rem 1.4rem;
    border-radius: 0.5rem;
    font-weight: 600;
    border: 1.5px solid #ddd;
    text-decoration: none;
    font-size: 0.95rem;
    transition: border-color 0.2s;
  }

  .btn-ghost:hover { border-color: #aaa; }
</style>
