---
import AdminLayout from '../../../layouts/AdminLayout.astro'
import { createSupabaseServerClient } from '../../../lib/supabase'
import { canAccess, EDITOR_ROLES } from '../../../lib/admin'
import type { UserRole } from '../../../lib/perfil'

const { id } = Astro.params
const { role } = Astro.locals
const canManage = canAccess(role as UserRole, EDITOR_ROLES)

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies)

const { data: album } = await supabase
  .from('albums')
  .select('*')
  .eq('id', id)
  .maybeSingle()

if (!album) return Astro.redirect('/admin/albums')

const { data: cards } = await supabase
  .from('cards')
  .select('id, name, descripcion, image_url, posicion, active')
  .eq('album_id', id)
  .order('posicion', { ascending: true })

// Cuántas veces se ha canjeado cada figurita
const cardIds = (cards ?? []).map((c: any) => c.id)
const { data: canjeos } = cardIds.length > 0
  ? await supabase.from('user_cards').select('card_id').in('card_id', cardIds)
  : { data: [] }

const canjeoCount: Record<string, number> = {}
for (const c of (canjeos ?? [])) {
  canjeoCount[c.card_id] = (canjeoCount[c.card_id] ?? 0) + 1
}
---

<AdminLayout title={album.name}>
  <div class="album-detail">
    <!-- Info del álbum -->
    <section class="panel">
      <div class="panel-header">
        <h2>Datos del álbum</h2>
        {canManage && (
          <div style="display:flex;gap:0.5rem">
            <button id="btn-edit-album" class="btn-sm">Editar</button>
            <button id="btn-delete-album" class="btn-sm btn-sm-danger"
              data-id={album.id} data-name={album.name}>
              Eliminar
            </button>
          </div>
        )}
      </div>

      <div id="album-view" class="info-grid">
        <div><span class="info-label">Nombre</span><span>{album.name}</span></div>
        <div><span class="info-label">Slug</span><span class="mono">{album.slug}</span></div>
        <div><span class="info-label">Descripción</span><span>{album.descripcion ?? '—'}</span></div>
        <div><span class="info-label">Portada</span>
          {album.cover_url
            ? <a href={album.cover_url} target="_blank" class="link-ext">Ver imagen</a>
            : <span>—</span>
          }
        </div>
        <div><span class="info-label">Estación</span><span>{album.estacion ?? '—'}</span></div>
        <div>
          <span class="info-label">Color acento</span>
          {album.color_acento
            ? <span style={`display:inline-flex;align-items:center;gap:0.5rem`}>
                <span style={`display:inline-block;width:1rem;height:1rem;border-radius:50%;background:${album.color_acento};border:1px solid rgba(0,0,0,0.1)`}></span>
                <span class="mono">{album.color_acento}</span>
              </span>
            : <span>—</span>
          }
        </div>
        <div>
          <span class="info-label">Color acento 2</span>
          {album.color_acento2
            ? <span style={`display:inline-flex;align-items:center;gap:0.5rem`}>
                <span style={`display:inline-block;width:1rem;height:1rem;border-radius:50%;background:${album.color_acento2};border:1px solid rgba(0,0,0,0.1)`}></span>
                <span class="mono">{album.color_acento2}</span>
              </span>
            : <span style="color:#aaa;font-size:0.8rem">Usa color acento 1</span>
          }
        </div>
        <div><span class="info-label">Logo URL</span>
          {album.logo_url
            ? <a href={album.logo_url} target="_blank" class="link-ext">Ver logo</a>
            : <span>—</span>
          }
        </div>
        <div><span class="info-label">Banner patrocinador</span>
          {album.banner_patrocinador_url
            ? <span style="display:flex;align-items:center;gap:0.75rem">
                <img src={album.banner_patrocinador_url} alt="Banner patrocinador" style="height:3rem;border-radius:0.375rem;object-fit:contain;border:1px solid #e5e7eb" />
                <a href={album.banner_patrocinador_url} target="_blank" class="link-ext">Ver imagen</a>
              </span>
            : <span>—</span>
          }
        </div>
        <div>
          <span class="info-label">Color header</span>
          {album.color_header
            ? <span style={`display:inline-flex;align-items:center;gap:0.5rem`}>
                <span style={`display:inline-block;width:1rem;height:1rem;border-radius:50%;background:${album.color_header};border:1px solid rgba(0,0,0,0.1)`}></span>
                <span class="mono">{album.color_header}</span>
              </span>
            : <span style="color:#aaa;font-size:0.8rem">—</span>
          }
        </div>
        <div>
          <span class="info-label">Color body</span>
          {album.color_body
            ? <span style={`display:inline-flex;align-items:center;gap:0.5rem`}>
                <span style={`display:inline-block;width:1rem;height:1rem;border-radius:50%;background:${album.color_body};border:1px solid rgba(0,0,0,0.1)`}></span>
                <span class="mono">{album.color_body}</span>
              </span>
            : <span style="color:#aaa;font-size:0.8rem">—</span>
          }
        </div>
        <div>
          <span class="info-label">Color fondo card</span>
          {album.color_fondo_card
            ? <span style={`display:inline-flex;align-items:center;gap:0.5rem`}>
                <span style={`display:inline-block;width:1rem;height:1rem;border-radius:50%;background:${album.color_fondo_card};border:1px solid rgba(0,0,0,0.1)`}></span>
                <span class="mono">{album.color_fondo_card}</span>
              </span>
            : <span style="color:#aaa;font-size:0.8rem">—</span>
          }
        </div>
        <div>
          <span class="info-label">Color texto card</span>
          {album.color_texto_card
            ? <span style={`display:inline-flex;align-items:center;gap:0.5rem`}>
                <span style={`display:inline-block;width:1rem;height:1rem;border-radius:50%;background:${album.color_texto_card};border:1px solid rgba(0,0,0,0.1)`}></span>
                <span class="mono">{album.color_texto_card}</span>
              </span>
            : <span style="color:#aaa;font-size:0.8rem">—</span>
          }
        </div>
        <div>
          <span class="info-label">Total cards</span>
          <span>{album.total_cards ?? '—'}</span>
          {album.total_cards && <span style="color:#6b7280;font-size:0.8rem"> ({(cards ?? []).length} cargadas)</span>}
        </div>
        <div><span class="info-label">Estado</span>
          <span class={`badge ${album.active ? 'badge-green' : 'badge-gray'}`}>
            {album.active ? 'Activo' : 'Inactivo'}
          </span>
        </div>
      </div>

      {canManage && (
        <form id="album-edit-form" class="edit-form" hidden
          data-id={album.id}>
          <div class="form-row">
            <label>Nombre</label>
            <input name="name" type="text" value={album.name} required />
          </div>
          <div class="form-row">
            <label>Slug</label>
            <input name="slug" type="text" value={album.slug} required pattern="[a-z0-9\-]+" />
          </div>
          <div class="form-row">
            <label>Descripción</label>
            <textarea name="descripcion" rows="2">{album.descripcion ?? ''}</textarea>
          </div>
          <div class="form-row">
            <label>URL Portada</label>
            <input name="cover_url" type="url" value={album.cover_url ?? ''} />
          </div>
          <div class="form-row">
            <label>Estación</label>
            <select name="estacion">
              <option value="">— Sin estación —</option>
              {(['oye', 'beat', 'stereocien', 'sabrosita'] as const).map(e => (
                <option value={e} selected={album.estacion === e}>{e}</option>
              ))}
            </select>
          </div>
          <div class="form-row">
            <label>Color de acento 1 (derecha del degradado)</label>
            <div style="display:flex;align-items:center;gap:0.75rem">
              <input name="color_acento" type="color" value={album.color_acento ?? '#ff6b35'}
                style="width:2.5rem;height:2.25rem;padding:0.1rem;border:1px solid #d1d5db;border-radius:0.375rem;cursor:pointer" />
              <input name="color_acento_hex" type="text" value={album.color_acento ?? '#ff6b35'}
                placeholder="#ff6b35" maxlength="7"
                style="flex:1;border:1px solid #d1d5db;border-radius:0.375rem;padding:0.4rem 0.6rem;font-family:monospace;font-size:0.875rem" />
            </div>
            <p style="font-size:0.75rem;color:#6b7280;margin-top:0.25rem">Barra de progreso, bordes y texto en accent.</p>
          </div>
          <div class="form-row">
            <label>Color de acento 2 (izquierda del degradado)</label>
            <div style="display:flex;align-items:center;gap:0.75rem">
              <input name="color_acento2" type="color" value={album.color_acento2 ?? album.color_acento ?? '#e8531a'}
                style="width:2.5rem;height:2.25rem;padding:0.1rem;border:1px solid #d1d5db;border-radius:0.375rem;cursor:pointer" />
              <input name="color_acento2_hex" type="text" value={album.color_acento2 ?? album.color_acento ?? '#e8531a'}
                placeholder="#e8531a" maxlength="7"
                style="flex:1;border:1px solid #d1d5db;border-radius:0.375rem;padding:0.4rem 0.6rem;font-family:monospace;font-size:0.875rem" />
            </div>
            <p style="font-size:0.75rem;color:#6b7280;margin-top:0.25rem">Panel de cards, botón Canjear y footer del modal. Si se deja igual que acento 1 no hay degradado.</p>
          </div>
          <div class="form-row">
            <label>Color texto del botón Canjear</label>
            <div style="display:flex;align-items:center;gap:0.75rem">
              <input name="color_texto" type="color" value={album.color_texto ?? '#ffffff'}
                style="width:2.5rem;height:2.25rem;padding:0.1rem;border:1px solid #d1d5db;border-radius:0.375rem;cursor:pointer" />
              <input name="color_texto_hex" type="text" value={album.color_texto ?? '#ffffff'}
                placeholder="#ffffff" maxlength="7"
                style="flex:1;border:1px solid #d1d5db;border-radius:0.375rem;padding:0.4rem 0.6rem;font-family:monospace;font-size:0.875rem" />
            </div>
            <p style="font-size:0.75rem;color:#6b7280;margin-top:0.25rem">Texto sobre el botón y el footer de cada card. Usa negro si el acento es claro (ej. amarillo).</p>
          </div>
          <div class="form-row">
            <label>Color header (fondo del encabezado)</label>
            <div style="display:flex;align-items:center;gap:0.75rem">
              <input name="color_header" type="color" value={album.color_header ?? '#0f1118'}
                style="width:2.5rem;height:2.25rem;padding:0.1rem;border:1px solid #d1d5db;border-radius:0.375rem;cursor:pointer" />
              <input name="color_header_hex" type="text" value={album.color_header ?? '#0f1118'}
                placeholder="#0f1118" maxlength="7"
                style="flex:1;border:1px solid #d1d5db;border-radius:0.375rem;padding:0.4rem 0.6rem;font-family:monospace;font-size:0.875rem" />
            </div>
            <p style="font-size:0.75rem;color:#6b7280;margin-top:0.25rem">Fondo de la sección superior (nombre, álbum, progreso).</p>
          </div>
          <div class="form-row">
            <label>Color texto header</label>
            <div style="display:flex;align-items:center;gap:0.75rem">
              <input name="color_texto_header" type="color" value={album.color_texto_header ?? '#ffffff'}
                style="width:2.5rem;height:2.25rem;padding:0.1rem;border:1px solid #d1d5db;border-radius:0.375rem;cursor:pointer" />
              <input name="color_texto_header_hex" type="text" value={album.color_texto_header ?? '#ffffff'}
                placeholder="#ffffff" maxlength="7"
                style="flex:1;border:1px solid #d1d5db;border-radius:0.375rem;padding:0.4rem 0.6rem;font-family:monospace;font-size:0.875rem" />
            </div>
            <p style="font-size:0.75rem;color:#6b7280;margin-top:0.25rem">Color del nombre, título del álbum y conteo de estampas.</p>
          </div>
          <div class="form-row">
            <label>Color body (fondo del contenido)</label>
            <div style="display:flex;align-items:center;gap:0.75rem">
              <input name="color_body" type="color" value={album.color_body ?? '#0f1118'}
                style="width:2.5rem;height:2.25rem;padding:0.1rem;border:1px solid #d1d5db;border-radius:0.375rem;cursor:pointer" />
              <input name="color_body_hex" type="text" value={album.color_body ?? '#0f1118'}
                placeholder="#0f1118" maxlength="7"
                style="flex:1;border:1px solid #d1d5db;border-radius:0.375rem;padding:0.4rem 0.6rem;font-family:monospace;font-size:0.875rem" />
            </div>
            <p style="font-size:0.75rem;color:#6b7280;margin-top:0.25rem">Fondo de la sección de cards (debajo de la barra de progreso).</p>
          </div>
          <div class="form-row">
            <label>Color texto body</label>
            <div style="display:flex;align-items:center;gap:0.75rem">
              <input name="color_texto_body" type="color" value={album.color_texto_body ?? '#ffffff'}
                style="width:2.5rem;height:2.25rem;padding:0.1rem;border:1px solid #d1d5db;border-radius:0.375rem;cursor:pointer" />
              <input name="color_texto_body_hex" type="text" value={album.color_texto_body ?? '#ffffff'}
                placeholder="#ffffff" maxlength="7"
                style="flex:1;border:1px solid #d1d5db;border-radius:0.375rem;padding:0.4rem 0.6rem;font-family:monospace;font-size:0.875rem" />
            </div>
            <p style="font-size:0.75rem;color:#6b7280;margin-top:0.25rem">Color del título y descripción en la sección de canjear código.</p>
          </div>
          <div class="form-row">
            <label>Color fondo card</label>
            <div style="display:flex;align-items:center;gap:0.75rem">
              <input name="color_fondo_card" type="color" value={album.color_fondo_card ?? '#1c1f28'}
                style="width:2.5rem;height:2.25rem;padding:0.1rem;border:1px solid #d1d5db;border-radius:0.375rem;cursor:pointer" />
              <input name="color_fondo_card_hex" type="text" value={album.color_fondo_card ?? '#1c1f28'}
                placeholder="#1c1f28" maxlength="7"
                style="flex:1;border:1px solid #d1d5db;border-radius:0.375rem;padding:0.4rem 0.6rem;font-family:monospace;font-size:0.875rem" />
            </div>
            <p style="font-size:0.75rem;color:#6b7280;margin-top:0.25rem">Fondo de cada tarjeta desbloqueada y del modal.</p>
          </div>
          <div class="form-row">
            <label>Color texto card</label>
            <div style="display:flex;align-items:center;gap:0.75rem">
              <input name="color_texto_card" type="color" value={album.color_texto_card ?? '#ffffff'}
                style="width:2.5rem;height:2.25rem;padding:0.1rem;border:1px solid #d1d5db;border-radius:0.375rem;cursor:pointer" />
              <input name="color_texto_card_hex" type="text" value={album.color_texto_card ?? '#ffffff'}
                placeholder="#ffffff" maxlength="7"
                style="flex:1;border:1px solid #d1d5db;border-radius:0.375rem;padding:0.4rem 0.6rem;font-family:monospace;font-size:0.875rem" />
            </div>
            <p style="font-size:0.75rem;color:#6b7280;margin-top:0.25rem">Color del número y nombre en el footer de cada card.</p>
          </div>
          <div class="form-row">
            <label>URL Logo</label>
            <input name="logo_url" type="url" value={album.logo_url ?? ''} placeholder="https://..." />
            <p style="font-size:0.75rem;color:#6b7280;margin-top:0.25rem">Logo que aparece en el encabezado del álbum.</p>
          </div>
          <div class="form-row">
            <label>Banner patrocinador</label>
            <div class="upload-area" id="banner-upload-area">
              <img id="banner-img-preview" class="img-preview"
                src={album.banner_patrocinador_url ?? ''}
                alt="Preview banner"
                style={album.banner_patrocinador_url ? '' : 'display:none'}
              />
              <label for="banner-file-input" class="upload-label" id="banner-upload-label"
                style={album.banner_patrocinador_url ? 'display:none' : ''}>
                <span class="upload-icon">🖼️</span>
                <span id="banner-upload-text">Seleccionar imagen</span>
                <span class="upload-hint">JPG, PNG, WebP · máx 5 MB</span>
              </label>
              <button type="button" id="banner-change-btn" class="banner-change-btn"
                style={album.banner_patrocinador_url ? '' : 'display:none'}>
                🔄 Cambiar imagen
              </button>
              <input id="banner-file-input" type="file" accept="image/jpeg,image/png,image/webp" class="file-input" />
            </div>
            <input name="banner_patrocinador_url" id="banner_patrocinador_url" type="url"
              value={album.banner_patrocinador_url ?? ''}
              placeholder="O pega una URL directamente"
              class="url-fallback"
            />
            <p style="font-size:0.75rem;color:#6b7280;margin-top:0.25rem">Se muestra a la derecha del cuadro para canjear códigos.</p>
          </div>
          <div class="form-row">
            <label>Total de cards</label>
            <input name="total_cards" type="number" min="1" max="500" value={album.total_cards ?? ''} placeholder="Ej. 60" />
            <p style="font-size:0.75rem;color:#6b7280;margin-top:0.25rem">El porcentaje de avance se calcula sobre este total, no sobre las cards cargadas.</p>
          </div>
          <div class="form-row form-check-row">
            <label>
              <input name="active" type="checkbox" checked={album.active} />
              Activo
            </label>
          </div>
          <div id="album-edit-error" class="form-error" hidden></div>
          <div class="form-actions">
            <button type="button" id="btn-cancel-edit" class="btn-ghost">Cancelar</button>
            <button type="submit" class="btn-primary">Guardar cambios</button>
          </div>
        </form>
      )}
    </section>

    <!-- Figuritas -->
    <section class="panel">
      <div class="panel-header">
        <h2>Cards ({(cards ?? []).length} / 60)</h2>
        {canManage && (
          <button id="btn-add-card" class="btn-sm">+ Agregar card</button>
        )}
      </div>

      {canManage && (
        <form id="card-form" class="edit-form" hidden data-album={id}>
          <input type="hidden" name="card_id" id="card_id_hidden" />
          <div class="form-row">
            <label>Posición (1–60) *</label>
            <input name="posicion" id="posicion" type="number" min="1" max="60" required />
          </div>
          <div class="form-row">
            <label>Nombre *</label>
            <input name="name" id="card_name" type="text" required />
          </div>
          <div class="form-row">
            <label>Descripción</label>
            <textarea name="descripcion" id="card_desc" rows="2"></textarea>
          </div>
          <div class="form-row">
            <label>Imagen</label>
            <div class="upload-area" id="upload-area">
              <img id="img-preview" class="img-preview" src="" alt="" hidden />
              <label for="file-input" class="upload-label" id="upload-label">
                <span class="upload-icon">📁</span>
                <span id="upload-text">Seleccionar imagen</span>
                <span class="upload-hint">JPG, PNG, WebP · máx 5 MB</span>
              </label>
              <input id="file-input" type="file" accept="image/jpeg,image/png,image/webp,image/gif" class="file-input" />
            </div>
            <input name="image_url" id="card_image" type="url" placeholder="O pega una URL directamente" class="url-fallback" />
            <div id="upload-status" class="upload-status" hidden></div>
          </div>
          <div id="card-form-error" class="form-error" hidden></div>
          <div class="form-actions">
            <button type="button" id="btn-cancel-card" class="btn-ghost">Cancelar</button>
            <button type="submit" id="btn-save-card" class="btn-primary">Guardar card</button>
          </div>
        </form>
      )}

      {(!cards || cards.length === 0) ? (
        <p class="empty">No hay cards todavía.</p>
      ) : (
        <div class="cards-table-wrap">
          <table class="data-table">
            <thead>
              <tr>
                <th>#</th>
                <th>Nombre</th>
                <th>Imagen</th>
                <th>Canjes</th>
                <th>Estado</th>
                {canManage && <th></th>}
              </tr>
            </thead>
            <tbody>
              {cards.map((card: any) => (
                <tr data-card-id={card.id}>
                  <td class="pos">{card.posicion}</td>
                  <td class="name-cell">{card.name}</td>
                  <td>
                    {card.image_url
                      ? <a href={card.image_url} target="_blank" class="link-ext">Ver</a>
                      : <span class="muted">—</span>
                    }
                  </td>
                  <td class="count">{canjeoCount[card.id] ?? 0}</td>
                  <td>
                    <span class={`badge ${card.active ? 'badge-green' : 'badge-gray'}`}>
                      {card.active ? 'Activa' : 'Inactiva'}
                    </span>
                  </td>
                  {canManage && (
                    <td class="actions-cell">
                      <button class="action-link btn-edit-card"
                        data-id={card.id}
                        data-posicion={card.posicion}
                        data-name={card.name}
                        data-desc={card.descripcion ?? ''}
                        data-image={card.image_url ?? ''}>
                        Editar
                      </button>
                      <button class="action-link action-codigo btn-gen-codigo"
                        data-id={card.id}
                        data-name={card.name}
                        data-posicion={card.posicion}>
                        Código
                      </button>
                      <button class="action-link action-delete btn-delete-card"
                        data-id={card.id}
                        data-name={card.name}>
                        Eliminar
                      </button>
                    </td>
                  )}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>

    <!-- Accesos rápidos -->
    <div class="quick-links">
      <a href={`/admin/codigos?album=${id}`} class="quick-link">
        <span>🎟️</span> Gestionar códigos de este álbum
      </a>
      <a href={`/album/${album.slug}`} target="_blank" class="quick-link">
        <span>👁️</span> Ver álbum como usuario
      </a>
    </div>
  </div>
</AdminLayout>

<!-- Modal generar código rápido -->
{canManage && (
  <div id="codigo-modal" class="modal-overlay" hidden>
    <div class="modal-box">
      <h2>Generar código</h2>
      <p id="codigo-modal-card" class="modal-card-label"></p>
      <form id="codigo-form">
        <input type="hidden" id="codigo-card-id" />
        <div class="form-row">
          <label>Cantidad de códigos *</label>
          <input name="cantidad" type="number" min="1" max="500" value="1" required />
          <span class="hint">Para el código del día, genera 1 con muchos usos.</span>
        </div>
        <div class="form-row">
          <label>Usos máximos</label>
          <input name="max_usos" type="number" min="1" value="500" />
        </div>
        <div class="form-row">
          <label>Fecha de expiración</label>
          <input name="expira_en" type="datetime-local" />
        </div>
        <div id="codigo-form-error" class="form-error" hidden></div>
        <div class="form-actions">
          <button type="button" id="btn-close-codigo" class="btn-ghost">Cancelar</button>
          <button type="submit" class="btn-primary">Generar</button>
        </div>
      </form>
      <div id="codigo-result" hidden>
        <p class="gen-success">✅ Código(s) generado(s):</p>
        <textarea id="codigo-output" readonly rows="5" class="codes-output"></textarea>
        <div class="form-actions">
          <button id="btn-copy-codigo" class="btn-primary">Copiar</button>
          <button id="btn-close-codigo2" class="btn-ghost">Cerrar</button>
        </div>
      </div>
    </div>
  </div>
)}

<script>
  // ---- Modal generar código rápido ----
  const codigoModal = document.getElementById('codigo-modal') as HTMLDivElement | null
  const codigoForm = document.getElementById('codigo-form') as HTMLFormElement | null
  const codigoCardId = document.getElementById('codigo-card-id') as HTMLInputElement | null
  const codigoCardLabel = document.getElementById('codigo-modal-card') as HTMLParagraphElement | null
  const codigoResult = document.getElementById('codigo-result') as HTMLDivElement | null
  const codigoOutput = document.getElementById('codigo-output') as HTMLTextAreaElement | null
  const codigoError = document.getElementById('codigo-form-error') as HTMLDivElement | null

  const closeCodigoModal = () => {
    codigoModal?.setAttribute('hidden', '')
    codigoForm?.reset()
    codigoForm?.removeAttribute('hidden')
    codigoResult?.setAttribute('hidden', '')
    if (codigoError) codigoError.hidden = true
  }

  document.getElementById('btn-close-codigo')?.addEventListener('click', closeCodigoModal)
  document.getElementById('btn-close-codigo2')?.addEventListener('click', closeCodigoModal)
  codigoModal?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).classList.contains('modal-overlay')) closeCodigoModal()
  })

  document.querySelectorAll('.btn-gen-codigo').forEach(btn => {
    btn.addEventListener('click', () => {
      const el = btn as HTMLButtonElement
      if (codigoCardId) codigoCardId.value = el.dataset.id ?? ''
      if (codigoCardLabel) codigoCardLabel.textContent = `#${el.dataset.posicion} — ${el.dataset.name}`
      closeCodigoModal()
      codigoModal?.removeAttribute('hidden')
    })
  })

  document.getElementById('btn-copy-codigo')?.addEventListener('click', () => {
    if (!codigoOutput) return
    navigator.clipboard.writeText(codigoOutput.value)
    const btn = document.getElementById('btn-copy-codigo') as HTMLButtonElement
    btn.textContent = '✅ Copiado'
    setTimeout(() => { btn.textContent = 'Copiar' }, 2000)
  })

  codigoForm?.addEventListener('submit', async (e) => {
    e.preventDefault()
    const btn = codigoForm.querySelector('button[type=submit]') as HTMLButtonElement
    btn.disabled = true
    if (codigoError) codigoError.hidden = true

    const fd = new FormData(codigoForm)
    const body = {
      card_id: codigoCardId?.value,
      cantidad: Number(fd.get('cantidad')),
      max_usos: Number(fd.get('max_usos')) || 500,
      expira_en: (fd.get('expira_en') as string) || null,
    }

    const res = await fetch('/api/admin/codigos/generar', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    })
    const data = await res.json()

    if (!res.ok) {
      if (codigoError) { codigoError.textContent = data.error ?? 'Error'; codigoError.hidden = false }
      btn.disabled = false
      return
    }

    codigoForm.setAttribute('hidden', '')
    if (codigoOutput) codigoOutput.value = (data.codes as string[]).join('\n')
    codigoResult?.removeAttribute('hidden')
  })

  // ---- Editar álbum ----
  const btnEdit = document.getElementById('btn-edit-album')
  const btnCancel = document.getElementById('btn-cancel-edit')
  const albumView = document.getElementById('album-view')
  const albumForm = document.getElementById('album-edit-form') as HTMLFormElement | null
  const albumError = document.getElementById('album-edit-error') as HTMLDivElement | null

  document.getElementById('btn-delete-album')?.addEventListener('click', async () => {
    const btn = document.getElementById('btn-delete-album') as HTMLButtonElement
    if (!confirm(`¿Eliminar el álbum "${btn.dataset.name}"? Se eliminarán también todas sus cards y códigos. Esta acción no se puede deshacer.`)) return
    btn.disabled = true
    btn.textContent = 'Eliminando...'
    const res = await fetch(`/api/admin/albums/${btn.dataset.id}`, { method: 'DELETE' })
    if (res.ok) {
      window.location.href = '/admin/albums'
    } else {
      const data = await res.json()
      alert(data.error ?? 'Error al eliminar')
      btn.disabled = false
      btn.textContent = 'Eliminar'
    }
  })

  btnEdit?.addEventListener('click', () => {
    albumView?.setAttribute('hidden', '')
    albumForm?.removeAttribute('hidden')
  })

  btnCancel?.addEventListener('click', () => {
    albumForm?.setAttribute('hidden', '')
    albumView?.removeAttribute('hidden')
  })

  // Sincronizar color pickers ↔ campos hex
  if (albumForm) {
    const syncPicker = (pickerName: string, hexName: string) => {
      const picker = albumForm.querySelector(`[name=${pickerName}]`) as HTMLInputElement
      const hex = albumForm.querySelector(`[name=${hexName}]`) as HTMLInputElement
      picker?.addEventListener('input', () => { if (hex) hex.value = picker.value })
      hex?.addEventListener('input', () => {
        if (/^#[0-9a-fA-F]{6}$/.test(hex.value)) picker.value = hex.value
      })
    }
    syncPicker('color_acento', 'color_acento_hex')
    syncPicker('color_acento2', 'color_acento2_hex')
    syncPicker('color_texto', 'color_texto_hex')
    syncPicker('color_header', 'color_header_hex')
    syncPicker('color_texto_header', 'color_texto_header_hex')
    syncPicker('color_body', 'color_body_hex')
    syncPicker('color_texto_body', 'color_texto_body_hex')
    syncPicker('color_fondo_card', 'color_fondo_card_hex')
    syncPicker('color_texto_card', 'color_texto_card_hex')
  }

  albumForm?.addEventListener('submit', async (e) => {
    e.preventDefault()
    const btn = albumForm.querySelector('button[type=submit]') as HTMLButtonElement
    btn.disabled = true
    if (albumError) albumError.hidden = true

    const albumId = albumForm.dataset.id
    const fd = new FormData(albumForm)

    const getColor = (hexName: string, pickerName: string) => {
      const hex = (albumForm.querySelector(`[name=${hexName}]`) as HTMLInputElement)?.value.trim()
      const picker = (albumForm.querySelector(`[name=${pickerName}]`) as HTMLInputElement)?.value
      return hex || picker || null
    }

    const body = {
      name: fd.get('name'),
      slug: fd.get('slug'),
      descripcion: fd.get('descripcion') || null,
      cover_url: fd.get('cover_url') || null,
      estacion: fd.get('estacion') || null,
      color_acento: getColor('color_acento_hex', 'color_acento'),
      color_acento2: getColor('color_acento2_hex', 'color_acento2'),
      color_texto: getColor('color_texto_hex', 'color_texto'),
      color_header: getColor('color_header_hex', 'color_header'),
      color_body: getColor('color_body_hex', 'color_body'),
      color_fondo_card: getColor('color_fondo_card_hex', 'color_fondo_card'),
      color_texto_card: getColor('color_texto_card_hex', 'color_texto_card'),
      color_texto_header: getColor('color_texto_header_hex', 'color_texto_header'),
      color_texto_body: getColor('color_texto_body_hex', 'color_texto_body'),
      logo_url: fd.get('logo_url') || null,
      total_cards: fd.get('total_cards') ? parseInt(fd.get('total_cards') as string) : null,
      active: (albumForm.querySelector('[name=active]') as HTMLInputElement)?.checked,
      banner_patrocinador_url: fd.get('banner_patrocinador_url') || null,
    }

    const res = await fetch(`/api/admin/albums/${albumId}`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    })

    if (!res.ok) {
      const data = await res.json()
      if (albumError) { albumError.textContent = data.error; albumError.hidden = false }
      btn.disabled = false
      return
    }

    window.location.reload()
  })

  // ---- Figuritas ----
  const btnAddCard = document.getElementById('btn-add-card')
  const btnCancelCard = document.getElementById('btn-cancel-card')
  const cardForm = document.getElementById('card-form') as HTMLFormElement | null
  const cardError = document.getElementById('card-form-error') as HTMLDivElement | null

  // ---- Upload de imagen ----
  const fileInput = document.getElementById('file-input') as HTMLInputElement
  const imgPreview = document.getElementById('img-preview') as HTMLImageElement
  const uploadLabel = document.getElementById('upload-label') as HTMLLabelElement
  const uploadText = document.getElementById('upload-text') as HTMLSpanElement
  const uploadStatus = document.getElementById('upload-status') as HTMLDivElement
  const cardImageInput = document.getElementById('card_image') as HTMLInputElement

  fileInput?.addEventListener('change', async () => {
    const file = fileInput.files?.[0]
    if (!file) return

    // Preview local inmediato
    imgPreview.src = URL.createObjectURL(file)
    imgPreview.hidden = false
    uploadText.textContent = file.name
    uploadStatus.hidden = false
    uploadStatus.className = 'upload-status uploading'
    uploadStatus.textContent = 'Subiendo...'

    const fd = new FormData()
    fd.append('file', file)

    try {
      const res = await fetch('/api/admin/upload', { method: 'POST', body: fd })
      const data = await res.json()
      if (!res.ok) throw new Error(data.error)

      cardImageInput.value = data.url
      uploadStatus.className = 'upload-status success'
      uploadStatus.textContent = '✅ Imagen subida correctamente'
    } catch (err: any) {
      uploadStatus.className = 'upload-status error'
      uploadStatus.textContent = `❌ ${err.message ?? 'Error al subir'}`
      imgPreview.hidden = true
      uploadText.textContent = 'Seleccionar imagen'
    }
  })

  // ---- Upload banner patrocinador ----
  const bannerFileInput = document.getElementById('banner-file-input') as HTMLInputElement
  const bannerImgPreview = document.getElementById('banner-img-preview') as HTMLImageElement
  const bannerUploadLabel = document.getElementById('banner-upload-label') as HTMLLabelElement
  const bannerChangeBtn = document.getElementById('banner-change-btn') as HTMLButtonElement
  const bannerUrlInput = document.getElementById('banner_patrocinador_url') as HTMLInputElement

  bannerChangeBtn?.addEventListener('click', () => bannerFileInput?.click())

  bannerFileInput?.addEventListener('change', async () => {
    const file = bannerFileInput.files?.[0]
    if (!file) return

    bannerImgPreview.src = URL.createObjectURL(file)
    bannerImgPreview.style.display = ''
    if (bannerUploadLabel) bannerUploadLabel.style.display = 'none'
    if (bannerChangeBtn) bannerChangeBtn.style.display = ''

    const fd = new FormData()
    fd.append('file', file)

    try {
      const res = await fetch('/api/admin/upload', { method: 'POST', body: fd })
      const data = await res.json()
      if (!res.ok) throw new Error(data.error)
      bannerUrlInput.value = data.url
    } catch (err: any) {
      alert(`Error al subir banner: ${err.message ?? 'Error desconocido'}`)
      bannerImgPreview.style.display = 'none'
      if (bannerUploadLabel) bannerUploadLabel.style.display = ''
    }
  })

  // Si el usuario pega una URL manualmente, actualizar el preview
  bannerUrlInput?.addEventListener('change', () => {
    const url = bannerUrlInput.value.trim()
    if (url) {
      bannerImgPreview.src = url
      bannerImgPreview.style.display = ''
      if (bannerUploadLabel) bannerUploadLabel.style.display = 'none'
      if (bannerChangeBtn) bannerChangeBtn.style.display = ''
    } else {
      bannerImgPreview.style.display = 'none'
      if (bannerUploadLabel) bannerUploadLabel.style.display = ''
      if (bannerChangeBtn) bannerChangeBtn.style.display = 'none'
    }
  })

  function resetUploadArea() {
    if (fileInput) fileInput.value = ''
    if (imgPreview) { imgPreview.src = ''; imgPreview.hidden = true }
    if (uploadText) uploadText.textContent = 'Seleccionar imagen'
    if (uploadStatus) uploadStatus.hidden = true
  }

  btnAddCard?.addEventListener('click', () => {
    cardForm?.reset()
    resetUploadArea()
    ;(document.getElementById('card_id_hidden') as HTMLInputElement).value = ''
    ;(document.getElementById('btn-save-card') as HTMLButtonElement).textContent = 'Guardar card'
    cardForm?.removeAttribute('hidden')
    cardForm?.scrollIntoView({ behavior: 'smooth', block: 'nearest' })
  })

  btnCancelCard?.addEventListener('click', () => {
    cardForm?.setAttribute('hidden', '')
    resetUploadArea()
  })

  document.querySelectorAll('.btn-edit-card').forEach(btn => {
    btn.addEventListener('click', () => {
      const el = btn as HTMLButtonElement
      ;(document.getElementById('card_id_hidden') as HTMLInputElement).value = el.dataset.id ?? ''
      ;(document.getElementById('posicion') as HTMLInputElement).value = el.dataset.posicion ?? ''
      ;(document.getElementById('card_name') as HTMLInputElement).value = el.dataset.name ?? ''
      ;(document.getElementById('card_desc') as HTMLTextAreaElement).value = el.dataset.desc ?? ''

      // Mostrar imagen actual si existe
      const existingImage = el.dataset.image ?? ''
      cardImageInput.value = existingImage
      if (existingImage) {
        imgPreview.src = existingImage
        imgPreview.hidden = false
        uploadText.textContent = 'Cambiar imagen'
      } else {
        resetUploadArea()
      }

      ;(document.getElementById('btn-save-card') as HTMLButtonElement).textContent = 'Actualizar card'
      cardForm?.removeAttribute('hidden')
      cardForm?.scrollIntoView({ behavior: 'smooth', block: 'nearest' })
    })
  })

  document.querySelectorAll('.btn-delete-card').forEach(btn => {
    btn.addEventListener('click', async () => {
      const el = btn as HTMLButtonElement
      if (!confirm(`¿Eliminar la card "${el.dataset.name}"? Esta acción no se puede deshacer.`)) return
      el.disabled = true
      const res = await fetch(`/api/admin/cards/${el.dataset.id}`, { method: 'DELETE' })
      if (res.ok) {
        el.closest('tr')?.remove()
      } else {
        const data = await res.json()
        alert(data.error ?? 'Error al eliminar')
        el.disabled = false
      }
    })
  })

  cardForm?.addEventListener('submit', async (e) => {
    e.preventDefault()
    const btn = document.getElementById('btn-save-card') as HTMLButtonElement
    btn.disabled = true
    if (cardError) cardError.hidden = true

    const albumId = cardForm.dataset.album
    const cardId = (document.getElementById('card_id_hidden') as HTMLInputElement).value
    const fd = new FormData(cardForm)
    const body = {
      album_id: albumId,
      posicion: Number(fd.get('posicion')),
      name: fd.get('name'),
      descripcion: fd.get('descripcion') || null,
      image_url: fd.get('image_url') || null,
    }

    const isEdit = !!cardId
    const url = isEdit ? `/api/admin/cards/${cardId}` : '/api/admin/cards'
    const method = isEdit ? 'PATCH' : 'POST'

    const res = await fetch(url, {
      method,
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    })

    if (!res.ok) {
      const data = await res.json()
      if (cardError) { cardError.textContent = data.error; cardError.hidden = false }
      btn.disabled = false
      return
    }

    window.location.reload()
  })

</script>

