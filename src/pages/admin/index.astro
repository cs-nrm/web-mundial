---
import AdminLayout from '../../layouts/AdminLayout.astro'
import { createSupabaseServerClient } from '../../lib/supabase'

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies)

const [
  { count: totalUsers },
  { count: totalCards },
  { count: totalCodes },
  { count: usosHoy },
  { data: albumStats },
] = await Promise.all([
  supabase.from('profiles').select('*', { count: 'exact', head: true }),
  supabase.from('user_cards').select('*', { count: 'exact', head: true }),
  supabase.from('codes').select('*', { count: 'exact', head: true }).eq('active', true),
  supabase.from('user_cards').select('*', { count: 'exact', head: true })
    .gte('redeemed_at', new Date(new Date().setHours(0,0,0,0)).toISOString()),
  supabase.from('albums').select('id, name, slug').eq('active', true),
])

// Top 5 figuritas más canjeadas — paginamos para no quedar truncados en 1000
let allUcOffset = 0
const allUcRaw: Array<{ card_id: string }> = []
while (true) {
  const { data, error } = await supabase
    .from('user_cards')
    .select('card_id')
    .range(allUcOffset, allUcOffset + 999)
  if (error || !data || data.length === 0) break
  allUcRaw.push(...data)
  if (data.length < 1000) break
  allUcOffset += 1000
}

const cardCountMap: Record<string, number> = {}
for (const uc of allUcRaw) {
  cardCountMap[uc.card_id] = (cardCountMap[uc.card_id] ?? 0) + 1
}
const top5Ids = Object.entries(cardCountMap)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 5)
  .map(([id]) => id)

const { data: top5Cards } = top5Ids.length
  ? await supabase.from('cards').select('id, name, albums(name)').in('id', top5Ids)
  : { data: [] }

const topFiguritas = top5Ids.map(id => {
  const card = (top5Cards ?? []).find((c: any) => c.id === id)
  return {
    name: card?.name ?? '?',
    album: (card?.albums as any)?.name ?? '?',
    count: cardCountMap[id],
  }
})
---

<AdminLayout title="Dashboard">
  <div class="stats-grid">
    <div class="stat-card">
      <span class="stat-icon">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
      </span>
      <div>
        <p class="stat-value">{totalUsers ?? 0}</p>
        <p class="stat-label">Usuarios registrados</p>
      </div>
    </div>
    <div class="stat-card">
      <span class="stat-icon">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 14H4V6h16v12zM6 10h2v2H6zm0 4h8v2H6zm10 0h2v2h-2zm-6-4h8v2h-8z"/></svg>
      </span>
      <div>
        <p class="stat-value">{totalCards ?? 0}</p>
        <p class="stat-label">Cards canjeadas</p>
      </div>
    </div>
    <div class="stat-card">
      <span class="stat-icon">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M22 10V6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v4c1.1 0 2 .9 2 2s-.9 2-2 2v4c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2v-4c-1.1 0-2-.9-2-2s.9-2 2-2zm-2-1.46c-1.19.69-2 1.99-2 3.46s.81 2.77 2 3.46V18H4v-2.54c1.19-.69 2-1.99 2-3.46 0-1.48-.8-2.77-2-3.46V6h16v2.54z"/></svg>
      </span>
      <div>
        <p class="stat-value">{totalCodes ?? 0}</p>
        <p class="stat-label">Códigos activos</p>
      </div>
    </div>
    <div class="stat-card accent">
      <span class="stat-icon">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 0.67s.74 2.65.74 4.8c0 2.06-1.35 3.73-3.41 3.73-2.07 0-3.63-1.67-3.63-3.73l.03-.36C5.21 7.51 4 10.62 4 14c0 4.42 3.58 8 8 8s8-3.58 8-8C20 8.61 17.41 3.8 13.5.67zM11.71 19c-1.78 0-3.22-1.4-3.22-3.14 0-1.62 1.05-2.76 2.81-3.12 1.77-.36 3.6-1.21 4.62-2.58.39 1.29.59 2.65.59 4.04 0 2.65-2.15 4.8-4.8 4.8z"/></svg>
      </span>
      <div>
        <p class="stat-value">{usosHoy ?? 0}</p>
        <p class="stat-label">Canjes hoy</p>
      </div>
    </div>
  </div>

  <div class="dashboard-grid">
    <div class="panel">
      <h2>Álbumes activos</h2>
      {(!albumStats || albumStats.length === 0) ? (
        <p class="empty">No hay álbumes activos.</p>
      ) : (
        <ul class="album-list">
          {albumStats.map((a: any) => (
            <li>
              <a href={`/admin/albums/${a.id}`}>{a.name}</a>
              <a href={`/album/${a.slug}`} target="_blank" class="view-link">Ver →</a>
            </li>
          ))}
        </ul>
      )}
      <a href="/admin/albums/new" class="btn-sm">+ Nuevo álbum</a>
    </div>

    <div class="panel">
      <h2>Cards más canjeadas</h2>
      {topFiguritas.length === 0 ? (
        <p class="empty">Sin datos todavía.</p>
      ) : (
        <table class="mini-table">
          <thead>
            <tr><th>Card</th><th>Álbum</th><th>Canjes</th></tr>
          </thead>
          <tbody>
            {topFiguritas.map(f => (
              <tr>
                <td>{f.name}</td>
                <td class="muted">{f.album}</td>
                <td class="count">{f.count}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </div>
  </div>
</AdminLayout>

<style>
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .stat-card {
    background: white;
    border-radius: 0.75rem;
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    box-shadow: 0 1px 4px rgba(0,0,0,0.06);
  }

  .stat-card.accent { border-left: 4px solid var(--rojo); }

  .stat-icon { display:flex; align-items:center; color: #d1d5db; }
  .stat-icon svg { width: 2rem; height: 2rem; }
  .stat-card.accent .stat-icon { color: var(--rojo); }

  .stat-value {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--morado);
    line-height: 1;
  }

  .stat-label {
    font-size: 0.8rem;
    color: #888;
    margin-top: 0.2rem;
  }

  .dashboard-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.5rem;
  }

  .panel {
    background: white;
    border-radius: 0.75rem;
    padding: 1.5rem;
    box-shadow: 0 1px 4px rgba(0,0,0,0.06);
  }

  .panel h2 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--morado);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid #f0f0f0;
  }

  .album-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .album-list li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.9rem;
  }

  .album-list a { text-decoration: none; color: var(--morado); font-weight: 600; }
  .album-list a:hover { text-decoration: underline; }

  .view-link { font-size: 0.8rem; color: #888 !important; font-weight: 400 !important; }

  .btn-sm {
    display: inline-block;
    background: var(--rojo);
    color: white;
    padding: 0.4rem 0.9rem;
    border-radius: 0.4rem;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .btn-sm:hover { opacity: 0.85; }

  .mini-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .mini-table th {
    text-align: left;
    font-size: 0.75rem;
    text-transform: uppercase;
    color: #999;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #f0f0f0;
  }

  .mini-table td {
    padding: 0.5rem 0;
    border-bottom: 1px solid #f9f9f9;
  }

  .mini-table .muted { color: #888; }
  .mini-table .count { font-weight: 700; color: var(--rojo); text-align: right; }

  .empty { color: #aaa; font-size: 0.875rem; }
</style>
