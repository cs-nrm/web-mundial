  .empty { color: #bbb; font-size: 0.875rem; }

  /* Est desglose bars */
  .est-bars { display: flex; flex-direction: column; gap: 0.75rem; }
  .est-bar-row { display: flex; align-items: center; gap: 0.75rem; }
  .est-bar-label { width: 80px; font-size: 0.8rem; font-weight: 700; flex-shrink: 0; }
  .est-bar-track { flex: 1; height: 10px; background: #f3f4f6; border-radius: 999px; overflow: hidden; }
