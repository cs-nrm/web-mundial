    padding: 0.65rem 1.5rem; font-size: 0.9rem; font-weight: 600;
    text-decoration: none; color: #6b7280; border-bottom: 2px solid transparent;
    margin-bottom: -2px; transition: color 0.15s, border-color 0.15s;
  }
  .tab-btn:hover { color: #374151; }
  .tab-btn.active { color: var(--rojo); border-bottom-color: var(--rojo); }

  /* Estación pills */
  .estacion-bar { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 1.5rem; }
  .est-pill {
    padding: 0.35rem 0.9rem; border-radius: 999px; font-size: 0.8rem; font-weight: 600;
    text-decoration: none; border: 2px solid #e5e7eb; color: #6b7280;
    transition: all 0.15s;
