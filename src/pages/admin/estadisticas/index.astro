---
import AdminLayout from '../../../layouts/AdminLayout.astro'
import { createSupabaseAdminClient } from '../../../lib/supabase'
import { canAccess, STATS_ROLES } from '../../../lib/admin'
import type { UserRole } from '../../../lib/perfil'

const { role } = Astro.locals
if (!canAccess(role as UserRole, STATS_ROLES)) return Astro.redirect('/admin')

const supabase = createSupabaseAdminClient()

const tab = Astro.url.searchParams.get('tab') ?? 'album'
const estacion = Astro.url.searchParams.get('estacion') ?? 'todas'
const albumFilter = Astro.url.searchParams.get('album_id') ?? ''
const ESTACIONES = ['oye', 'beat', 'stereocien', 'sabrosita'] as const

const estacionColors: Record<string, string> = {
  oye: '#e2241a', beat: '#ffaa1f', stereocien: '#012169', sabrosita: '#f2510a',
}

// ─── TAB: ÁLBUM ───────────────────────────────────────────────────────────────
let albumData: any = {}

if (tab === 'album') {
  // Álbumes de la estación
  let aQ = supabase.from('albums').select('id, name')
  if (estacion !== 'todas') aQ = aQ.eq('estacion', estacion)
  const { data: albums } = await aQ
  const albumIds = albums?.map(a => a.id) ?? []

  // Cards de esos álbumes
  const { data: cards } = albumIds.length
    ? await supabase.from('cards').select('id, name, posicion, album_id').in('album_id', albumIds)
    : { data: [] }
  const cardIds = (cards ?? []).map(c => c.id)

  // user_cards de esas cards
  const { data: userCards } = cardIds.length
    ? await supabase.from('user_cards').select('user_id, card_id, redeemed_at').in('card_id', cardIds)
    : { data: [] }
  const uc = userCards ?? []

  // KPIs
  const totalCanjes = uc.length
  const usuariosActivos = new Set(uc.map(r => r.user_id)).size

  // Canjes por día (últimos 30 días)
  const desde = new Date(); desde.setDate(desde.getDate() - 29); desde.setHours(0,0,0,0)
  const diaMap: Record<string, number> = {}
  for (let i = 0; i < 30; i++) {
    const d = new Date(desde); d.setDate(d.getDate() + i)
    diaMap[d.toISOString().slice(0, 10)] = 0
  }
  for (const r of uc) {
    const dia = r.redeemed_at?.slice(0, 10)
    if (dia && diaMap[dia] !== undefined) diaMap[dia]++
  }

  // Top figuritas
  const cardMap: Record<string, { name: string; album: string; count: number }> = {}
  const cardAlbumName: Record<string, string> = {}
  for (const c of (cards ?? [])) {
    cardAlbumName[c.id] = albums?.find(a => a.id === c.album_id)?.name ?? '?'
  }
  for (const r of uc) {
    if (!cardMap[r.card_id]) {
      const card = (cards ?? []).find(c => c.id === r.card_id)
      cardMap[r.card_id] = { name: card?.name ?? '?', album: cardAlbumName[r.card_id] ?? '?', count: 0 }
    }
    cardMap[r.card_id].count++
  }
  const topCards = Object.values(cardMap).sort((a, b) => b.count - a.count).slice(0, 10)

  // Top usuarios
  const userCountMap: Record<string, number> = {}
  for (const r of uc) userCountMap[r.user_id] = (userCountMap[r.user_id] ?? 0) + 1
  const topUserIds = Object.entries(userCountMap).sort((a, b) => b[1] - a[1]).slice(0, 10)
  const { data: topProfiles } = topUserIds.length
    ? await supabase.from('profiles').select('id, email, full_name').in('id', topUserIds.map(([id]) => id))
    : { data: [] }
  const topUsers = topUserIds.map(([id, count]) => {
    const p = (topProfiles ?? []).find(p => p.id === id)
    return { name: p?.full_name ?? 'Anónimo', email: p?.email ?? '', count }
  })

  const diasData = Object.entries(diaMap)
  const maxBar = Math.max(...diasData.map(([, v]) => v), 1)

  // ── Participantes ──
  const cardAlbumId: Record<string, string> = {}
  const totalActivePerAlbum: Record<string, number> = {}
  for (const c of (cards ?? [])) {
    cardAlbumId[(c as any).id] = (c as any).album_id
    totalActivePerAlbum[(c as any).album_id] = (totalActivePerAlbum[(c as any).album_id] ?? 0) + 1
  }
  type UEntry = { count: number; firstAt: string; lastAt: string }
  const uAgg: Record<string, Record<string, UEntry>> = {}
  for (const r of uc) {
    const alb = cardAlbumId[r.card_id]
    if (!alb) continue
    if (!uAgg[r.user_id]) uAgg[r.user_id] = {}
    const slot = uAgg[r.user_id][alb]
    if (!slot) { uAgg[r.user_id][alb] = { count: 1, firstAt: r.redeemed_at, lastAt: r.redeemed_at } }
    else { slot.count++; if (r.redeemed_at < slot.firstAt) slot.firstAt = r.redeemed_at; if (r.redeemed_at > slot.lastAt) slot.lastAt = r.redeemed_at }
  }
  const allUids = Object.keys(uAgg)
  const { data: allProfs } = allUids.length
    ? await supabase.from('profiles').select('id, email, full_name').in('id', allUids)
    : { data: [] }
  const participantes: any[] = []
  for (const [uid, albumEntries] of Object.entries(uAgg)) {
    const prof = (allProfs ?? []).find((p: any) => p.id === uid) as any
    for (const [albId, entry] of Object.entries(albumEntries)) {
      const alb = (albums ?? []).find((a: any) => a.id === albId) as any
      const total = totalActivePerAlbum[albId] ?? 60
      const pct = total > 0 ? Math.round((entry.count / total) * 100) : 0
      participantes.push({ name: prof?.full_name ?? 'Anónimo', email: prof?.email ?? '', albumName: alb?.name ?? '?', count: entry.count, total, pct, firstAt: entry.firstAt, lastAt: entry.lastAt })
    }
  }
  participantes.sort((a, b) => b.pct - a.pct || b.count - a.count)

  // ── Detalle por carta ──
  const cardRedemptions: any[] = []
  for (const r of uc) {
    const card = (cards ?? []).find((c: any) => c.id === r.card_id) as any
    const prof = (allProfs ?? []).find((p: any) => p.id === r.user_id) as any
    const alb = (albums ?? []).find((a: any) => a.id === card?.album_id) as any
    cardRedemptions.push({ posicion: card?.posicion ?? 0, cardName: card?.name ?? '?', albumName: alb?.name ?? '?', userName: prof?.full_name ?? 'Anónimo', userEmail: prof?.email ?? '', redeemedAt: r.redeemed_at })
  }
  cardRedemptions.sort((a, b) => a.posicion - b.posicion || a.redeemedAt?.localeCompare(b.redeemedAt))

  albumData = { totalCanjes, usuariosActivos, diasData, topCards, topUsers, maxBar, participantes, cardRedemptions }
}

// ─── TAB: PLAYLIST ────────────────────────────────────────────────────────────
let playlistData: any = {}

if (tab === 'playlist') {
  // Canciones del catálogo (por estación)
  let sQ = supabase.from('songs_catalog').select('id, artist, title, estacion').eq('activo', true)
  if (estacion !== 'todas') sQ = sQ.eq('estacion', estacion)
  const { data: songs } = await sQ
  const songIds = (songs ?? []).map(s => s.id)

  // playlist_songs con esas canciones
  const { data: psData } = songIds.length
    ? await supabase.from('playlist_songs').select('playlist_id, song_id, created_at').in('song_id', songIds)
    : { data: [] }
  const ps = psData ?? []

  // KPIs
  const totalAgregadas = ps.length
  const playlistsUnicas = new Set(ps.map(r => r.playlist_id)).size

  // Total playlists creadas (global si todas, o con canciones de esa estación)
  const { count: totalPlaylists } = await supabase
    .from('playlists').select('*', { count: 'exact', head: true })

  // Playlists creadas por día (últimos 30 días)
  const desde = new Date(); desde.setDate(desde.getDate() - 29); desde.setHours(0,0,0,0)
  const diaMap: Record<string, number> = {}
  for (let i = 0; i < 30; i++) {
    const d = new Date(desde); d.setDate(d.getDate() + i)
    diaMap[d.toISOString().slice(0, 10)] = 0
  }
  for (const r of ps) {
    const dia = r.created_at?.slice(0, 10)
    if (dia && diaMap[dia] !== undefined) diaMap[dia]++
  }

  // Top canciones más agregadas
  const songCountMap: Record<string, number> = {}
  for (const r of ps) songCountMap[r.song_id] = (songCountMap[r.song_id] ?? 0) + 1
  const topSongs = Object.entries(songCountMap)
    .sort((a, b) => b[1] - a[1])
    .slice(0, 10)
    .map(([id, count]) => {
      const s = (songs ?? []).find(s => s.id === id)
      return { artist: s?.artist ?? '?', title: s?.title ?? '?', estacion: s?.estacion ?? '', count }
    })

  // Canciones por estación en playlists (para el desglose)
  const porEstacion: Record<string, number> = {}
  for (const r of ps) {
    const s = (songs ?? []).find(s => s.id === r.song_id)
    if (s?.estacion) porEstacion[s.estacion] = (porEstacion[s.estacion] ?? 0) + 1
  }

  const diasData = Object.entries(diaMap)
  const maxBar = Math.max(...diasData.map(([, v]) => v), 1)
  playlistData = { totalPlaylists, totalAgregadas, playlistsUnicas, diasData, topSongs, porEstacion, maxBar }
}

// ─── TAB: AVATAR ─────────────────────────────────────────────────────────────
let avatarData: any = {}

if (tab === 'avatar') {
  const { data: avProfiles, count: totalRegistrados } = await supabase
    .from('profiles')
    .select('id, full_name, avatar_config, estacion_favorita, updated_at', { count: 'exact' })
    .not('avatar_config', 'is', null)

  const perfiles = avProfiles ?? []

  // Total usuarios registrados para calcular %
  const { count: totalUsuarios } = await supabase
    .from('profiles').select('*', { count: 'exact', head: true })

  const pctAvatar = totalUsuarios && totalRegistrados
    ? Math.round((totalRegistrados / totalUsuarios) * 100)
    : 0

  // Distribución por estación
  const porEstacion: Record<string, number> = {}
  for (const p of perfiles) {
    const e = p.estacion_favorita ?? 'desconocida'
    porEstacion[e] = (porEstacion[e] ?? 0) + 1
  }

  // Piezas más usadas por categoría
  const Z_ORDER = ['fondo','cuerpo-jersey','cabello','cejas','ojos','lentes','boca','bigote','barba','gorra','marco']
  const CAT_LABELS: Record<string, string> = {
    fondo:'Fondo','cuerpo-jersey':'Jersey',cabello:'Cabello',cejas:'Cejas',
    ojos:'Ojos',lentes:'Lentes',boca:'Boca',bigote:'Bigote',barba:'Barba',gorra:'Gorra',marco:'Marco',
  }
  const catStats: Record<string, Array<{ path: string; count: number }>> = {}
  for (const cat of Z_ORDER) catStats[cat] = []

  const catCountMap: Record<string, Record<string, number>> = {}
  for (const p of perfiles) {
    const cfg = p.avatar_config
    if (!cfg || typeof cfg !== 'object') continue
    for (const cat of Z_ORDER) {
      const val = cfg[cat]
      if (!val) continue
      if (!catCountMap[cat]) catCountMap[cat] = {}
      catCountMap[cat][val] = (catCountMap[cat][val] ?? 0) + 1
    }
  }
  for (const cat of Z_ORDER) {
    catStats[cat] = Object.entries(catCountMap[cat] ?? {})
      .sort((a, b) => b[1] - a[1])
      .slice(0, 5)
      .map(([path, count]) => ({ path, count }))
  }

  // Últimas 10 creaciones
  const recientes = [...perfiles]
    .sort((a, b) => (b.updated_at ?? '').localeCompare(a.updated_at ?? ''))
    .slice(0, 10)
    .map(p => ({ name: p.full_name ?? 'Anónimo', estacion: p.estacion_favorita ?? '?', at: p.updated_at }))

  avatarData = { totalAvatares: totalRegistrados ?? 0, totalUsuarios: totalUsuarios ?? 0, pctAvatar, porEstacion, catStats, CAT_LABELS, Z_ORDER, recientes }
}

// ─── TAB: PUBLICIDAD ──────────────────────────────────────────────────────────
let pubData: any = {}

if (tab === 'publicidad') {
  const since30 = new Date(Date.now() - 30 * 24 * 60 * 60 * 1000).toISOString()

  const [{ data: clients }, { data: imps }, { data: clks }] = await Promise.all([
    supabase.from('ad_clients').select('id, name, active').order('created_at'),
    supabase.from('ad_impressions').select('client_id, slot_type, created_at').gte('created_at', since30),
    supabase.from('ad_clicks').select('client_id, slot_type, created_at').gte('created_at', since30),
  ])

  const impTotal = (imps ?? []).length
  const clkTotal = (clks ?? []).length

  // Por cliente
  const perClient = (clients ?? []).map(c => {
    const ci = (imps ?? []).filter(r => r.client_id === c.id).length
    const cc = (clks ?? []).filter(r => r.client_id === c.id).length
    return { ...c, impressions: ci, clicks: cc, ctr: ci > 0 ? ((cc / ci) * 100).toFixed(1) + '%' : '—' }
  }).sort((a, b) => b.impressions - a.impressions)

  // Por slot_type
  const slotMap: Record<string, { impressions: number; clicks: number }> = {}
  for (const r of (imps ?? [])) {
    const k = r.slot_type ?? 'desconocido'
    if (!slotMap[k]) slotMap[k] = { impressions: 0, clicks: 0 }
    slotMap[k].impressions++
  }
  for (const r of (clks ?? [])) {
    const k = r.slot_type ?? 'desconocido'
    if (!slotMap[k]) slotMap[k] = { impressions: 0, clicks: 0 }
    slotMap[k].clicks++
  }
  const perSlot = Object.entries(slotMap).sort((a, b) => b[1].impressions - a[1].impressions)

  // Impresiones por día (últimos 30 días)
  const desde = new Date(); desde.setDate(desde.getDate() - 29); desde.setHours(0,0,0,0)
  const diaMap: Record<string, number> = {}
  for (let i = 0; i < 30; i++) {
    const d = new Date(desde); d.setDate(d.getDate() + i)
    diaMap[d.toISOString().slice(0, 10)] = 0
  }
  for (const r of (imps ?? [])) {
    const dia = r.created_at?.slice(0, 10)
    if (dia && diaMap[dia] !== undefined) diaMap[dia]++
  }
  const diasData = Object.entries(diaMap)
  const maxBar = Math.max(...diasData.map(([, v]) => v), 1)

  pubData = { impTotal, clkTotal, ctr: impTotal > 0 ? ((clkTotal / impTotal) * 100).toFixed(1) + '%' : '—', perClient, perSlot, diasData, maxBar }
}

function fmtDate(iso: string | null) {
  if (!iso) return '—'
  const d = new Date(iso)
  return `${String(d.getDate()).padStart(2,'0')}/${String(d.getMonth()+1).padStart(2,'0')} ${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`
}
function tabUrl(t: string) { return `?tab=${t}&estacion=${estacion}` }
function estUrl(e: string) { return `?tab=${tab}&estacion=${e}` }
function progresoUrl(id: string) { return `?tab=progreso&album_id=${id}` }
---

<AdminLayout title="Estadísticas">

  <!-- Tabs principales -->
  <div class="tab-bar">
    <a href={tabUrl('album')} class={`tab-btn ${tab === 'album' ? 'active' : ''}`}>Álbum</a>
    <a href={tabUrl('playlist')} class={`tab-btn ${tab === 'playlist' ? 'active' : ''}`}>Playlist</a>
    <a href={tabUrl('avatar')} class={`tab-btn ${tab === 'avatar' ? 'active' : ''}`}>Avatar</a>
    <a href="?tab=progreso" class={`tab-btn ${tab === 'progreso' ? 'active' : ''}`}>Progreso</a>
    <a href="?tab=publicidad" class={`tab-btn ${tab === 'publicidad' ? 'active' : ''}`}>Publicidad</a>
  </div>

  {tab !== 'avatar' && (
    <!-- Filtro estación -->
    <div class="estacion-bar">
      <a href={estUrl('todas')} class={`est-pill ${estacion === 'todas' ? 'active' : ''}`}>Todas</a>
      {ESTACIONES.map(e => (
        <a
          href={estUrl(e)}
          class={`est-pill ${estacion === e ? 'active' : ''}`}
          style={estacion === e ? `background:${estacionColors[e]};border-color:${estacionColors[e]};` : ''}
        >
          {e.charAt(0).toUpperCase() + e.slice(1)}
        </a>
      ))}
    </div>
  )}

  <!-- ═══ TAB ÁLBUM ════════════════════════════════════════════════════════════ -->
  {tab === 'album' && (
    <div>
      <div class="stats-row">
        <div class="stat-card">
          <div><p class="stat-val">{albumData.totalCanjes ?? 0}</p><p class="stat-lbl">Canjes totales</p></div>
        </div>
        <div class="stat-card">
          <div><p class="stat-val">{albumData.usuariosActivos ?? 0}</p><p class="stat-lbl">Usuarios activos</p></div>
        </div>
      </div>

      <div class="panel">
        <h2>Canjes últimos 30 días</h2>
        {(albumData.diasData ?? []).every(([,v]: any) => v === 0) ? (
          <p class="empty">Sin actividad en este período.</p>
        ) : (
          <div class="bar-chart">
            {(albumData.diasData ?? []).map(([dia, count]: any) => (
              <div class="bar-col">
                <span class="bar-count">{count > 0 ? count : ''}</span>
                <div class="bar-fill" style={`height: ${(count / (albumData.maxBar ?? 1)) * 100}%`}></div>
                <span class="bar-label">{dia.slice(5)}</span>
              </div>
            ))}
          </div>
        )}
      </div>

      <div class="two-col">
        <div class="panel">
          <div class="panel-hdr"><h2>Top 10 cards más canjeadas</h2><button class="btn-csv" data-filename="top-cards">⬇ CSV</button></div>
          {(albumData.topCards ?? []).length === 0 ? (
            <p class="empty">Sin datos.</p>
          ) : (
            <table class="mini-table">
              <thead><tr><th>#</th><th>Card</th><th>Álbum</th><th>Canjes</th></tr></thead>
              <tbody>
                {(albumData.topCards ?? []).map((r: any, i: number) => (
                  <tr>
                    <td class="pos">{i + 1}</td>
                    <td>{r.name}</td>
                    <td class="muted">{r.album}</td>
                    <td class="count">{r.count}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
        </div>

        <div class="panel">
          <div class="panel-hdr"><h2>Top 10 coleccionistas</h2><button class="btn-csv" data-filename="top-coleccionistas">⬇ CSV</button></div>
          {(albumData.topUsers ?? []).length === 0 ? (
            <p class="empty">Sin datos.</p>
          ) : (
            <table class="mini-table">
              <thead><tr><th>#</th><th>Usuario</th><th>Cards</th></tr></thead>
              <tbody>
                {(albumData.topUsers ?? []).map((u: any, i: number) => (
                  <tr>
                    <td class="pos">{i + 1}</td>
                    <td>
                      <span class="user-name">{u.name}</span>
                      <span class="muted block">{u.email}</span>
                    </td>
                    <td class="count">{u.count}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
        </div>
      </div>

      <!-- ── Participantes ── -->
      <div class="panel">
        <div class="panel-hdr"><h2>Participantes — progreso por álbum</h2><button class="btn-csv" data-filename="participantes">⬇ CSV</button></div>
        {(albumData.participantes ?? []).length === 0 ? (
          <p class="empty">Sin participantes aún.</p>
        ) : (
          <table class="mini-table prog-table">
            <thead><tr><th>#</th><th>Usuario</th><th>Álbum</th><th>Progreso</th><th>Cards</th><th>%</th><th>Primera carta</th><th>Última carta</th></tr></thead>
            <tbody>
              {(albumData.participantes as any[]).map((r: any, i: number) => (
                <tr class={r.pct === 100 ? 'row-complete' : ''}>
                  <td class="pos">{i + 1}</td>
                  <td><span class="user-name">{r.name}</span><span class="muted block">{r.email}</span></td>
                  <td class="muted album-cell">{r.albumName}</td>
                  <td class="prog-cell"><div class="prog-track"><div class="prog-fill" style={`width:${r.pct}%`}></div></div></td>
                  <td class="count">{r.count}<span class="muted">/{r.total}</span></td>
                  <td><span class={`pct-badge ${r.pct === 100 ? 'pct-full' : r.pct >= 50 ? 'pct-mid' : 'pct-low'}`}>{r.pct}%</span></td>
                  <td class="date-cell muted">{fmtDate(r.firstAt)}</td>
                  <td class="date-cell muted">{fmtDate(r.lastAt)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </div>

      <!-- ── Detalle por carta ── -->
      <div class="panel">
        <div class="panel-hdr"><h2>Detalle por carta — quién la redimió y cuándo</h2><button class="btn-csv" data-filename="detalle-cartas">⬇ CSV</button></div>
        {(albumData.cardRedemptions ?? []).length === 0 ? (
          <p class="empty">Sin canjes aún.</p>
        ) : (
          <table class="mini-table prog-table">
            <thead><tr><th>#</th><th>Carta</th><th>Álbum</th><th>Usuario</th><th>Hora de redención</th></tr></thead>
            <tbody>
              {(albumData.cardRedemptions as any[]).map((r: any) => (
                <tr>
                  <td class="pos">{r.posicion}</td>
                  <td class="user-name">{r.cardName}</td>
                  <td class="muted album-cell">{r.albumName}</td>
                  <td><span class="user-name">{r.userName}</span><span class="muted block">{r.userEmail}</span></td>
                  <td class="date-cell muted">{fmtDate(r.redeemedAt)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </div>
    </div>
  )}

  <!-- ═══ TAB PLAYLIST ═════════════════════════════════════════════════════════ -->
  {tab === 'playlist' && (
    <div>
      <div class="stats-row">
        <div class="stat-card">
          <div><p class="stat-val">{playlistData.totalPlaylists ?? 0}</p><p class="stat-lbl">Playlists creadas</p></div>
        </div>
        <div class="stat-card">
          <div><p class="stat-val">{playlistData.totalAgregadas ?? 0}</p><p class="stat-lbl">Canciones agregadas</p></div>
        </div>
        <div class="stat-card">
          <div><p class="stat-val">{playlistData.playlistsUnicas ?? 0}</p><p class="stat-lbl">Playlists con canciones de esta estación</p></div>
        </div>
      </div>

      <!-- Desglose por estación (solo cuando filtro = todas) -->
      {estacion === 'todas' && Object.keys(playlistData.porEstacion ?? {}).length > 0 && (
        <div class="panel">
          <h2>Canciones en playlists por estación</h2>
          <div class="est-bars">
            {ESTACIONES.map(e => {
              const count = playlistData.porEstacion?.[e] ?? 0
              const total = playlistData.totalAgregadas ?? 1
              const pct = total > 0 ? Math.round((count / total) * 100) : 0
              return (
                <div class="est-bar-row">
                  <span class="est-bar-label" style={`color:${estacionColors[e]}`}>{e.charAt(0).toUpperCase() + e.slice(1)}</span>
                  <div class="est-bar-track">
                    <div class="est-bar-fill" style={`width:${pct}%;background:${estacionColors[e]}`}></div>
                  </div>
                  <span class="est-bar-count">{count} <span class="muted">({pct}%)</span></span>
                </div>
              )
            })}
          </div>
        </div>
      )}

      <div class="panel">
        <h2>Actividad últimos 30 días</h2>
        {(playlistData.diasData ?? []).every(([,v]: any) => v === 0) ? (
          <p class="empty">Sin actividad en este período.</p>
        ) : (
          <div class="bar-chart">
            {(playlistData.diasData ?? []).map(([dia, count]: any) => (
              <div class="bar-col">
                <span class="bar-count">{count > 0 ? count : ''}</span>
                <div class="bar-fill" style={`height: ${(count / (playlistData.maxBar ?? 1)) * 100}%`}></div>
                <span class="bar-label">{dia.slice(5)}</span>
              </div>
            ))}
          </div>
        )}
      </div>

      <div class="panel">
        <div class="panel-hdr"><h2>Top 10 canciones más agregadas</h2><button class="btn-csv" data-filename="top-canciones">⬇ CSV</button></div>
        {(playlistData.topSongs ?? []).length === 0 ? (
          <p class="empty">Sin datos aún.</p>
        ) : (
          <table class="mini-table">
            <thead><tr><th>#</th><th>Artista</th><th>Título</th><th>Estación</th><th>Agregadas</th></tr></thead>
            <tbody>
              {(playlistData.topSongs ?? []).map((s: any, i: number) => (
                <tr>
                  <td class="pos">{i + 1}</td>
                  <td class="user-name">{s.artist}</td>
                  <td class="muted">{s.title}</td>
                  <td>
                    <span class="est-tag" style={`background:${estacionColors[s.estacion]}20;color:${estacionColors[s.estacion]}`}>
                      {s.estacion}
                    </span>
                  </td>
                  <td class="count">{s.count}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </div>
    </div>
  )}

  <!-- ═══ TAB AVATAR ════════════════════════════════════════════════════════════ -->
  {tab === 'avatar' && (
    <div>
      <!-- KPIs -->
      <div class="stats-row">
        <div class="stat-card">
          <div><p class="stat-val">{avatarData.totalAvatares}</p><p class="stat-lbl">Avatares creados</p></div>
        </div>
        <div class="stat-card">
          <div><p class="stat-val">{avatarData.totalUsuarios}</p><p class="stat-lbl">Usuarios registrados</p></div>
        </div>
        <div class="stat-card" style="border-left:4px solid var(--rojo)">
          <div><p class="stat-val">{avatarData.pctAvatar}%</p><p class="stat-lbl">Adoptaron el avatar</p></div>
        </div>
      </div>

      <!-- Distribución por estación -->
      <div class="panel">
        <h2>Avatares por estación</h2>
        {Object.keys(avatarData.porEstacion ?? {}).length === 0 ? (
          <p class="empty">Sin datos aún.</p>
        ) : (
          <div class="est-bars">
            {Object.entries(avatarData.porEstacion ?? {})
              .sort((a: any, b: any) => b[1] - a[1])
              .map(([e, count]: any) => {
                const total = avatarData.totalAvatares || 1
                const pct = Math.round((count / total) * 100)
                const color = estacionColors[e] ?? '#9ca3af'
                return (
                  <div class="est-bar-row">
                    <span class="est-bar-label" style={`color:${color}`}>{e.charAt(0).toUpperCase() + e.slice(1)}</span>
                    <div class="est-bar-track">
                      <div class="est-bar-fill" style={`width:${pct}%;background:${color}`}></div>
                    </div>
                    <span class="est-bar-count">{count} <span class="muted">({pct}%)</span></span>
                  </div>
                )
              })
            }
          </div>
        )}
      </div>

      <!-- Piezas más usadas por categoría -->
      <div class="panel">
        <h2>Piezas más usadas por categoría</h2>
        {avatarData.totalAvatares === 0 ? (
          <p class="empty">Sin datos aún.</p>
        ) : (
          <div class="av-cat-grid">
            {(avatarData.Z_ORDER ?? []).map((cat: string) => {
              const tops = avatarData.catStats?.[cat] ?? []
              const label = avatarData.CAT_LABELS?.[cat] ?? cat
              return (
                <div class="av-cat-block">
                  <h3 class="av-cat-title">{label}</h3>
                  {tops.length === 0 ? (
                    <p class="empty" style="font-size:0.75rem">Sin selecciones</p>
                  ) : (
                    <div class="av-top-list">
                      {tops.map((item: any, i: number) => (
                        <div class="av-top-row">
                          <span class="av-top-rank">{i + 1}</span>
                          <img
                            src={`https://storage.googleapis.com/nrm-web/mundial/avatar/${item.path}`}
                            alt=""
                            class={`av-top-thumb av-top-thumb--${cat}`}
                            loading="lazy"
                          />
                          <span class="av-top-name">{item.path.split('/').pop()}</span>
                          <span class="av-top-count">{item.count}</span>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              )
            })}
          </div>
        )}
      </div>

      <!-- Últimas creaciones -->
      <div class="panel">
        <h2>Últimas 10 actualizaciones</h2>
        {(avatarData.recientes ?? []).length === 0 ? (
          <p class="empty">Sin datos.</p>
        ) : (
          <table class="mini-table">
            <thead><tr><th>Usuario</th><th>Estación</th><th>Actualizado</th></tr></thead>
            <tbody>
              {(avatarData.recientes ?? []).map((r: any) => (
                <tr>
                  <td class="user-name">{r.name}</td>
                  <td>
                    <span class="est-tag" style={`background:${(estacionColors as any)[r.estacion] ?? '#e5e7eb'}20;color:${(estacionColors as any)[r.estacion] ?? '#6b7280'}`}>
                      {r.estacion}
                    </span>
                  </td>
                  <td class="date-cell muted">{fmtDate(r.at)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </div>
    </div>
  )}

  <!-- ═══ TAB PUBLICIDAD ══════════════════════════════════════════════════════ -->
  {tab === 'publicidad' && (
    <div>
      <div class="stats-row">
        <div class="stat-card"><div><p class="stat-val">{pubData.impTotal ?? 0}</p><p class="stat-lbl">Impresiones (30d)</p></div></div>
        <div class="stat-card"><div><p class="stat-val">{pubData.clkTotal ?? 0}</p><p class="stat-lbl">Clicks (30d)</p></div></div>
        <div class="stat-card"><div><p class="stat-val">{pubData.ctr ?? '—'}</p><p class="stat-lbl">CTR global</p></div></div>
      </div>

      <div class="panel">
        <h2>Impresiones últimos 30 días</h2>
        {(pubData.diasData ?? []).every(([,v]: any) => v === 0) ? (
          <p class="empty">Sin actividad en este período.</p>
        ) : (
          <div class="bar-chart">
            {(pubData.diasData ?? []).map(([dia, count]: any) => (
              <div class="bar-col">
                <span class="bar-count">{count > 0 ? count : ''}</span>
                <div class="bar-fill" style={`height: ${(count / (pubData.maxBar ?? 1)) * 100}%`}></div>
                <span class="bar-label">{dia.slice(5)}</span>
              </div>
            ))}
          </div>
        )}
      </div>

      <div class="two-col">
        <div class="panel">
          <div class="panel-hdr"><h2>Por cliente</h2><button class="btn-csv" data-filename="ads-por-cliente">⬇ CSV</button></div>
          {!(pubData.perClient ?? []).length ? (
            <p class="empty">Sin datos.</p>
          ) : (
            <table class="mini-table">
              <thead><tr><th>Cliente</th><th>Estado</th><th>Impresiones</th><th>Clicks</th><th>CTR</th></tr></thead>
              <tbody>
                {(pubData.perClient ?? []).map((c: any) => (
                  <tr>
                    <td class="user-name">{c.name}</td>
                    <td><span class={`pct-badge ${c.active ? 'pct-full' : 'pct-low'}`}>{c.active ? 'Activo' : 'Pausado'}</span></td>
                    <td class="count">{c.impressions}</td>
                    <td class="count">{c.clicks}</td>
                    <td style="font-weight:600;">{c.ctr}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
        </div>

        <div class="panel">
          <div class="panel-hdr"><h2>Por slot</h2><button class="btn-csv" data-filename="ads-por-slot">⬇ CSV</button></div>
          {!(pubData.perSlot ?? []).length ? (
            <p class="empty">Sin datos.</p>
          ) : (
            <table class="mini-table">
              <thead><tr><th>Slot</th><th>Impresiones</th><th>Clicks</th><th>CTR</th></tr></thead>
              <tbody>
                {(pubData.perSlot ?? []).map(([slot, d]: any) => {
                  const ctr = d.impressions > 0 ? ((d.clicks / d.impressions) * 100).toFixed(1) + '%' : '—'
                  return (
                    <tr>
                      <td class="user-name">{slot}</td>
                      <td class="count">{d.impressions}</td>
                      <td class="count">{d.clicks}</td>
                      <td style="font-weight:600;">{ctr}</td>
                    </tr>
                  )
                })}
              </tbody>
            </table>
          )}
        </div>
      </div>
    </div>
  )}

  <!-- ═══ TAB PROGRESO ══════════════════════════════════════════════════════════ -->
  {tab === 'progreso' && (
    <div>
      <div class="panel" style="text-align:center;padding:3rem 2rem;">
        <h2 style="color:#374151;margin-bottom:0.5rem;">Progreso global</h2>
        <p style="color:#9ca3af;font-size:0.9rem;">Usa el tab <strong>Álbum</strong> para ver el ranking de participantes y el detalle por carta.</p>
        <a href="?tab=album&estacion=todas" style="display:inline-block;margin-top:1rem;background:var(--rojo);color:white;padding:0.5rem 1.2rem;border-radius:0.5rem;font-weight:700;text-decoration:none;">Ver estadísticas de álbum</a>
      </div>
    </div>
  )}

<script>
  document.addEventListener('click', e => {
    const btn = (e.target as HTMLElement).closest('.btn-csv') as HTMLButtonElement | null
    if (!btn) return
    const table = btn.closest('.panel')?.querySelector('table')
    if (!table) return

    const rows: string[][] = []
    const headers = Array.from(table.querySelectorAll('thead th')).map(th => th.textContent?.trim() ?? '')
    rows.push(headers)
    table.querySelectorAll('tbody tr').forEach(tr => {
      const cells = Array.from(tr.querySelectorAll('td')).map(td => td.textContent?.replace(/\s+/g, ' ').trim() ?? '')
      rows.push(cells)
    })

    const csv = rows.map(row => row.map(c => `"${c.replace(/"/g, '""')}"`).join(',')).join('\n')
    const blob = new Blob(['﻿' + csv], { type: 'text/csv;charset=utf-8;' })
    const url = URL.createObjectURL(blob)
    const a = document.createElement('a')
    const date = new Date().toISOString().slice(0, 10)
    a.href = url
    a.download = `${btn.dataset.filename ?? 'datos'}-${date}.csv`
    document.body.appendChild(a)
    a.click()
    document.body.removeChild(a)
    URL.revokeObjectURL(url)
  })
</script>

</AdminLayout>

<style>
