  /* Two-col layout */
  .two-col { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 1.5rem; }

  /* Mini table */
  .mini-table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
  .mini-table th { text-align: left; font-size: 0.68rem; text-transform: uppercase; color: #bbb; padding-bottom: 0.5rem; border-bottom: 1px solid #f0f0f0; }
