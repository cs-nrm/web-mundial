---
import Layout from '../../layouts/Layout.astro'
import { createSupabaseServerClient } from '../../lib/supabase'
import manifest from '../../../public/avatar/manifest.json'

// Sin caché — siempre refrescar desde DB al entrar al editor
Astro.response.headers.set('Cache-Control', 'no-store')

const { user, hasGenerales, estacion_favorita } = Astro.locals

if (!user) return Astro.redirect('/auth/login?redirect=/perfil/avatar')
if (!hasGenerales) return Astro.redirect('/perfil/datos')

const estacion = (estacion_favorita as string) ?? 'beat'

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies)
const { data: profile } = await supabase
  .from('profiles')
  .select('avatar_url, avatar_config')
  .eq('id', user.id)
  .maybeSingle()

function piezasDisponibles(categoria: string): string[] {
  const catDef = (manifest.categorias as any)[categoria]
  if (!catDef) return []
  const assets = manifest.assets as any
  if (catDef.scope === 'por_estacion') return assets[estacion]?.[categoria] ?? []
  return [
    ...(assets.universal?.[categoria] ?? []),
    ...(assets[estacion]?.[categoria] ?? []),
  ]
}

const LABELS: Record<string, string> = {
  fondo: 'Fondo', 'cuerpo-jersey': 'Jersey', cabello: 'Cabello',
  cejas: 'Cejas', ojos: 'Ojos', lentes: 'Lentes', boca: 'Boca',
  bigote: 'Bigote', barba: 'Barba', gorra: 'Gorra', marco: 'Marco',
}

// SVG icon paths (24x24 viewBox, stroke-based)
const ICONS: Record<string, string> = {
  fondo: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="18" rx="2.5"/><path d="M2 16l5-6 4 4 2.5-2.5L19 19"/><circle cx="16.5" cy="8.5" r="1.5"/></svg>`,
  'cuerpo-jersey': `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3s-1 2-2 2.5L3 4 2 9l3.5 1.5V21h13V10.5L22 9l-1-5-4 1.5C16 5 15 3 15 3c-1 1.5-1.5 2-3 2S10 4.5 9 3Z"/></svg>`,
  cabello: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 5c2-1.5 5-2 7-2s5 .5 7 2"/><path d="M5 5C4 8 4 13 4 16c0 2 3 4 8 4s8-2 8-4c0-3 0-8-1-11"/><path d="M7 9c1-1 3-1.5 5-1.5s4 .5 5 1.5"/></svg>`,
  cejas: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M2 10c2-2.5 5-3 7-2.5"/><path d="M22 10c-2-2.5-5-3-7-2.5"/></svg>`,
  ojos: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"/><circle cx="12" cy="12" r="3"/></svg>`,
  lentes: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="7" cy="12" r="4"/><circle cx="17" cy="12" r="4"/><path d="M11 12h2"/><path d="M1 12h2m18 0h2"/></svg>`,
  boca: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 12h10"/><path d="M7 12c1.5 4 9.5 4 10 0"/></svg>`,
  bigote: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11c2-1.5 4-1 5 0 .5.5 1.5 1 4 1s3.5-.5 4-1c1-1 3-1.5 5 0"/><path d="M3 11c-.5-1.5.5-3 3-2"/><path d="M21 11c.5-1.5-.5-3-3-2"/></svg>`,
  barba: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13c0 5 2.5 8 7 8s7-3 7-8"/><path d="M5 13L4 9M19 13l1-4"/><path d="M4 9c0-4 3-6 8-6s8 2 8 6"/></svg>`,
  gorra: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 14a7 7 0 0114 0"/><path d="M2 14h20"/><path d="M14 14V9a2 2 0 00-4 0v5"/></svg>`,
  marco: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="3.5"/><rect x="6" y="6" width="12" height="12" rx="1.5"/></svg>`,
}

const CAT_DESCS: Record<string, string> = {
  fondo: 'Fondo de tu estampa.',
  'cuerpo-jersey': 'Jersey de tu avatar.',
  cabello: 'Elige el cabello.',
  cejas: 'Elige las cejas.',
  ojos: 'Elige los ojos.',
  lentes: 'Opcional — lentes o ninguno.',
  boca: 'Elige la boca.',
  bigote: 'Opcional — bigote o ninguno.',
  barba: 'Opcional — barba o ninguno.',
  gorra: 'Opcional — gorra o ninguno.',
  marco: 'Marco con branding de tu estación.',
}

const zOrder = manifest.z_order
const piezasPorCategoria = Object.fromEntries(zOrder.map(c => [c, piezasDisponibles(c)]))
const categoriasRequeridas = Object.fromEntries(
  zOrder.map(c => [c, (manifest.categorias as any)[c]?.requerido ?? true])
)

const AVATAR_BASE_URL = 'https://storage.googleapis.com/nrm-web/mundial/avatar'

const clientData = {
  zOrder,
  piezas: piezasPorCategoria,
  requerido: categoriasRequeridas,
  savedConfig: (profile as any)?.avatar_config ?? null,
  labels: LABELS,
  descs: CAT_DESCS,
  baseUrl: AVATAR_BASE_URL,
}

const STATION_COLORS: Record<string, string> = {
  beat: '#f97316', oye: '#3b82f6', sabrosita: '#ec4899', stereocien: '#8b5cf6',
}
const accent = STATION_COLORS[estacion] ?? '#EA262A'
const hasAvatar = !!(profile as any)?.avatar_url
---

<Layout title="Crea tu avatar" noWrapper={true}>
<div class="av" style={`--ac: ${accent}; --ac-dim: ${accent}22; --ac-glow: ${accent}55`}>

  <!-- Nav -->
  <div class="av-nav">
    <a href="/perfil" class="av-back">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="18" height="18"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    </a>
    <div class="av-nav-actions">
      <button id="btn-dl" class="av-btn-icon" title="Descargar">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="18" height="18"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
      </button>
      <button id="btn-save" class="av-btn-save">
        <span id="btn-save-text">{hasAvatar ? 'Actualizar' : 'Guardar'}</span>
      </button>
    </div>
  </div>

  <!-- Tabs de categoría -->
  <div class="av-tabs-wrap">
    <div class="av-tabs" id="av-tabs">
      {zOrder.map((cat) => (
        <button class="av-tab" data-cat={cat} type="button">
          <span class="av-tab-icon" set:html={ICONS[cat]} />
          <span class="av-tab-label">{LABELS[cat]}</span>
        </button>
      ))}
    </div>
  </div>

  <!-- Workspace: preview 20% + picker 80% -->
  <div class="av-workspace">

    <!-- Preview -->
    <div class="av-preview">
      <div class="av-card-outer">
        <div class="av-card-inner">
          <canvas id="av-canvas" width="600" height="900"></canvas>
          <div id="av-loader" class="av-loader">
            <div class="av-spinner"></div>
          </div>
        </div>
      </div>
      <div id="av-msg" class="av-msg" hidden></div>
    </div>

    <!-- Grid de piezas -->
    <div class="av-panel">
      <div class="av-grid" id="av-grid"></div>
    </div>

  </div>

</div>
</Layout>

<script define:vars={{ clientData }}>
  const { zOrder, piezas, requerido, savedConfig, labels, descs, baseUrl } = clientData

  function init() {
  const canvas   = document.getElementById('av-canvas')
  if (!canvas) return                          // guard: DOM no listo
  const ctx      = canvas.getContext('2d')
  const loader   = document.getElementById('av-loader')
  const tabs     = document.getElementById('av-tabs')
  const grid     = document.getElementById('av-grid')
  const msg      = document.getElementById('av-msg')
  const btnSave  = document.getElementById('btn-save')
  const btnDl    = document.getElementById('btn-dl')
  const saveText = document.getElementById('btn-save-text')

  // Inicializar selecciones
  const sel = {}
  for (const cat of zOrder) {
    const avail = piezas[cat] ?? []
    const isReq = requerido[cat] ?? true
    const saved = savedConfig?.[cat]
    if (saved !== undefined && (saved === null || avail.includes(saved))) {
      sel[cat] = saved
    } else {
      sel[cat] = isReq ? (avail[0] ?? null) : null
    }
  }

  let activeCat = zOrder[0]
  let renderVersion = 0  // incrementa con cada render para cancelar renders viejos

  // ── Canvas ──────────────────────────────────────────────
  async function render() {
    const myVersion = ++renderVersion
    loader.removeAttribute('hidden')

    // Snapshot del sel actual para que este render use exactamente estos valores
    const snapshot = { ...sel }

    ctx.clearRect(0, 0, canvas.width, canvas.height)
    try {
      for (const cat of zOrder) {
        if (myVersion !== renderVersion) return // cancelado por render más nuevo
        if (!snapshot[cat]) continue
        try { await drawImg(`${baseUrl}/${snapshot[cat]}`) } catch (e) {
          console.warn('[avatar] imagen no cargó:', snapshot[cat], e)
        }
      }
    } finally {
      if (myVersion === renderVersion) {
        loader.setAttribute('hidden', '')
      }
    }
  }

  // En prod usamos GCS directo (CORS configurado en el bucket).
  // En dev usamos proxy porque el browser puede tener caché sin CORS headers.
  const IS_DEV = location.hostname === 'localhost' || location.hostname === '127.0.0.1'

  function drawImg(src) {
    return new Promise((ok, fail) => {
      const img = new Image()
      img.crossOrigin = 'anonymous'
      img.onload = () => { ctx.drawImage(img, 0, 0, canvas.width, canvas.height); ok() }
      img.onerror = fail
      img.src = IS_DEV ? `/api/img-proxy?url=${encodeURIComponent(src)}` : src
    })
  }

  // ── Tabs ─────────────────────────────────────────────────
  function syncTabs() {
    tabs.querySelectorAll('.av-tab').forEach(btn => {
      const cat = btn.dataset.cat
      const isActive = cat === activeCat
      const isDone = sel[cat] !== null && sel[cat] !== undefined
      btn.classList.toggle('active', isActive)
      btn.classList.toggle('done', isDone && !isActive)
      btn.setAttribute('aria-selected', String(isActive))
    })
    // Scroll tab activo al centro
    const activeBtn = tabs.querySelector('.av-tab.active')
    if (activeBtn) {
      activeBtn.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'smooth' })
    }
  }

  tabs.querySelectorAll('.av-tab').forEach(btn => {
    btn.addEventListener('click', () => {
      activeCat = btn.dataset.cat
      syncTabs()
      renderGrid()
    })
  })

  // ── Grid ─────────────────────────────────────────────────
  const CHECK_SVG = `<svg viewBox="0 0 20 20" fill="currentColor" width="11" height="11"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>`

  function renderGrid() {
    const avail = piezas[activeCat] ?? []
    const isReq = requerido[activeCat] ?? true
    const cur   = sel[activeCat]

    // Animación de salida/entrada del grid
    grid.style.opacity = '0'
    grid.style.transform = 'translateY(6px)'

    setTimeout(() => {
      grid.innerHTML = ''

      if (!isReq) grid.appendChild(makeNoneBtn(cur === null))

      avail.forEach((path, i) => {
        const label = `${labels[activeCat] ?? activeCat} ${String(i + 1).padStart(2, '0')}`
        grid.appendChild(makePieceBtn(path, label, cur === path))
      })

      if (avail.length === 0 && isReq) {
        const p = document.createElement('p')
        p.className = 'av-empty'
        p.textContent = 'Sin piezas disponibles.'
        grid.appendChild(p)
      }

      grid.style.transition = 'opacity 180ms cubic-bezier(0.23,1,0.32,1), transform 180ms cubic-bezier(0.23,1,0.32,1)'
      grid.style.opacity = '1'
      grid.style.transform = 'translateY(0)'
    }, 80)
  }

  function makeNoneBtn(selected) {
    const btn = document.createElement('button')
    btn.className = `av-piece${selected ? ' selected' : ''}`
    btn.innerHTML = `
      <div class="av-thumb av-thumb-none">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="22" height="22">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </div>
      ${selected ? `<div class="av-check">${CHECK_SVG}</div>` : ''}`
    btn.onclick = () => pick(null)
    return btn
  }

  function makePieceBtn(path, label, selected) {
    const btn = document.createElement('button')
    btn.className = `av-piece${selected ? ' selected' : ''}`
    btn.innerHTML = `
      <div class="av-thumb av-thumb--${activeCat}">
        <img src="${baseUrl}/${path}" alt="${label}" loading="lazy" ${IS_DEV ? '' : 'crossorigin="anonymous"'} />
      </div>
      ${selected ? `<div class="av-check">${CHECK_SVG}</div>` : ''}`
    btn.onclick = () => pick(path)
    return btn
  }

  function pick(path) {
    sel[activeCat] = path
    renderGrid()
    syncTabs()
    render()
  }

  // ── Guardar ──────────────────────────────────────────────
  btnSave.addEventListener('click', async () => {
    btnSave.disabled = true
    saveText.textContent = 'Guardando...'
    msg.setAttribute('hidden', '')

    try {
      let imageData
      try {
        imageData = canvas.toDataURL('image/png')
      } catch (e) {
        console.error('[avatar] toDataURL falló (canvas tainted?):', e)
        throw new Error('canvas_tainted')
      }

      const res = await fetch('/api/perfil/avatar', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ imageData, config: sel }),
      })
      const data = await res.json()
      console.log('[avatar] respuesta API:', data)
      if (!data.ok) throw new Error(data.error ?? 'api_error')

      msg.removeAttribute('hidden')
      msg.className = 'av-msg ok'
      msg.textContent = '¡Estampa guardada!'
      saveText.textContent = 'Actualizar'
    } catch (e) {
      console.error('[avatar] error al guardar:', e)
      msg.removeAttribute('hidden')
      msg.className = 'av-msg err'
      msg.textContent = e.message === 'canvas_tainted'
        ? 'Error de permisos de imagen. Recarga la página.'
        : 'Error al guardar. Intenta de nuevo.'
      saveText.textContent = 'Guardar'
    } finally {
      btnSave.disabled = false
    }
  })

  // ── Descargar ────────────────────────────────────────────
  btnDl.addEventListener('click', () => {
    const a = document.createElement('a')
    a.download = 'mi-estampa.png'
    a.href = canvas.toDataURL('image/png')
    a.click()
  })

  // ── Init ─────────────────────────────────────────────────
  // Ajustar la altura del builder al espacio real disponible en viewport
  function fitHeight() {
    const avEl = document.querySelector('.av')
    if (!avEl) return
    const top = avEl.getBoundingClientRect().top
    const h = Math.max(400, window.innerHeight - top)
    avEl.style.height = h + 'px'
  }
  fitHeight()
  window.addEventListener('resize', fitHeight)

  syncTabs()
  renderGrid()
  render()

  } // fin init()

  // Ejecutar en carga normal Y en cada navegación con View Transitions
  document.addEventListener('astro:page-load', init)
</script>

<style is:global>
  /* ── Base ── */
  .av {
    height: 600px; /* fallback, JS lo sobreescribe */
    max-width: 1280px;
    margin: 0 auto;
    background: #0c0e14;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    color: #fff;
  }

  /* ── Nav ── */
  .av-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 1rem;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    flex-shrink: 0;
    background: #0c0e14;
  }
  .av-back {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    color: rgba(255,255,255,0.45);
    text-decoration: none;
    background: rgba(255,255,255,0.05);
    transition: background 150ms cubic-bezier(0.23,1,0.32,1), color 150ms cubic-bezier(0.23,1,0.32,1);
    flex-shrink: 0;
  }
  .av-back:hover { background: rgba(255,255,255,0.1); color: #fff; }
  @media (hover: hover) and (pointer: fine) {
    .av-back:active { transform: scale(0.95); }
  }
  .av-nav-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }
  .av-btn-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: none;
    cursor: pointer;
    background: rgba(255,255,255,0.05);
    color: rgba(255,255,255,0.45);
    transition: background 150ms cubic-bezier(0.23,1,0.32,1), color 150ms cubic-bezier(0.23,1,0.32,1);
  }
  .av-btn-icon:hover { background: rgba(255,255,255,0.1); color: #fff; }
  .av-btn-save {
    height: 36px;
    padding: 0 1.1rem;
    border-radius: 999px;
    border: none;
    cursor: pointer;
    background: var(--ac);
    color: #fff;
    font-family: 'League Spartan', sans-serif;
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    transition: filter 150ms cubic-bezier(0.23,1,0.32,1), box-shadow 150ms cubic-bezier(0.23,1,0.32,1);
    box-shadow: 0 0 20px var(--ac-glow);
    white-space: nowrap;
  }
  .av-btn-save:hover:not(:disabled) { filter: brightness(1.1); }
  .av-btn-save:active:not(:disabled) { transform: scale(0.97); }
  .av-btn-save:disabled { opacity: 0.4; cursor: not-allowed; }

  /* ── Tabs ── */
  .av-tabs-wrap {
    flex-shrink: 0;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    background: #0f1118;
    min-height: 44px;
  }
  .av-tabs {
    display: flex;
    flex-wrap: nowrap;
    gap: 0.25rem;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 0.5rem 0.875rem;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    margin: 0;
    padding-left: 0.875rem;
  }
  .av-tabs::-webkit-scrollbar { display: none; }

  .av-tab {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    border: 1.5px solid transparent;
    cursor: pointer;
    white-space: nowrap;
    background: transparent;
    color: rgba(255,255,255,0.3);
    font-family: 'League Spartan', sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: color 150ms cubic-bezier(0.23,1,0.32,1),
                background 150ms cubic-bezier(0.23,1,0.32,1),
                border-color 150ms cubic-bezier(0.23,1,0.32,1);
    flex-shrink: 0;
    position: relative;
  }
  .av-tab-icon { display: flex; width: 14px; height: 14px; flex-shrink: 0; }
  .av-tab-icon svg { width: 14px; height: 14px; }
  .av-tab-label { line-height: 1; }
  .av-tab:hover { color: rgba(255,255,255,0.65); }
  .av-tab.done::after {
    content: '';
    position: absolute;
    top: 3px; right: 3px;
    width: 6px; height: 6px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 5px rgba(16,185,129,0.7);
  }
  .av-tab.active {
    background: var(--ac-dim);
    border-color: var(--ac);
    color: var(--ac);
    box-shadow: 0 0 12px var(--ac-glow);
  }
  .av-tab.active::after { display: none; }

  /* ── Workspace: preview 20% + picker 80% ── */
  .av-workspace {
    flex: 1;
    min-height: 0;
    display: flex;
    overflow: hidden;
  }

  /* Preview — columna izquierda */
  .av-preview {
    width: 20%;
    min-width: 120px;
    max-width: 200px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 0.75rem;
    padding: 1rem 0.75rem;
    padding-top: 1.25rem;
    border-right: 1px solid rgba(255,255,255,0.05);
    background: #0c0e14;
    overflow-y: auto;
  }

  .av-card-outer {
    width: 100%;
    padding: 4px;
    border-radius: 1.2rem;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
    box-shadow: 0 0 0 1px var(--ac-dim), 0 0 28px var(--ac-glow), 0 8px 32px rgba(0,0,0,0.7);
  }
  .av-card-inner {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 3;
    border-radius: calc(1.2rem - 4px);
    overflow: hidden;
    background: #0a0c12;
    box-shadow: inset 0 1px 1px rgba(255,255,255,0.06);
  }
  .av-card-inner canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  .av-loader {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(8,10,16,0.65);
  }
  .av-loader[hidden] { display: none; }
  .av-spinner {
    width: 1.25rem;
    height: 1.25rem;
    border: 2px solid rgba(255,255,255,0.06);
    border-top-color: var(--ac);
    border-radius: 50%;
