---
import Layout from "../layouts/Layout.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { getArticles } from "../lib/api.js";
import ArticleCard from "../components/ArticleCard.astro";
import WidgetSorteo from "../layouts/WidgetSorteo.astro";

const posts = await getArticles();
---



<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <main id="home" class="">
    <section class="container mx-auto px-4 py-8">
      <div class="flex flex-col lg:flex-row lg:gap-8">
        <div class="w-full lg:w-[75%]" style="padding:56.25% 0 0 0;position:relative;"><iframe src="https://vimeo.com/event/5550286/embed" frameborder="0" allow="autoplay; fullscreen; picture-in-picture; encrypted-media; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen style="position:absolute;top:0;left:0;width:100%;height:100%;"></iframe></div>
        <div class="w-full lg:w-[25%]"><iframe src="https://vimeo.com/live/interaction_tools/live_event/5550286?theme=light" width="100%" height="100%" frameborder="0"></iframe></div>
      </div>
    </section>
    <section class="container mx-auto px-4 py-8">
      <h1 class="text-4xl font-bold text-center mb-8 text-gray-800">
        Últimas Noticias
      </h1>

      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6"
      >
        {posts.map((post) => <ArticleCard post={post} />)}
      </div>

      {
        posts.length === 0 && (
          <div class="text-center py-20">
            <p class="text-xl text-gray-500">Cargando noticias...</p>
          </div>
        )
      }
    </section>
    <section>
      <WidgetSorteo />
    </section>
  </main>
</Layout>
