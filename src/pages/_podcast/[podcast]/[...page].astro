---
import Card from '../../../layouts/CardsPodcast.astro';
import { SITE_DESCRIPTION } from '../../../consts.js';
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths( { paginate } ) {
    
    const arrpodcast = [
        {nodo: 773,title: 'Momentos Irrepetibles', link: 'momentos-irrepetibles', imagen: 'https://storage.googleapis.com/nrm-web/sabrosita/podcast/MOMENTOS.jpg', descripcion: 'Te presentamos material inédito de los grandes ídolos de México para que conozcas en sus propias palabras su verdadera historia... Escúchalo y entra en la vida de los grandes ídolos de México.'},
        {nodo: 726,title: 'Frecuencia del Miedo', link: 'frecuencia-del-miedo', imagen: 'https://storage.googleapis.com/nrm-web/sabrosita/podcast/MIEDO.jpg', descripcion: 'Testimonios que hablan de la existencia de seres aterradores, demonios, fantasmas, seres que dan miedo. Te recomendamos no sugestionarte o de lo contrario quedarás atrapado en un plano dimensional sin regreso.'},
        {nodo: 509,title: 'Vidas Salseras', link: 'vidas-salseras', imagen: 'https://storage.googleapis.com/nrm-web/sabrosita/podcast/VIDAS.jpg', descripcion: 'Historias, anécdotas, triunfos, fracasos y todas las experiencias que han construido a los protagonistas de la música tropical son parte de este podcast. Un acercamiento a la intimidad de los artistas más importantes de la música tropical.'},
        {nodo: 511,title: 'Los Secretos detrás de las Letras', link: 'secretos-detras-de-las-letras', imagen: 'https://storage.googleapis.com/nrm-web/sabrosita/podcast/SECRETOS.jpg', descripcion: 'Un podcast en el que te contaremos las historias y anécdotas que han dado vida a las canciones más destacadas de la música tropical contadas directamente por sus autores e intérpretes.'},
        {nodo: 512,title: 'Sin Barreras', link: 'sin-barreras', imagen: 'https://storage.googleapis.com/nrm-web/sabrosita/podcast/SIN-BARRERAS.jpg', descripcion: 'Sin Barreras es un podcast de Sabrosita 590, en donde Giovanna Franyuti te enseña sobre temas de discapacidad e inclusión para que puedas vivir "sin barreras".'},
        {nodo: 752,title: 'El Sabor del Amor', link: 'sabor-del-amor', imagen: 'https://storage.googleapis.com/nrm-web/sabrosita/podcast/SABOR_AMOR.jpg', descripcion: 'Un playlist de podcast que reúne a un panel de especialistas en cuestiones del amor, relaciones de pareja, sexualidad y erotismo para que conozcas el sabor del amor.'},
        {nodo: 1649,title: 'Celia Cruz, 100 años de azúcar', link: 'celia-cruz', imagen: 'https://storage.googleapis.com/nrm-web/sabrosita/podcast/celia-min.jpg', descripcion: 'Sabrosita presenta: ¡100 años de azúcar! un especial dedicado a los 100 años del natalicio de Celia Cruz (La reina de la salsa)'},
    ]; 

  
  const res = await fetch("https://sabrositadigital.com.mx/wp-json/wp/v2/posts?_embed&per_page=250&_fields=title,slug,yoast_head_json,categories,acf&categories=773,726,509,511,512,752,1649" ); 
  const posts = await res.json();
  //console.log(posts);
  
  return arrpodcast.flatMap( function(pod) {      
      const podcast = pod.link; 
      //console.log(pod.nodo);           
      const filteredPosts = posts.filter((post:any) => post.categories[0]  == pod.nodo || post.categories[1]  == pod.nodo );                      
      //console.log(filteredPosts);
      return paginate(filteredPosts,{
        params:{ podcast },
        props: { pod},
        pageSize: 10
      });
  });  
}

interface Props{
  page: any; 
  podcast: any;
  pod:any; 
}

const { page = [] } = Astro.props;
const { podcast, pod } = Astro.props;
const pageTitle = `Podcast: ${pod.title}`;
---

<Layout title={pageTitle} description={SITE_DESCRIPTION} img={pod.imagen}>
  <div class="container my-12 mx-auto px-4 md:px-12">
    <div class="flex flex-wrap justify-center ">
      <div class="w-full md:w-1/3 lg:w-1/4"><img class="content-center shadow-xl rounded-xl" src={pod.imagen} alt={pod.title} /></div>
      <div class="w-full md:w-2/3 lg:w-3/4 p-4 flex items-center">
        <div>
          <h1 class="audiowide neon-morado text-center md:text-left font-bold text-3xl md:text-4xl lg:text-3xl xl:text-4xl align-middle">{pod.title}</h1>
          <p class="align-middle">{pod.descripcion}</p>
        </div>
      </div>
    </div>
    <section class="flex flex-wrap -mx-4">
      {page.data.map((post:any) => (<Card post={post} />))}
    </section>
    <div class="m-auto text-center">
      {page.url.prev && (
        <a href={page.url.prev}>
          <button class="ver-mas group relative h-8 m-4 text-xl px-4 rounded-full spartan bold overflow-hidden bg-[#EA262A] border-4 border-[#EA262A] hover:border-[#FDCF27] font-bold">
            <span>Anterior</span>
          </button>
        </a>
      )}
      {page.url.next && (
        <a href={page.url.next}>
          <button class="ver-mas group relative h-8 m-4 text-xl px-4 rounded-full spartan bold overflow-hidden bg-[#EA262A] border-4 border-[#EA262A] hover:border-[#FDCF27] font-bold">
            <span>Siguiente</span>
          </button>
        </a>
      )}
    </div>
  </div>
</Layout>