---
// Página de acceso de emergencia — no enlazar desde ningún lugar público
import Layout from '../../layouts/Layout.astro'
import { isEmergencyConfigured } from '../../lib/emergency-auth'

const errorParam = Astro.url.searchParams.get('error')
const errorMessages: Record<string, string> = {
  invalido: 'Clave incorrecta.',
  requerido: 'Ingresa la clave de emergencia.',
  no_configurado: 'Acceso de emergencia no configurado en el servidor.',
}
const errorMsg = errorParam ? (errorMessages[errorParam] ?? 'Error desconocido.') : null
const configured = isEmergencyConfigured()
---

<Layout title="Acceso de emergencia">
  <div class="min-h-screen flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-sm">
      <div class="text-center mb-8">
        <p class="text-4xl mb-3">🔑</p>
        <h1 class="text-2xl font-bold text-white">Acceso de emergencia</h1>
        <p class="text-gray-400 mt-1 text-sm">Solo para administradores</p>
      </div>

      <div class="bg-white rounded-2xl shadow-xl p-8">
        {!configured && (
          <div class="bg-yellow-50 border border-yellow-200 text-yellow-800 rounded-lg px-4 py-3 text-sm mb-4">
            Variable <code class="font-mono">EMERGENCY_ADMIN_SECRET</code> no configurada (mín. 32 caracteres).
          </div>
        )}

        {errorMsg && (
          <div class="bg-red-50 border border-red-200 text-red-700 rounded-lg px-4 py-3 mb-5 text-sm">
            {errorMsg}
          </div>
        )}

        <form method="POST" action="/api/auth/emergency" class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1" for="secret">
              Clave de emergencia
            </label>
            <input
              id="secret"
              name="secret"
              type="password"
              required
              autocomplete="off"
              class="w-full border border-gray-300 rounded-xl px-4 py-3 text-gray-900 focus:outline-none focus:border-[#EA262A] transition"
              placeholder="••••••••••••••••"
            />
          </div>

          <button
            type="submit"
            class="w-full bg-[#EA262A] text-white font-bold py-3 rounded-xl hover:bg-red-700 transition"
          >
            Entrar
          </button>
        </form>
      </div>

      <p class="text-center text-xs text-gray-500 mt-4">
        <a href="/auth/login" class="hover:underline">← Volver al login normal</a>
      </p>
    </div>
  </div>
</Layout>
