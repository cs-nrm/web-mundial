---
import Layout from '../../layouts/Layout.astro'

const redirect = Astro.url.searchParams.get('redirect') ?? '/'
const errorParam = Astro.url.searchParams.get('error')

const errorMessages: Record<string, string> = {
  campos_requeridos: 'Completa todos los campos.',
  contrasenas_no_coinciden: 'Las contraseñas no coinciden.',
  contrasena_corta: 'La contraseña debe tener al menos 8 caracteres.',
  email_en_uso: 'Ese correo ya está registrado. Intenta iniciar sesión.',
  error: 'Ocurrió un error. Intenta de nuevo.',
}
const errorMsg = errorParam ? (errorMessages[errorParam] ?? errorMessages.error) : null
---
<Layout title="Crear cuenta" noindex={true}>
  <div class="min-h-screen flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">

      <div class="text-center mb-8">
        <h1 class="text-3xl font-bold spartan text-gray-900">Crear cuenta</h1>
        <p class="text-gray-500 mt-2">Únete y participa en las promociones</p>
      </div>

      <div class="bg-white rounded-2xl shadow-xl p-8">

        {errorMsg && (
          <div class="bg-red-50 border border-red-200 text-red-700 rounded-lg px-4 py-3 mb-6 text-sm">
            {errorMsg}
          </div>
        )}

        <!-- Google -->
        <a
          href={`/auth/login-google?redirect=${encodeURIComponent(redirect)}`}
          class="flex items-center justify-center gap-3 w-full border-2 border-gray-200 rounded-xl py-3 px-4 text-gray-700 font-semibold hover:bg-gray-50 transition mb-6"
        >
          <svg width="20" height="20" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M43.611,20.083H42V20H24v8h11.303c-1.649,4.657-6.08,8-11.303,8c-6.627,0-12-5.373-12-12c0-6.627,5.373-12,12-12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C12.955,4,4,12.955,4,24c0,11.045,8.955,20,20,20c11.045,0,20-8.955,20-20C44,22.659,43.862,21.35,43.611,20.083z" fill="#FFC107"/>
            <path d="M6.306,14.691l6.571,4.819C14.655,15.108,19.001,12,24,12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C16.318,4,9.656,8.337,6.306,14.691z" fill="#FF3D00"/>
            <path d="M24,44c5.166,0,9.86-1.977,13.409-5.192l-6.19-5.238C29.211,35.091,26.715,36,24,36c-5.202,0-9.619-3.317-11.283-7.946l-6.522,5.025C9.505,39.556,16.227,44,24,44z" fill="#4CAF50"/>
            <path d="M43.611,20.083H42V20H24v8h11.303c-0.792,2.237-2.231,4.166-4.087,5.571l6.19,5.238C39.999,36.801,44,30.897,44,24C44,22.659,43.862,21.35,43.611,20.083z" fill="#1976D2"/>
          </svg>
          Registrarse con Google
        </a>

        <div class="flex items-center gap-3 mb-6">
          <div class="flex-1 h-px bg-gray-200"></div>
          <span class="text-gray-400 text-sm">o con correo</span>
          <div class="flex-1 h-px bg-gray-200"></div>
        </div>

        <form method="POST" action="/api/auth/signup" class="space-y-4">
          <input type="hidden" name="redirect" value={redirect} />

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1" for="email">Correo electrónico</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="email"
              class="w-full border border-gray-300 rounded-xl px-4 py-3 text-gray-900 focus:outline-none focus:border-[#EA262A] transition"
              placeholder="tu@correo.com"
            />
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1" for="password">Contraseña</label>
            <input
              id="password"
              name="password"
              type="password"
              required
              autocomplete="new-password"
              minlength="8"
              class="w-full border border-gray-300 rounded-xl px-4 py-3 text-gray-900 focus:outline-none focus:border-[#EA262A] transition"
              placeholder="Mínimo 8 caracteres"
            />
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1" for="confirm_password">Confirmar contraseña</label>
            <input
              id="confirm_password"
              name="confirm_password"
              type="password"
              required
              autocomplete="new-password"
              class="w-full border border-gray-300 rounded-xl px-4 py-3 text-gray-900 focus:outline-none focus:border-[#EA262A] transition"
              placeholder="Repite tu contraseña"
            />
          </div>

          <button
            type="submit"
            class="w-full bg-[#EA262A] text-white font-bold py-3 rounded-xl hover:bg-red-700 transition spartan text-lg"
          >
            Crear cuenta
          </button>
        </form>

        <p class="text-center text-sm text-gray-500 mt-6">
          ¿Ya tienes cuenta?{' '}
          <a href={`/auth/login?redirect=${encodeURIComponent(redirect)}`} class="text-[#EA262A] font-semibold hover:underline">Inicia sesión</a>
        </p>

      </div>
    </div>
  </div>
</Layout>
