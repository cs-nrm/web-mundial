---
import Layout from '../../layouts/Layout.astro'

const ok = Astro.url.searchParams.has('ok')
const errorParam = Astro.url.searchParams.get('error')

const errorMessages: Record<string, string> = {
  email_requerido: 'Ingresa tu correo electrónico.',
  error: 'Ocurrió un error. Intenta de nuevo.',
}
const errorMsg = errorParam ? (errorMessages[errorParam] ?? errorMessages.error) : null
---
<Layout title="Recuperar contraseña" noindex={true}>
  <div class="min-h-screen flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">

      <div class="text-center mb-8">
        <h1 class="text-3xl font-bold spartan text-white">Recuperar contraseña</h1>
        <p class="text-gray-400 mt-2">Te enviaremos un enlace para restablecerla</p>
      </div>

      <div class="bg-white rounded-2xl shadow-xl p-8">

        {ok ? (
          <div class="text-center py-4">
            <div class="text-5xl mb-4">📬</div>
            <p class="text-gray-700 font-semibold mb-2">¡Listo! Revisa tu correo.</p>
            <p class="text-gray-500 text-sm">Si tienes una cuenta con ese correo, recibirás el enlace en breve.</p>
            <a href="/auth/login" class="inline-block mt-6 text-[#EA262A] font-semibold hover:underline text-sm">
              Volver al inicio de sesión
            </a>
          </div>
        ) : (
          <>
            {errorMsg && (
              <div class="bg-red-50 border border-red-200 text-red-700 rounded-lg px-4 py-3 mb-6 text-sm">
                {errorMsg}
              </div>
            )}

            <form method="POST" action="/api/auth/request-reset" class="space-y-4">
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1" for="email">Correo electrónico</label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  class="w-full border border-gray-300 rounded-xl px-4 py-3 text-gray-900 focus:outline-none focus:border-[#EA262A] transition"
                  placeholder="tu@correo.com"
                />
              </div>

              <button
                type="submit"
                class="w-full bg-[#EA262A] text-white font-bold py-3 rounded-xl hover:bg-red-700 transition spartan text-lg"
              >
                Enviar enlace
              </button>
            </form>

            <p class="text-center text-sm text-gray-500 mt-6">
              <a href="/auth/login" class="text-[#EA262A] font-semibold hover:underline">Volver al inicio de sesión</a>
            </p>
          </>
        )}

      </div>
    </div>
  </div>
</Layout>
