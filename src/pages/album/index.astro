---
import Layout from '../../layouts/Layout.astro'
import { createSupabaseServerClient } from '../../lib/supabase'

const { user, estacion_favorita, role } = Astro.locals
const isSuperadmin = role === 'superadmin'

if (!user) {
  return Astro.redirect('/auth/login?redirect=/album')
}

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies)

let albumsQuery = supabase
  .from('albums')
  .select('id, slug, name, descripcion, cover_url')
  .eq('active', true)
  .order('created_at', { ascending: true })

// Si el usuario tiene estación (y no es superadmin), filtrar solo su álbum
if (!isSuperadmin && estacion_favorita) {
  albumsQuery = albumsQuery.eq('estacion', estacion_favorita)
}

const { data: albums } = await albumsQuery

// Si hay un solo álbum (o exactamente el de su estación), redirigir directamente
if (albums && albums.length === 1) {
  return Astro.redirect(`/album/${albums[0].slug}`)
}

// Para cada álbum, contar cards del usuario
const albumIds = (albums ?? []).map((a: any) => a.id)
let cardCounts: Record<string, number> = {}
let totalCards: Record<string, number> = {}

if (albumIds.length > 0) {
  const { data: userCards } = await supabase
    .from('user_cards')
    .select('card_id, cards!inner(album_id)')
    .eq('user_id', user.id)

  const { data: allCards } = await supabase
    .from('cards')
    .select('id, album_id')
    .in('album_id', albumIds)
    .eq('active', true)

  for (const album of (albums ?? [])) {
    totalCards[album.id] = (allCards ?? []).filter((c: any) => c.album_id === album.id).length
    cardCounts[album.id] = (userCards ?? []).filter(
      (uc: any) => uc.cards?.album_id === album.id
    ).length
  }
}
---

<Layout title="Mis álbumes — La Fiesta del Fútbol">
  <main class="albums-page">

    <div class="hero">
      <div class="hero-inner">
        <p class="hero-sub">Colección</p>
        <h1 class="hero-title spartan">Mis Álbumes</h1>
      </div>
    </div>

    <div class="content">
      {(!albums || albums.length === 0) ? (
        <div class="empty-state">
          <p>No hay álbumes activos por el momento.</p>
        </div>
      ) : (
        <div class="albums-grid">
          {albums.map((album: any) => {
            const collected = cardCounts[album.id] ?? 0
            const total = totalCards[album.id] ?? 0
            const pct = total > 0 ? Math.round((collected / total) * 100) : 0
            return (
              <a href={`/album/${album.slug}`} class="album-card">
                {album.cover_url && (
                  <img src={album.cover_url} alt={album.name} class="album-cover" />
                )}
                <div class="album-info">
                  <h2 class="spartan">{album.name}</h2>
                  {album.descripcion && <p>{album.descripcion}</p>}
                  <div class="progress-bar">
                    <div class="progress-fill" style={`width: ${pct}%`}></div>
                  </div>
                  <span class="progress-label">{collected} / {total} cards ({pct}%)</span>
                </div>
              </a>
            )
          })}
        </div>
      )}
    </div>

  </main>
</Layout>

<style>
  .albums-page {
    min-height: 100vh;
    background: #1640d8;
  }

  .hero {
    padding: 3rem 1.5rem 2.5rem;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }
  .hero-inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  .hero-sub {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.4);
    margin-bottom: 0.5rem;
    font-family: 'Open Sans', sans-serif;
  }
  .hero-title {
    font-size: clamp(2rem, 6vw, 3.5rem);
    font-weight: 900;
    color: white;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .content {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 4rem;
  }

  .albums-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .album-card {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 1rem;
    overflow: hidden;
    text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s;
    display: block;
  }
  .album-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 30px rgba(0,0,0,0.3);
  }

  .album-cover {
    width: 100%;
    height: 180px;
    object-fit: cover;
  }

  .album-info {
    padding: 1.25rem;
  }

  .album-info h2 {
    font-size: 1.15rem;
    font-weight: 800;
    color: white;
    margin-bottom: 0.4rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .album-info p {
    font-size: 0.875rem;
    color: rgba(255,255,255,0.4);
    margin-bottom: 1rem;
    font-family: 'Open Sans', sans-serif;
  }

  .progress-bar {
    background: rgba(255,255,255,0.1);
    border-radius: 999px;
    height: 4px;
    overflow: hidden;
    margin-bottom: 0.5rem;
  }

  .progress-fill {
    background: #EA262A;
    height: 100%;
    border-radius: 999px;
    transition: width 0.4s;
  }

  .progress-label {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.35);
    font-weight: 600;
    font-family: 'Open Sans', sans-serif;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .empty-state {
    text-align: center;
    color: rgba(255,255,255,0.3);
    padding: 4rem 0;
    font-family: 'Open Sans', sans-serif;
  }
</style>
