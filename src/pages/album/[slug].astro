---
import Layout from '../../layouts/Layout.astro'
import { createSupabaseServerClient } from '../../lib/supabase'

const { slug } = Astro.params
const { user, estacion_favorita, role } = Astro.locals
const isSuperadmin = role === 'superadmin'

if (!user) {
  return Astro.redirect(`/auth/login?redirect=/album/${slug}`)
}

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies)

const [{ data: album }, { data: profile }] = await Promise.all([
  supabase
    .from('albums')
    .select('id, slug, name, descripcion, cover_url, color_acento, color_acento2, color_texto, color_header, color_body, color_fondo_card, color_texto_card, color_texto_header, color_texto_body, logo_url, total_cards, banner_patrocinador_url, estacion')
    .eq('slug', slug)
    .eq('active', true)
    .maybeSingle(),
  supabase
    .from('profiles')
    .select('avatar_url, avatar_face_url')
    .eq('id', user.id)
    .maybeSingle(),
])

if (!album) {
  return Astro.redirect('/album')
}

// Si el álbum tiene estación y el usuario también, validar que coincidan (superadmin puede ver todos)
if (!isSuperadmin && album.estacion && estacion_favorita && album.estacion !== estacion_favorita) {
  return Astro.redirect('/album')
}

const { data: cards } = await supabase
  .from('cards')
  .select('id, name, descripcion, image_url, posicion')
  .eq('album_id', album.id)
  .eq('active', true)
  .order('posicion', { ascending: true })

const cardIds = (cards ?? []).map((c: any) => c.id)
let collectedSet = new Set<string>()

if (cardIds.length > 0) {
  const { data: userCards } = await supabase
    .from('user_cards')
    .select('card_id')
    .eq('user_id', user.id)
    .in('card_id', cardIds)

  collectedSet = new Set((userCards ?? []).map((uc: any) => uc.card_id))
}

const avatarUrl: string | null = profile?.avatar_url ?? null
const avatarFaceUrl: string | null = profile?.avatar_face_url ?? avatarUrl
const hasAvatar = !!avatarUrl

// La carta #01 es el avatar del usuario (cuenta en el total).
// album.total_cards debe incluir esa carta; el fallback suma +1 por el avatar.
const cardsLoaded = (cards ?? []).length
const total = album.total_cards ?? (cardsLoaded + 1)
const collected = collectedSet.size + (hasAvatar ? 1 : 0)
const pct = total > 0 ? Math.round((collected / total) * 100) : 0

const accentColor = album.color_acento ?? '#ff6b35'
const accent2Color = album.color_acento2 ?? accentColor
const textColor = album.color_texto ?? '#ffffff'
const heroColor = album.color_header ?? '#0f1118'
const bodyColor = album.color_body ?? '#0f1118'
const cardBg = album.color_fondo_card ?? '#1c1f28'
const cardText = album.color_texto_card ?? '#ffffff'
const headerText = album.color_texto_header ?? '#ffffff'
const bodyText = album.color_texto_body ?? '#ffffff'
const displayName = user.user_metadata?.full_name ?? user.user_metadata?.name ?? user.email?.split('@')[0] ?? 'Participante'
---

<Layout title={`${album.name} — Mi Álbum`} noWrapper={true}>
  <main class="album-page" style={`--accent: ${accentColor}; --accent2: ${accent2Color}; --accent-glow: ${accentColor}80; --accent-dim: ${accentColor}26; --text-on-accent: ${textColor}; --hero-bg: ${heroColor}; --body-bg: ${bodyColor}; --card-bg: ${cardBg}; --card-text: ${cardText}; --header-text: ${headerText}; --body-text: ${bodyText};`}>

    <!-- Hero -->
    <div class="hero">
      <div class="hero-inner">

        <!-- Perfil + álbum -->
        <div class="hero-top">

          <!-- Avatar del usuario -->
          <a href="/perfil/avatar" class="hero-avatar" title="Editar avatar">
            {avatarUrl ? (
              <img src={avatarFaceUrl} alt={displayName} class="hero-avatar-img" />
            ) : (
              <div class="hero-avatar-empty">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" style="width:2rem;height:2rem;color:rgba(255,255,255,0.25)">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              </div>
            )}
          </a>

          <!-- Divisor -->
          <div class="hero-divider"></div>

          <!-- Nombre + álbum -->
          <div class="hero-meta">
            <p class="hero-username spartan">{displayName}</p>
            <div class="hero-album-row">
              <div>
                <p class="hero-sub">Mi Álbum de {album.name}</p>
                {album.logo_url ? (
                  <img src={album.logo_url} alt={album.name} class="hero-logo" />
                ) : (
                  <h1 class="hero-title spartan">{album.name}</h1>
                )}
              </div>
            </div>
          </div>

          <!-- Banner patrocinador -->
          {album.banner_patrocinador_url && (
            <div class="hero-sponsor">
              <p style="font-family:'Syne',sans-serif;font-size:0.55rem;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;color:rgba(255,255,255,0.25);margin:0">Presentado por:</p>
              <img
                src={album.banner_patrocinador_url}
                alt="Patrocinador"
                class="hero-sponsor-img"
              />
            </div>
          )}

        </div>

        <!-- Progreso -->
        <div class="hero-progress">
          <p class="hero-count">{collected} de {total} estampas ({pct}%)</p>
          <div class="hero-bar">
            <div class="hero-bar-fill" style={`width: ${pct}%`}></div>
          </div>
        </div>

      </div>
    </div>

    <div class="content">

      <!-- Banner principal (cover_url) -->
      {album.cover_url && (
        <div class="promo-banner">
          <img
            src={album.cover_url}
            alt={album.name}
            class="promo-banner-img"
          />
        </div>
      )}

      <!-- Canjear código -->
      <div class="canjear-card">
        <div class="canjear-left">
          <h2 class="spartan">¿Tienes un código?</h2>
          <p>Ingresa tu código y desbloquea una nueva estampa.</p>
        </div>
        <form id="canjear-form" class="canjear-right">
          <input
            id="codigo-input"
            type="text"
            placeholder="Ingresa tu código"
            maxlength="20"
            autocomplete="off"
            spellcheck="false"
          />
          <button type="submit" class="btn-canjear">Canjear</button>
        </form>
        <div id="canjear-resultado" class="canjear-resultado" hidden></div>
      </div>

      <!-- Grid de estampas -->
      <div class="figuritas-grid" id="figuritas-grid"
        data-collected={collected} data-total={total}>

        {/* Carta #01: avatar del usuario (cuenta en el total) */}
        {avatarUrl ? (
          <div
            class="figurita-card obtenida avatar-card"
            data-card-id="avatar"
            data-name="Mi Avatar"
            data-image={avatarUrl}
            data-num="#01"
          >
            <img src={avatarUrl} alt="Mi Avatar" class="card-img avatar-card-img" />
            <div class="card-footer">
              <span class="card-num spartan">#01</span>
              <span class="card-sep">|</span>
              <span class="card-name spartan">Mi Avatar</span>
            </div>
          </div>
        ) : (
          <a href="/perfil/avatar" class="figurita-card bloqueada avatar-card-cta" data-num="#01">
            <div class="card-locked">
              <svg class="lock-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                  d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              <span class="locked-label">Crea tu avatar</span>
            </div>
            <div class="card-footer">
              <span class="card-num spartan">#01</span>
              <span class="card-sep">|</span>
              <span class="card-name spartan">Mi Avatar</span>
            </div>
          </a>
        )}

        {(cards ?? []).map((card: any) => {
          const tiene = collectedSet.has(card.id)
          return (
            <div
              class={`figurita-card ${tiene ? 'obtenida' : 'bloqueada'}`}
              data-card-id={card.id}
              data-name={card.name}
              data-image={card.image_url ?? ''}
              data-num={`#${String(card.posicion).padStart(2, '0')}`}
            >
              {tiene ? (
                <>
                  {card.image_url ? (
                    <img src={card.image_url} alt={card.name} class="card-img" />
                  ) : (
                    <div class="card-img-placeholder"></div>
                  )}
                  <div class="card-footer">
                    <span class="card-num spartan">#{String(card.posicion).padStart(2, '0')}</span>
                    <span class="card-sep">|</span>
                    <span class="card-name spartan">{card.name}</span>
                  </div>
                </>
              ) : (
                <div class="card-locked">
                  <svg class="lock-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                      d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span class="locked-label">Estampa bloqueada</span>
                </div>
              )}
            </div>
          )
        })}
      </div>
      <div class="ganador"><h3>🏆 ¡LLEGÓ EL MOMENTO FINAL DE LA FIESTA DEL FÚTBOL! ⚽🔥</h3>

<p>El Mundial termina este fin de semana y hoy liberamos el ÚLTIMO CÓDIGO de nuestro álbum. ¡Gracias infinitas a todos los que jugaron y vibraron con nosotros! 🙌</p>

<p>¡Atención! Solo tendremos un gran ganador absoluto. Los primeros en completar su álbum participan por 6 meses de conciertos gratis. Se contactará a los finalistas en estricto orden de llenado y se irán descartando si no responden correctamente. Para reclamar el premio hay que responder una pregunta de fútbol. No es suerte — es conocimiento. 🧠🎸</p>

<p>¡Sintoniza tu emisora favorita y caza ese último código ya! 📻✨ #LaFiestaDelFutbol  #UltimoCódigo</p>
</div>

    </div>

    <!-- Modal figurita -->
    <div id="card-modal" class="card-modal" hidden>
      <div class="card-modal-backdrop"></div>
      <div class="card-modal-box">
        <button class="card-modal-close" id="card-modal-close" aria-label="Cerrar">✕</button>
        <img id="modal-img" class="card-modal-img" src="" alt="" />
        <div class="card-modal-footer">
          <span id="modal-num" class="card-modal-num spartan"></span>
          <span class="card-modal-sep">|</span>
          <span id="modal-name" class="card-modal-name spartan"></span>
        </div>
      </div>
    </div>

  </main>

</Layout>

<script>
  const form = document.getElementById('canjear-form') as HTMLFormElement
  const input = document.getElementById('codigo-input') as HTMLInputElement
  const resultado = document.getElementById('canjear-resultado') as HTMLDivElement
  const grid = document.getElementById('figuritas-grid') as HTMLDivElement

  function unlockCard(cardId: string, cardName: string, cardImage: string) {
    const slot = grid?.querySelector<HTMLDivElement>(`[data-card-id="${cardId}"]`)
    if (!slot) return

    slot.classList.remove('bloqueada')
    slot.classList.add('obtenida', 'nueva')

    // Reemplazar contenido de la tarjeta
    const locked = slot.querySelector('.card-locked')
    if (locked) {
      const imgHtml = cardImage
        ? `<img src="${cardImage}" alt="${cardName}" class="card-img" />`
        : `<div class="card-img-placeholder"></div>`
      const num = slot.dataset.num ?? ''
      locked.outerHTML = `${imgHtml}<div class="card-footer"><span class="card-num spartan">${num}</span><span class="card-sep">|</span><span class="card-name spartan">${cardName}</span></div>`
    }

    // Badge "NUEVA"
    const badge = document.createElement('span')
    badge.className = 'nueva-badge'
    badge.textContent = 'NUEVA'
    slot.appendChild(badge)

    const collected = parseInt(grid.dataset.collected ?? '0') + 1
    const total = parseInt(grid.dataset.total ?? '0')
    grid.dataset.collected = String(collected)
    const pct = total > 0 ? Math.round((collected / total) * 100) : 0

    const fill = document.querySelector<HTMLDivElement>('.hero-bar-fill')
    if (fill) fill.style.width = `${pct}%`
    const count = document.querySelector('.hero-count')
    if (count) count.textContent = `${collected} de ${total} estampas (${pct}%)`

    setTimeout(() => {
      slot.scrollIntoView({ behavior: 'smooth', block: 'center' })
      setTimeout(() => {
        slot.classList.remove('nueva')
        badge.classList.add('nueva-badge-out')
        setTimeout(() => badge.remove(), 400)
      }, 3500)
    }, 300)
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault()
    const code = input.value.trim()
    if (!code) return

    const btn = form.querySelector('button') as HTMLButtonElement
    btn.disabled = true
    btn.textContent = 'Canjeando...'
    resultado.hidden = true

    try {
      const res = await fetch('/api/album/redimir', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ code }),
      })
      const data = await res.json()

      resultado.hidden = false
      if (data.ok) {
        resultado.className = 'canjear-resultado exito'
        resultado.innerHTML = `¡Estampa <strong>${data.card_name}</strong> desbloqueada!`
        input.value = ''
        unlockCard(data.card_id, data.card_name, data.card_image ?? '')
      } else {
        resultado.className = 'canjear-resultado error'
        resultado.textContent = data.error ?? 'No se pudo canjear el código.'
      }
    } catch {
      resultado.hidden = false
      resultado.className = 'canjear-resultado error'
      resultado.textContent = 'Error de conexión. Intenta de nuevo.'
    } finally {
      btn.disabled = false
      btn.textContent = 'Canjear'
    }
  })

  // ---- Modal de figurita ----
  const modal = document.getElementById('card-modal') as HTMLDivElement
  const modalImg = document.getElementById('modal-img') as HTMLImageElement
  const modalName = document.getElementById('modal-name') as HTMLSpanElement
  const modalNum = document.getElementById('modal-num') as HTMLDivElement
  const modalClose = document.getElementById('card-modal-close') as HTMLButtonElement
  const modalBackdrop = modal?.querySelector('.card-modal-backdrop') as HTMLDivElement

  function openModal(name: string, image: string, num: string) {
    if (!modal) return
    modalImg.src = image
    modalImg.alt = name
    modalImg.hidden = !image
    modalName.textContent = name
    modalNum.textContent = num
    modal.removeAttribute('hidden')
    document.body.style.overflow = 'hidden'
  }

  function closeModal() {
    modal?.setAttribute('hidden', '')
    document.body.style.overflow = ''
  }

  modalClose?.addEventListener('click', closeModal)
  modalBackdrop?.addEventListener('click', closeModal)
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal() })

  // Click en figuritas obtenidas
  grid?.addEventListener('click', (e) => {
    const card = (e.target as HTMLElement).closest<HTMLDivElement>('.figurita-card.obtenida')
    if (!card) return
    const name = card.dataset.name ?? ''
    const image = card.dataset.image ?? ''
    const num = card.dataset.num ?? ''
    openModal(name, image, num)
  })
</script>

<style>
  /* Naranja accent */
  :root {
    --accent: #ff6b35;
    --accent-glow: rgba(255, 107, 53, 0.5);
    --accent-dim: rgba(255, 107, 53, 0.15);
  }

  .album-page {
    min-height: 100vh;
    background: var(--body-bg);
  }

  /* Hero */
  .hero {
    padding: 3rem 1.5rem 3rem;
    background: var(--hero-bg);
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }
  .hero-inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  /* Hero top: avatar + divisor + meta */
  .hero-top {
    display: flex;
    align-items: center;
    gap: 0;
    margin-bottom: 2.5rem;
  }

  /* Avatar — headshot (solo cara, sin fondo ni marco) */
  .hero-avatar {
    flex-shrink: 0;
    display: block;
    width: 110px;
    height: 110px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid rgba(255,255,255,0.12);
    background: radial-gradient(circle at 50% 35%, var(--accent-dim), rgba(255,255,255,0.03) 70%);
    text-decoration: none;
    transition: border-color 0.2s, box-shadow 0.2s;
    box-shadow: 0 6px 24px rgba(0,0,0,0.5);
  }
  .hero-avatar:hover {
    border-color: var(--accent);
    box-shadow: 0 6px 24px rgba(0,0,0,0.5), 0 0 20px var(--accent-glow);
  }
  .hero-avatar-img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center 18%;
    display: block;
  }
  .hero-avatar-empty {
    width: 100%; height: 100%;
    background: rgba(255,255,255,0.04);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Divisor vertical */
  .hero-divider {
    width: 1px;
    height: 90px;
    background: rgba(255,255,255,0.1);
    margin: 0 2rem;
    flex-shrink: 0;
  }

  /* Meta */
  .hero-meta { flex: 1; }
  .hero-username {
    font-size: clamp(1.1rem, 3vw, 1.5rem);
    font-weight: 700;
    color: var(--header-text);
    margin-bottom: 0.9rem;
    letter-spacing: -0.01em;
    line-height: 1;
  }
  .hero-album-row { display: flex; align-items: flex-end; gap: 1.5rem; }
  .hero-sub {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.25);
    margin-bottom: 0.3rem;
    font-family: 'Syne', sans-serif;
  }
  .hero-title {
    font-size: clamp(2rem, 7vw, 4.5rem);
    font-weight: 900;
    color: var(--header-text);
    line-height: 0.9;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }
  .hero-logo {
    height: clamp(2rem, 6vw, 3.5rem);
    width: auto;
    display: block;
    object-fit: contain;
    background: white;
    border-radius: 8px;
    padding: 0.3rem 0.6rem;
  }

  /* Progreso */
  .hero-progress { }
  .hero-count {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.35);
    margin-bottom: 0.6rem;
    font-family: 'Syne', sans-serif;
  }
  .hero-bar {
    height: 5px;
    background: rgba(255,255,255,0.08);
    border-radius: 999px;
    overflow: hidden;
  }
  .hero-bar-fill {
    height: 100%;
    background: var(--accent);
    border-radius: 999px;
    transition: width 0.6s ease;
    box-shadow: 0 0 10px var(--accent-glow);
  }

  /* Content */
  .content {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 5rem;
  }

  /* Banner patrocinador en el hero */
  .hero-sponsor {
    margin-left: auto;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.4rem;
  }
  .hero-sponsor-label {
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.25);
    font-family: 'Syne', sans-serif !important;
  }
  .hero-sponsor-img {
    height: clamp(3rem, 8vw, 5rem);
    max-width: 200px;
    width: auto;
    object-fit: contain;
    border-radius: 0.5rem;
    background: white;
    padding: 0.4rem 0.75rem;
  }

  @media (max-width: 640px) {
    .hero-sponsor { display: none; }
  }

  /* Banner promocional */
  .promo-banner {
    margin-bottom: 1.5rem;
    border-radius: 0.75rem;
    overflow: hidden;
  }
  .promo-banner-img {
    width: 100%;
    display: block;
  }

  /* Canjear */
  .canjear-card {
    background: var(--accent-dim);
    border: 1px solid var(--accent-glow);
    border-radius: 1.25rem;
    padding: 1.75rem 2rem;
    margin-bottom: 3rem;
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .canjear-left {
    flex: 1;
    min-width: 180px;
  }
  .canjear-left h2 {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--body-text);
    margin-bottom: 0.3rem;
  }
  .canjear-left p {
    font-size: 0.8rem;
    color: var(--body-text);
    opacity: 0.6;
    font-family: 'Syne', sans-serif;
  }
  .canjear-right {
    display: flex;
    gap: 0.6rem;
    flex: 1;
    min-width: 260px;
  }
  .canjear-right input {
    flex: 1;
    background: rgba(255,255,255,0.75);
    border: 1.5px solid var(--accent);
    border-radius: 0.6rem;
    padding: 0.75rem 1rem;
    font-size: 0.95rem;
    font-family: 'Syne', sans-serif;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #111;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .canjear-right input::placeholder { color: rgba(0,0,0,0.3); }
  .canjear-right input:focus {
    background: white;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-dim);
  }
  .btn-canjear {
    background: linear-gradient(135deg, var(--accent2), var(--accent));
    color: var(--text-on-accent);
    border: none;
    padding: 0.75rem 1.75rem;
    border-radius: 0.6rem;
    font-weight: 800;
    font-size: 0.9rem;
    font-family: 'League Spartan', sans-serif;
    cursor: pointer;
    letter-spacing: 0.04em;
    transition: box-shadow 0.2s, transform 0.15s;
    white-space: nowrap;
    box-shadow: 0 0 20px var(--accent-glow), 0 2px 10px rgba(0,0,0,0.4);
  }
  .btn-canjear:hover {
    box-shadow: 0 0 36px rgba(255,107,53,0.75), 0 4px 16px rgba(0,0,0,0.4);
    transform: translateY(-2px);
  }
  .btn-canjear:disabled { opacity: 0.35; cursor: not-allowed; box-shadow: none; transform: none; }

  .canjear-resultado {
    width: 100%;
    padding: 0.65rem 1rem;
    border-radius: 0.6rem;
    font-size: 0.875rem;
    font-family: 'Syne', sans-serif;
    margin-top: -0.5rem;
  }
