---
import Layout from '../../layouts/Layout.astro'
import { createSupabaseAdminClient } from '../../lib/supabase'
import MoreNews from '../../components/MoreNews.astro'

const { slug } = Astro.params
const supabase = createSupabaseAdminClient()

const { data: entrada } = await supabase
  .from('analisis')
  .select('titulo, cuerpo, publicado_en')
  .eq('slug', slug!)
  .lte('publicado_en', new Date().toISOString())
  .single()

if (!entrada) return Astro.redirect('/resumen-de-analisis')

const fechaFormateada = new Date(entrada.publicado_en).toLocaleDateString('es-MX', {
  weekday: 'long', day: 'numeric', month: 'long', year: 'numeric'
})
---

<Layout title={`${entrada.titulo} - Resumen de Análisis`}>
  <div class="container my-12 mx-auto px-4 md:px-12">
    <div class="flex flex-col lg:flex-row gap-8">
      <article class="w-full flex-1 min-w-0">
        <a href="/resumen-de-analisis" class="breadcrumb">← Resumen de Análisis</a>
        <p class="fecha">{fechaFormateada}</p>
        <h1 class="titulo">{entrada.titulo}</h1>
        <div class="cuerpo" set:html={entrada.cuerpo} />
      </article>

      <aside class="w-full lg:w-[350px] flex-shrink-0">
        <div class="bg-white p-5 rounded-xl sticky top-4">
          <MoreNews />
        </div>
      </aside>
    </div>
  </div>
</Layout>

<style>
  article {
    background: white;
    border-radius: 0.75rem;
    padding: 2rem 2.5rem;
    box-shadow: 0 1px 4px rgba(0,0,0,0.06);
  }

  .breadcrumb {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--rojo);
    text-decoration: none;
    margin-bottom: 1rem;
  }

  .breadcrumb:hover { opacity: 0.75; }

  .fecha {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #999;
    margin-bottom: 0.5rem;
  }

  .titulo {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--morado);
    line-height: 1.3;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 3px solid var(--rojo);
  }

  .cuerpo { line-height: 1.8; color: #333; font-size: 1rem; }

  .cuerpo :global(h2) {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--morado);
    margin: 2rem 0 0.75rem;
    padding-left: 0.85rem;
    border-left: 4px solid var(--rojo);
    line-height: 1.3;
  }

  .cuerpo :global(h3) {
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--rojo);
    margin: 1.75rem 0 0.6rem;
    padding-bottom: 0.4rem;
    border-bottom: 2px solid #f0f0f0;
  }

  .cuerpo :global(p) { margin-bottom: 1rem; }
  .cuerpo :global(ul) { list-style: disc; padding-left: 1.5rem; margin: 0.75rem 0; }
  .cuerpo :global(ol) { list-style: decimal; padding-left: 1.5rem; margin: 0.75rem 0; }
  .cuerpo :global(li) { margin-bottom: 0.4rem; }
  .cuerpo :global(strong) { font-weight: 700; color: #111; }
  .cuerpo :global(em) { font-style: italic; color: #555; }
  .cuerpo :global(hr) {
    border: none;
    border-top: 3px solid var(--rojo);
    margin: 2rem 0;
    opacity: 0.15;
  }
</style>
