---
import Layout from '../../layouts/Layout.astro'
import { createSupabaseAdminClient } from '../../lib/supabase'
import MoreNews from '../../components/MoreNews.astro'
import LeaderBoard from '../../components/LeaderBoard.astro'

const supabase = createSupabaseAdminClient()
const { data: entradas } = await supabase
  .from('analisis')
  .select('id, titulo, slug, cuerpo, publicado_en')
  .lte('publicado_en', new Date().toISOString())
  .order('publicado_en', { ascending: false })
---

<Layout title="Resumen de Análisis - La Fiesta del Fútbol">
  <div class="container my-12 mx-auto px-4 md:px-12">
    <LeaderBoard />
    <h1 class="titulos rojo uppercase goodtime text-center p-4 my-4 text-2xl lg:text-3xl font-bold">
      Resumen de Análisis
    </h1>

    <div class="flex flex-col lg:flex-row gap-8">
      <div class="w-full flex-1 min-w-0">
        {(!entradas || entradas.length === 0) ? (
          <div class="empty">
            <p>Próximamente los análisis del torneo.</p>
          </div>
        ) : (
          <div class="lista">
            {entradas.map((e: any) => {
              const texto = e.cuerpo.replace(/<[^>]+>/g, '').slice(0, 180)
              return (
                <a href={`/resumen-de-analisis/${e.slug}`} class="card">
                  <div class="card-fecha">
                    {new Date(e.publicado_en).toLocaleDateString('es-MX', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })}
                  </div>
                  <h2 class="card-titulo">{e.titulo}</h2>
                  <p class="card-preview">{texto}…</p>
                  <span class="card-leer">Leer análisis →</span>
                </a>
              )
            })}
          </div>
        )}
      </div>

      <aside class="w-full lg:w-[350px] flex-shrink-0">
        <div class="bg-white p-5 rounded-xl sticky top-4">
          <MoreNews />
        </div>
      </aside>
    </div>
  </div>
</Layout>

<style>
  .lista { display: flex; flex-direction: column; gap: 1.25rem; }

  .card {
    display: block;
    background: white;
    border-radius: 0.75rem;
    padding: 1.5rem;
    text-decoration: none;
    box-shadow: 0 1px 4px rgba(0,0,0,0.06);
    border-left: 4px solid var(--rojo);
    transition: box-shadow 0.2s, transform 0.2s;
  }

  .card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.1); transform: translateY(-1px); }

  .card-fecha {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #999;
    margin-bottom: 0.5rem;
  }

  .card-titulo {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--morado);
    margin-bottom: 0.5rem;
    line-height: 1.4;
  }

  .card-preview {
    font-size: 0.9rem;
    color: #666;
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }

  .card-leer {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--rojo);
  }

  .empty {
    text-align: center;
    padding: 4rem 0;
    color: #aaa;
    font-size: 1.1rem;
  }
</style>
