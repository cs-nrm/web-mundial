---
import Layout from '../../layouts/Layout.astro'
import MoreNews from '../../components/MoreNews.astro'
import LeaderBoard from "../../components/LeaderBoard.astro";
import IframeDF from '../../components/IframeDF.astro';
---
<Layout title="Estadísticas Generales - Data Factory">
  <div class="container my-12 mx-auto px-4 md:px-12">
    <LeaderBoard />
    <h1 class="titulos rojo uppercase goodtime text-center p-4 my-4 text-2xl lg:text-3xl font-bold ">Estadísticas Generales</h1>
    <div class="flex flex-col lg:flex-row gap-8">
      <div class="w-full flex-1 min-w-0">
        <IframeDF
          src="https://enfoquenoticias.com.mx/df/html/v3/minapp/page/page.html?channel=deportes.futbol.mundial&lang=es_LA&page=posiciones"
          minHeight={1800}
          title="Estadísticas Generales"
        />
      </div>
      <aside class="w-full lg:w-[350px] flex-shrink-0 min-w-[0]">
        <div class="bg-white p-5 rounded-xl sticky top-4">
          <!--BoxBanner />
          <div class="my-6 h-px bg-gray-200"></div-->
          <MoreNews />
          <!--DoubleBox /-->
        </div>
      </aside>
    </div>
  </div>
</Layout>

