---
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Son Sonidero En Vivo" description={SITE_DESCRIPTION}>
  <div class="container m-auto">
    <img src="https://storage.googleapis.com/nrm-web/sabrosita/SON-SONIDERO-LOGO-pantalla.png" alt="Son Sonidero" class="w-full h-auto max-w-[400px] m-auto mb-4" />
    <div style="padding:56.25% 0 0 0;position:relative;">
      <iframe src="https://vimeo.com/event/5502578/embed" frameborder="0" allow="autoplay; fullscreen; picture-in-picture; encrypted-media; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen style="position:absolute;top:0;left:0;width:100%;height:100%;"></iframe>
    </div>
    <div class="my-8">
      <iframe src="https://vimeo.com/live/interaction_tools/live_event/5502578?theme=light" width="100%" height="800" frameborder="0"></iframe>
    </div>
  </div>
</Layout>




