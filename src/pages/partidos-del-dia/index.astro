---
import Layout from '../../layouts/Layout.astro'
import MoreNews from '../../components/MoreNews.astro'
import { getArticles } from '../../lib/api.js'
import { wpSiteGamecastConfig } from '../../config/sites.js'
import { getFlagUrl } from '../../lib/flags.js'
import LeaderBoard from "../../components/LeaderBoard.astro";
const allPosts = await getArticles(undefined, { sites: [wpSiteGamecastConfig.url] })

const today = new Date().toISOString().slice(0, 10)
const posts = (allPosts ?? [])
  .filter(p => p.acf?.fecha?.slice(0, 10) === today)
  .sort((a, b) => (a.acf?.fecha ?? '').localeCompare(b.acf?.fecha ?? ''))

function formatFecha(fecha: string | null | undefined) {
  if (!fecha) return null
  const d = new Date(fecha.replace(' ', 'T'))
  return d.toLocaleDateString('es-MX', {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
    hour: '2-digit',
    minute: '2-digit',
  })
}
---

<Layout title="Gamecast · La Fiesta del Fútbol">
  <div class="container my-12 mx-auto px-4 md:px-12">
    <LeaderBoard />
    <h1 class="titulos rojo uppercase goodtime text-center p-4 my-4 text-2xl lg:text-3xl font-bold">
      Partidos del día
    </h1>

    <div class="flex flex-col lg:flex-row gap-8">

      <div class="flex-1 min-w-0">
        {posts.length > 0 ? (
          <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
            {posts.map((post) => {
              const pais1 = post.acf?.pais1
              const pais2 = post.acf?.pais2
              const flag1 = getFlagUrl(pais1, 80)
              const flag2 = getFlagUrl(pais2, 80)
              const fechaFormateada = formatFecha(post.acf?.fecha)
              const sede = post.acf?.sede
              const previa = post.acf?.previa

              return (
                <a href={`/partidos-del-dia/${post.slug}/`} class="group">
                  <div class="gamecast-card rounded-xl bg-black text-white p-5 h-full flex flex-col gap-3 justify-between hover:bg-neutral-900 transition-colors">
                    {fechaFormateada && (
                      <p class="text-xs text-neutral-400 uppercase tracking-widest">{fechaFormateada}</p>
                    )}
                    <div class="flex items-center justify-between gap-2">
                      <div class="flex flex-col items-center gap-2 text-center w-5/12">
                        {flag1
                          ? <img src={flag1} alt={pais1} class="w-14 h-auto rounded-sm shadow" />
                          : <span class="text-3xl">🏳️</span>
                        }
                        <span class="text-sm font-semibold leading-tight">{pais1}</span>
                      </div>
                      <span class="goodtime font-bold text-xl text-white">VS</span>
                      <div class="flex flex-col items-center gap-2 text-center w-5/12">
                        {flag2
                          ? <img src={flag2} alt={pais2} class="w-14 h-auto rounded-sm shadow" />
                          : <span class="text-3xl">🏳️</span>
                        }
                        <span class="text-sm font-semibold leading-tight">{pais2}</span>
                      </div>
                    </div>
                    {sede && (
                      <p class="text-xs text-neutral-400 uppercase tracking-widest" set:html={sede}></p>
                    )}
                    <div class="flex flex-col gap-1">
                      {previa && (
                        <span onclick={`event.preventDefault();event.stopPropagation();window.location.href='${previa}'`}
                          class="text-xs text-[#7af12b] font-bold uppercase tracking-wide cursor-pointer hover:underline">
                          Previa del partido →
                        </span>
                      )}
                      <span class="text-xs text-white font-bold uppercase tracking-wide hover:underline">
                        Minuto a Minuto →
                      </span>
                    </div>
                  </div>
                </a>
              )
            })}
          </div>
        ) : (
          <p class="text-center text-gray-400 py-16">No hay partidos programados para hoy.</p>
        )}
      </div>

      <aside class="w-full lg:w-[350px] flex-shrink-0">
        <div class="bg-white p-5 rounded-xl sticky top-4">
          <MoreNews />
        </div>
      </aside>

    </div>
  </div>
</Layout>
