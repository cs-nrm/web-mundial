---
import Layout from '../../layouts/Layout.astro'
import MoreNews from '../../components/MoreNews.astro'
import LeaderBoard from '../../components/LeaderBoard.astro'
import { createSupabaseAdminClient } from '../../lib/supabase'
import { getFlagUrl } from '../../lib/flags.js'

const supabase = createSupabaseAdminClient()

// Ventana de 3 días en CDMX (ayer, hoy, mañana)
const now = new Date()
const cdmxNow = new Date(now.getTime() - 6 * 60 * 60_000)
const ayer         = new Date(cdmxNow.getTime() - 24 * 60 * 60_000).toISOString().slice(0, 10)
const manana       = new Date(cdmxNow.getTime() + 24 * 60 * 60_000).toISOString().slice(0, 10)
const pasadoManana = new Date(cdmxNow.getTime() + 48 * 60 * 60_000).toISOString().slice(0, 10)

const [{ data: matches = [] }, { data: previasRaw = [] }] = await Promise.all([
  supabase.from('df_partidos').select('*')
    .gte('fecha_utc', `${ayer}T06:00:00Z`)
    .lt('fecha_utc',  `${pasadoManana}T06:00:00Z`)
    .order('fecha_utc', { ascending: true }),
  supabase.from('analisis').select('slug, partido_slug').not('partido_slug', 'is', null),
])

// Mapa partido_slug → slug de análisis para lookup O(1)
const previaMap = new Map((previasRaw ?? []).map(a => [a.partido_slug, a.slug]))

function formatFecha(fechaUtc: string) {
  return new Date(fechaUtc).toLocaleDateString('es-MX', {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
    hour: '2-digit',
    minute: '2-digit',
    timeZone: 'UTC',
  })
}

function diaLabel(fechaUtc: string) {
  const d = new Date(fechaUtc)
  const cdmx = new Date(d.getTime() - 6 * 60 * 60_000)
  const hoyStr = cdmxNow.toISOString().slice(0, 10)
  const diaStr = cdmx.toISOString().slice(0, 10)
  if (diaStr === hoyStr) return 'Hoy'
  if (diaStr === ayer) return 'Ayer'
  if (diaStr === manana) return 'Mañana'
  return d.toLocaleDateString('es-MX', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'America/Mexico_City' })
}

// Agrupar por día
const days: Record<string, typeof matches> = {}
for (const m of (matches ?? [])) {
  const cdmx = new Date(new Date(m.fecha_utc).getTime() - 6 * 60 * 60_000)
  const key = cdmx.toISOString().slice(0, 10)
  if (!days[key]) days[key] = []
  days[key].push(m)
}
---

<Layout title="Partidos del día · La Fiesta del Fútbol">
  <div class="container my-12 mx-auto px-4 md:px-12">
    <LeaderBoard />
    <h1 class="titulos rojo uppercase goodtime text-center p-4 my-4 text-2xl lg:text-3xl font-bold">
      Partidos del día
    </h1>

    <div class="flex flex-col lg:flex-row gap-8">
      <div class="flex-1 min-w-0">

        {Object.keys(days).length === 0 ? (
          <p class="text-center text-gray-400 py-16">Sin partidos para estos días.</p>
        ) : (
          Object.entries(days).map(([dayKey, dayMatches]) => (
            <div class="mb-10" id={`partidos-widget`}>
              <h2 class="text-sm font-bold uppercase tracking-widest text-gray-400 mb-4 px-1">
                {diaLabel(dayMatches[0].fecha_utc)}
              </h2>
              <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
                {dayMatches.map(m => {
                  const flag1 = getFlagUrl(m.equipo_local, 80)
                  const flag2 = getFlagUrl(m.equipo_visitante, 80)
                  return (
                    <a
                      href={`/partidos-del-dia/${m.slug}/`}
                      class="group"
                      data-match-id={m.match_id}
                    >
                      <div class={`gamecast-card rounded-xl bg-black text-white p-5 h-full flex flex-col gap-3 justify-between hover:bg-neutral-900 transition-colors border ${m.status === 'en_vivo' ? 'border-red-800' : 'border-transparent'}`}>
                        <div class="flex items-center justify-between">
                          <p class="text-xs text-neutral-400 uppercase tracking-widest">
                            {formatFecha(m.fecha_utc)}
                          </p>
                          {m.status === 'en_vivo' && (
                            <span class="live-pill">EN VIVO</span>
                          )}
                          {m.status === 'finalizado' && (
                            <span class="final-pill">Final</span>
                          )}
                        </div>

                        <div class="flex items-center justify-between gap-2">
                          <div class="flex flex-col items-center gap-2 text-center w-5/12">
                            {flag1
                              ? <img src={flag1} alt={m.equipo_local} class="w-14 h-auto rounded-sm shadow" />
                              : <span class="text-3xl">🏳️</span>
                            }
                            <span class="text-sm font-semibold leading-tight">{m.equipo_local}</span>
                          </div>

                          <div class="flex flex-col items-center gap-1">
                            {m.status !== 'programado'
                              ? (
                                <span class="goodtime font-bold text-2xl text-white">
                                  {m.score_local} - {m.score_visitante}
                                </span>
                              )
                              : <span class="goodtime font-bold text-xl text-white">VS</span>
                            }
                          </div>

                          <div class="flex flex-col items-center gap-2 text-center w-5/12">
                            {flag2
                              ? <img src={flag2} alt={m.equipo_visitante} class="w-14 h-auto rounded-sm shadow" />
                              : <span class="text-3xl">🏳️</span>
                            }
                            <span class="text-sm font-semibold leading-tight">{m.equipo_visitante}</span>
                          </div>
                        </div>

                        {m.sede && (
                          <p class="text-xs text-neutral-400 uppercase tracking-widest">{m.sede}</p>
                        )}

                        <div class="flex items-center justify-between gap-2 mt-1">
                          <span class="text-xs text-white font-bold uppercase tracking-wide hover:underline">
                            Minuto a Minuto →
                          </span>
                          {previaMap.has(m.slug) && (
                            <a
                              href={`/resumen-de-analisis/${previaMap.get(m.slug)}/`}
                              class="previa-link"
                              onclick="event.stopPropagation()"
                            >
                              Previa →
                            </a>
                          )}
                        </div>
                      </div>
                    </a>
                  )
                })}
              </div>
            </div>
          ))
        )}
      </div>

      <aside class="w-full lg:w-[350px] flex-shrink-0">
        <div class="bg-white p-5 rounded-xl sticky top-4">
          <MoreNews />
        </div>
      </aside>
    </div>
  </div>
</Layout>

<script>
// Polling de scores en vivo cada 30s
async function pollScores() {
  try {
    const res = await fetch('/api/partidos')
    if (!res.ok) return
    const matches: any[] = await res.json()
    const map = new Map(matches.map((m: any) => [m.match_id, m]))

    document.querySelectorAll<HTMLElement>('[data-match-id]').forEach(card => {
      const m = map.get(card.dataset.matchId!)
      if (!m) return

      const scoreEl = card.querySelector<HTMLElement>('.goodtime')
      if (!scoreEl) return

      if (m.status !== 'programado') {
        scoreEl.textContent = `${m.score_local} - ${m.score_visitante}`
      }
    })
  } catch { /* silent */ }
}

setInterval(pollScores, 30_000)
</script>

<style>
.live-pill {
  font-size: 0.6rem;
  font-weight: 800;
  letter-spacing: 0.1em;
  color: #ea262a;
  text-transform: uppercase;
  display: flex;
  align-items: center;
  gap: 0.3rem;
  animation: pulse-live 2s infinite;
}
.live-pill::before {
  content: '';
  display: inline-block;
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: #ea262a;
}
@keyframes pulse-live {
  0%, 100% { opacity: 1; }
  50%       { opacity: 0.5; }
}

.previa-link {
  font-size: 0.6rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #facc15;
  text-decoration: none;
  border: 1px solid rgba(250,204,21,0.4);
  border-radius: 4px;
  padding: 2px 6px;
  white-space: nowrap;
  transition: background 0.15s;
}
.previa-link:hover { background: rgba(250,204,21,0.15); }

.final-pill {
  font-size: 0.6rem;
  font-weight: 700;
  color: rgba(255,255,255,0.3);
  text-transform: uppercase;
  letter-spacing: 0.08em;
}
</style>
