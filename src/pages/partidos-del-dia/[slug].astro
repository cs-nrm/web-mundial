---
import Layout from "../../layouts/Layout.astro";
import BoxBanner from "../../components/BoxBanner.astro";
import MoreNews from "../../components/MoreNews.astro";
import DoubleBox from "../../components/DoubleBox.astro";
import { wpSiteGamecastConfig } from "../../config/sites.js";
import { getFlagUrl } from "../../lib/flags.js";

const { slug } = Astro.params;

async function findPostBySlug(slug: string) {
    try {
        const parsed = new URL(wpSiteGamecastConfig.url);
        const fields = parsed.searchParams.get('_fields') || '';
        if (fields && !fields.includes('content')) {
            parsed.searchParams.set('_fields', fields + ',content');
        }
        parsed.searchParams.set('slug', slug);

        const res = await fetch(parsed.toString());
        if (!res.ok) return null;
        const data = await res.json();
        return data?.[0] ?? null;
    } catch (err) {
        console.error(`gamecast [slug]: error buscando ${slug}`, err);
        return null;
    }
}

const post = await findPostBySlug(slug!);

if (!post) return Astro.redirect('/404');

const pais1 = post.acf?.pais1;
const pais2 = post.acf?.pais2;
const flag1 = getFlagUrl(pais1, 160);
const flag2 = getFlagUrl(pais2, 160);

const fecha = post.acf?.fecha
    ? new Date(post.acf.fecha.replace(' ', 'T')).toLocaleDateString('es-MX', {
          weekday: 'long',
          day: 'numeric',
          month: 'long',
          hour: '2-digit',
          minute: '2-digit',
          timeZone: 'America/Mexico_City',
      })
    : null;

const PLACEHOLDER_IMG = 'https://storage.googleapis.com/nrm-web/mundial/balon1.jpg';
const featuredImage =
    post.yoast_head_json?.og_image?.[0]?.url ||
    post._embedded?.['wp:featuredmedia']?.[0]?.source_url ||
    PLACEHOLDER_IMG;
---

<Layout
    title={post.title.rendered}
    img={featuredImage}
    tags={post.yoast_head_json}
    description={post.yoast_head_json?.og_description}
>
    <section class="w-full py-4 poppins" id="content-gamecast">
        <div class="container my-12 mx-auto px-4 md:px-12">

            <!-- Cabecera del partido -->
            <div class="bg-black text-white rounded-2xl p-6 mb-8 flex flex-col items-center gap-4">
                {fecha && (
                    <p class="text-xs uppercase tracking-widest text-neutral-400">{fecha}</p>
                )}
                <div class="flex items-center justify-center gap-6 w-full">
                    <div class="flex flex-col items-center gap-2 w-2/5 text-center">
                        {flag1
                            ? <img src={flag1} alt={pais1} class="w-20 h-auto rounded shadow-lg" />
                            : <span class="text-5xl">🏳️</span>
                        }
                        <span class="font-bold text-lg leading-tight">{pais1}</span>
                    </div>
                    <span class="goodtime font-bold text-2xl text-white">VS</span>
                    <div class="flex flex-col items-center gap-2 w-2/5 text-center">
                        {flag2
                            ? <img src={flag2} alt={pais2} class="w-20 h-auto rounded shadow-lg" />
                            : <span class="text-5xl">🏳️</span>
                        }
                        <span class="font-bold text-lg leading-tight">{pais2}</span>
                    </div>
                </div>
            </div>

            <div class="flex flex-col lg:flex-row gap-8">
                <article class="nota-interna flex-1 text-lg leading-relaxed text-gray-800 bg-white rounded-xl p-6 shadow-md">
                    <div class="prose max-w-none" set:html={post.content.rendered} />
                </article>

                <aside class="w-full lg:w-[350px] flex-shrink-0">
                    <div class="bg-white p-5 rounded-xl sticky top-4">
                        <BoxBanner />
                        <div class="my-6 h-px bg-gray-200"></div>
                        <MoreNews />
                        <DoubleBox />
                    </div>
                </aside>
            </div>

        </div>
    </section>
</Layout>

<style is:global>
    .nota-interna p { margin-bottom: 1.5em; }
    .nota-interna h2 { font-size: 1.5em; font-weight: bold; margin-top: 1.5em; margin-bottom: 0.5em; }
    .nota-interna h3 { font-size: 1.25em; font-weight: bold; margin-top: 1.2em; margin-bottom: 0.5em; }
    .nota-interna ul { list-style-type: disc; padding-left: 1.5em; margin-bottom: 1.5em; }
    .nota-interna a { color: #ea262a; text-decoration: underline; }
    .nota-interna img { max-width: 100%; height: auto; border-radius: 8px; margin: 1em 0; }
    .nota-interna iframe { max-width: 100%; margin: 1em 0; }
</style>
