---
import Layout from '../../layouts/Layout.astro'
import BoxBanner from '../../components/BoxBanner.astro'
import MoreNews from '../../components/MoreNews.astro'
import DoubleBox from '../../components/DoubleBox.astro'
import LeaderBoard from '../../components/LeaderBoard.astro'
import { createSupabaseAdminClient } from '../../lib/supabase'
import { getFlagUrl } from '../../lib/flags.js'

const { slug } = Astro.params
if (!slug) return Astro.redirect('/partidos-del-dia/')

const supabase = createSupabaseAdminClient()

// Buscar el partido más reciente/relevante para este slug
const { data: matches } = await supabase
  .from('df_partidos')
  .select('*')
  .eq('slug', slug)
  .order('fecha_utc', { ascending: false })
  .limit(3)

// Preferir el partido en vivo, luego el más próximo a hoy
const now = new Date()
let match = (matches ?? []).find(m => m.status === 'en_vivo')
  ?? (matches ?? []).reduce((best: any, m: any) => {
    if (!best) return m
    const diffBest = Math.abs(new Date(best.fecha_utc).getTime() - now.getTime())
    const diffM    = Math.abs(new Date(m.fecha_utc).getTime()    - now.getTime())
    return diffM < diffBest ? m : best
  }, null)

if (!match) return Astro.redirect('/partidos-del-dia/')

const flag1 = getFlagUrl(match.equipo_local, 160)
const flag2 = getFlagUrl(match.equipo_visitante, 160)

const fecha = new Date(match.fecha_utc).toLocaleDateString('es-MX', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  hour: '2-digit',
  minute: '2-digit',
  timeZone: 'UTC',
})

const gamecastUrl = `https://enfoquenoticias.com.mx/df/html/v3/minapp/modules/futbol/gamecast/gamecast.html?channel=deportes.futbol.mundial.${match.match_id}&lang=es_LA&hideTournamentsMenu=true&hidePagesMenu=true`

const pageTitle = `${match.equipo_local} vs ${match.equipo_visitante} · La Fiesta del Fútbol`
const pageDesc  = `Minuto a minuto de ${match.equipo_local} vs ${match.equipo_visitante}${match.sede ? ` en ${match.sede}` : ''}.`
---

<Layout title={pageTitle} description={pageDesc}>
  <section class="w-full py-4 poppins">
    <div class="container my-12 mx-auto px-4 md:px-12">
      <LeaderBoard />

      <!-- Cabecera del partido -->
      <div class="match-header bg-black text-white rounded-2xl p-6 mb-8">
        <p class="text-xs uppercase tracking-widest text-neutral-400 text-center mb-4">{fecha}</p>

        <div class="flex items-center justify-center gap-4 w-full">
          <!-- Equipo local -->
          <div class="flex flex-col items-center gap-2 w-5/12 text-center">
            {flag1
              ? <img src={flag1} alt={match.equipo_local} class="w-20 h-auto rounded shadow-lg" />
              : <span class="text-5xl">🏳️</span>
            }
            <span class="font-bold text-lg leading-tight">{match.equipo_local}</span>
          </div>

          <!-- Marcador / VS -->
          <div class="flex flex-col items-center gap-2 flex-shrink-0" id="live-score-block">
            {match.status !== 'programado'
              ? (
                <>
                  <span class="goodtime font-bold text-3xl md:text-4xl text-white" id="live-score">
                    {match.score_local} - {match.score_visitante}
                  </span>
                  {match.status === 'en_vivo' && (
                    <span class="live-badge">EN VIVO</span>
                  )}
                  {match.status === 'finalizado' && (
                    <span class="final-badge">Final</span>
                  )}
                </>
              )
              : <span class="goodtime font-bold text-2xl text-white">VS</span>
            }
          </div>

          <!-- Equipo visitante -->
          <div class="flex flex-col items-center gap-2 w-5/12 text-center">
            {flag2
              ? <img src={flag2} alt={match.equipo_visitante} class="w-20 h-auto rounded shadow-lg" />
              : <span class="text-5xl">🏳️</span>
            }
            <span class="font-bold text-lg leading-tight">{match.equipo_visitante}</span>
          </div>
        </div>

        {match.sede && (
          <p class="text-xs text-neutral-400 uppercase tracking-widest text-center mt-4">{match.sede}</p>
        )}
        {match.grupo && (
          <p class="text-xs text-neutral-500 text-center mt-1">{match.grupo}</p>
        )}
      </div>

      <!-- Layout con iframe y aside -->
      <div class="flex flex-col lg:flex-row gap-8">
        <div class="flex-1 min-w-0">
          <!-- Iframe minuto a minuto -->
          <div class="gamecast-wrapper rounded-xl overflow-hidden bg-black">
            <iframe
              id="gamecast-frame"
              src={gamecastUrl}
              title={`Minuto a minuto: ${match.equipo_local} vs ${match.equipo_visitante}`}
              class="gamecast-iframe"
              frameborder="0"
              scrolling="no"
              allowfullscreen
            />
          </div>
        </div>

        <aside class="w-full lg:w-[350px] flex-shrink-0">
          <div class="bg-white p-5 rounded-xl sticky top-4">
            <BoxBanner />
            <div class="my-6 h-px bg-gray-200"></div>
            <MoreNews />
            <DoubleBox />
          </div>
        </aside>
      </div>

    </div>
  </section>
</Layout>

<!-- Actualizar score en vivo cada 30s -->
<script define:vars={{ matchId: match.match_id }}>
async function pollScore() {
  try {
    const res = await fetch('/api/partidos')
    if (!res.ok) return
    const data = await res.json()
    const m = data.find((x) => x.match_id === matchId)
    if (!m) return

    const scoreEl = document.getElementById('live-score')
    if (scoreEl && m.status !== 'programado') {
      scoreEl.textContent = `${m.score_local} - ${m.score_visitante}`
    }
  } catch { /* silent */ }
}

setInterval(pollScore, 30_000)
</script>

<script>
// Si el iframe de DataFactory emite su altura real vía postMessage, la aplicamos
window.addEventListener('message', (e) => {
  const frame = document.getElementById('gamecast-frame') as HTMLIFrameElement | null
  if (!frame) return
  // DataFactory envía { type: 'resize', height: N } o simplemente un número
  const data = e.data
  let h = 0
  if (typeof data === 'number') h = data
  else if (data && typeof data === 'object') h = data.height ?? data.h ?? 0
  if (h > 400) frame.style.height = h + 'px'
})
</script>

<style>
.match-header {
  background: linear-gradient(135deg, #0a0a0a 0%, #111 100%);
  border: 1px solid rgba(255,255,255,0.07);
}

.live-badge {
  font-size: 0.65rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  color: #ea262a;
  text-transform: uppercase;
  display: flex;
  align-items: center;
  gap: 0.3rem;
  animation: pulse-live 2s infinite;
}
.live-badge::before {
  content: '';
  display: inline-block;
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: #ea262a;
}
@keyframes pulse-live {
  0%, 100% { opacity: 1; }
  50%       { opacity: 0.5; }
}

.final-badge {
  font-size: 0.65rem;
  font-weight: 700;
  color: rgba(255,255,255,0.4);
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.gamecast-wrapper {
  position: relative;
  width: 100%;
}
.gamecast-iframe {
  width: 100%;
  height: 1600px;
  border: none;
  display: block;
}

@media (max-width: 640px) {
  .gamecast-iframe { height: 1400px; }
}
</style>
